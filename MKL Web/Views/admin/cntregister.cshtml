@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string pagename = ViewBag.Title;
    List<Cntroller> ctnlist = ViewBag.cntlist;
}

<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h1>@pagename</h1>
        @Html.ActionLink("Back to Admin", "admin", "admin")|@Html.ActionLink("Link Action Registration", "cntaction", "admin")
    </section>

    <!-- left column -->
    <div class="col-md-6">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_admin_controller" class="table table-bordered table-hover dataTable no-footer" role="grid">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 50%">Code</th>
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 50%">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var x in ctnlist)
                            {
                                <tr role="row" class="odd">
                                    <td>
                                        <input type="text" class="form-control" placeholder="Menu Code" value="@x.ConCode">
                                    </td>
                                    <td>
                                        <select class="form-control" name="status">
                                            @if (x.DocStatus == "Active")
                                            {
                                                <option value="Active" selected>Active</option>
                                                <option value="Inactive">Inactive</option>
                                            }
                                            else
                                            {
                                                <option value="Active">Active</option>
                                                <option value="Inactive" selected>Inactive</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>
                    <tfoot>
                        <tr>
                            <td>
                                <div class="col-md-12 clszeropadding-left">
                                    <div class="col-md-8 clszeropadding-left">
                                        <button type="button" class="btn btn-block btn-info btn-flat" id="cmd_pa_submit" onclick="add_new_controller()">Add Controller</button>
                                    </div>
                                    <div class="col-md-4 clszeropadding-left no-padding">
                                        <button type="button" class="btn btn-block btn-primary btn-flat" id="cmd_pa_submit" onclick="cmd_save_admin('controller')">Submit</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

