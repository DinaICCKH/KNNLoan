
@{
    //ViewBag.Title = "Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h1>@ViewBag.Title</h1>
    </section>
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <div class="col-sm-4">
                    <strong>Manage User Acccount</strong><br>
                    @Html.ActionLink("User", "acct", "admin", new { id = @ViewBag.id }, null)<br />
                    @Html.ActionLink("User Role and Permission", "acctpermission", "admin", new { id = @ViewBag.id }, null)<br />
                    <a href="https://x.loandisk.com/admin/view_custom_fields.php">Approval Flow</a><br>
                </div>
                <div class="col-sm-4">
                    <strong>Setting</strong><br>
                    @Html.ActionLink("Link Registration", "cntregister", "admin", new { id = @ViewBag.id }, null)<br>
                    @Html.ActionLink("Link Action Registration", "cntaction", "admin", new { id = @ViewBag.id }, null)<br>
                    @Html.ActionLink("Main Menu", "mainmenu", "admin", new { id = @ViewBag.id }, null)<br>
                    @Html.ActionLink("Sub Menu", "submenu", "admin", new { id = @ViewBag.id }, null)<br>
                </div>
                <div class="col-sm-4">
                    <strong>Approval</strong><br>
                    @Html.ActionLink("Approval Stages", "appstages", "admin", new { id = @ViewBag.id }, null)<br>
                    @Html.ActionLink("Approval Template", "apptemplate", "admin", new { id = @ViewBag.id }, null)
                </div>
            </div>
        </div>
    </div>
</div>

