@using MKL_Web.Models;
@{
    ViewBag.Title = "Change House Price";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> block = ViewBag.block;
    List<v_SubItemGroup> subitemgroup = ViewBag.subitemgroup;
    List<v_HouseOther> houseother = ViewBag.houseother;
}
<head>
    <script src="../../Scripts/js/Amendment.js"></script>
</head>
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td>
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Search House Info</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:7%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Project</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_project">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in project)
                                                                    {
                                                                        <option value="@x.PrcName">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:7%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Block</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:12%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_block">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in block)
                                                                    {
                                                                        <option value="@x.PrcCode">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:7%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">House​ No</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_sales_holdunit_house_no" placeholder="House No">
                                                        </div>
                                                    </td>
                                                    <td style="width:9%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Sub Item</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_sub_item_group">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in subitemgroup)
                                                                    {
                                                                        <option value="@x.Code">@x.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:9%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Other</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_house_other">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in houseother)
                                                                    {
                                                                        <option value="@x.Code">@x.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <button type="button" class="btn btn-info btn-flat" onclick="get_sales_change_price()">Search</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                        <table class="table" style="margin-bottom:0px;" id="table_sales_change_price">
                                            <thead>
                                                <tr class="bg-gray" role="row">
                                                    <td style="width:1%;">#</td>
                                                    <td style="width:1%;"></td>
                                                    <td style="width:1%;"></td>
                                                    <td style="width:8%">House No</td>
                                                    <td style="width:15%">Description</td>
                                                    <td style="width:10%">Old Price</td>
                                                    <td style="width:10%">New Price</td>
                                                    <td style="width:10%">Last Update</td>
                                                    <td style="width:10%">Effective Date</td>
                                                    <td style="width:10%">Other</td>
                                                    <td style="width:8%">Project</td>
                                                    <td style="width:8%">Block</td>
                                                    <td style="width:10%">Street</td>
                                                    <td style="width:10%">House No</td>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button type="button" class="btn btn-danger btn-flat" onclick="cmd_remove_all_checked_rows()">Remove Row</button>
                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_change_price()">Submit</button>
                <button type="button" class="btn btn-warning btn-flat">Cancel</button>
            </div>
        </div>
    </div>
</div>

