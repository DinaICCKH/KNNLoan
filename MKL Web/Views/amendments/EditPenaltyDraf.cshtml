@using MKL_Web.Models;
@{
    ViewBag.Title = "Penalty";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<ICC_Get_List_Approval_PenaltyDraf_By_IDResult> HeaderChange = ViewBag.Header;
    List<ICC_Approval_Check_EnableButtonResult> Checkbutton = ViewBag.Checkbutton;

    string docdate = DateTime.Now.ToString("dd-MMM-yyyy"); // Capital 'MMM' for month name

}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script>

        function calculateTotals() {
            let totalOverDay = 0;
            let totalPenalty = 0;
            let totalWaive = 0;
            let totalInv = 0;

            $("#table_penalty_list tbody tr").each(function () {
                totalOverDay += parseFloat($(this).find(".overday").text()) || 0;
                totalPenalty += parseFloat($(this).find(".penalty").text().replace(/,/g, '')) || 0;
                totalWaive += parseFloat($(this).find(".waive").text().replace(/,/g, '')) || 0;
                totalInv += parseFloat($(this).find(".inv").text().replace(/,/g, '')) || 0;
            });

            $("#total_overday").text(totalOverDay);
            $("#total_penalty").text(totalPenalty.toLocaleString(undefined, { minimumFractionDigits: 2 }));
            $("#total_waive").text(totalWaive.toLocaleString(undefined, { minimumFractionDigits: 2 }));
            $("#total_inv").text(totalInv.toLocaleString(undefined, { minimumFractionDigits: 2 }));
        }

        $(document).ready(function () {

            var checkbutton = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Checkbutton.FirstOrDefault()));
            var checkbuttonstatus = checkbutton?.Approver ?? "N";
            console.log("checkbuttonstatus:", checkbuttonstatus);

            if (checkbuttonstatus.toUpperCase() === 'Y') {
                console.log("Showing buttons");
                $('#btnReject').show();
                $('#btnApprove').show();
            } else {
                console.log("Hiding buttons");
                $('#btnReject').hide();
                $('#btnApprove').hide();
            }
            calculateTotals();
        });
    </script>
</head>

<div class="row">
    @{
        var header = HeaderChange?.FirstOrDefault();
        var DocEntry = header?.DocEntry ?? -1;
        var WaiveName = header?.WaiveName ?? "";
        var DocNumRef = header?.DocNumRef ?? "";
        var LastApprover = header?.LastApprover ?? "";


        var ItemCode = header?.ItemCode ?? "";

        var SerialNo = header?.SerialNo ?? "";

        var PenaltyDate = header?.PenaltyDate?.ToString("dd-MM-yyyy") ?? "";
        var CreateDate = header?.RequestDate?.ToString("dd-MM-yyyy") ?? "";
        var CreateBy = header?.RequestBy ?? "";
        var AppTemplate = header?.TemplateDesc ?? "";
        var Remark = header?.Remark ?? "";
        var AppStatus = header?.Status ?? "";

    }

    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">
                    @ViewBag.Title
                    <span class="app-status-highlight">@AppStatus</span>
                </h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <!-- General Parameter (75% width) -->
                            <td colspan="3" style="width: 100%;">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border" style="width: 80%; font-weight:bold;">General Parameter</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>


                                                <tr>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Panalty Date</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="input-group date">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-calendar"></i>
                                                            </div>
                                                            <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" disabled id="txt_penalty_date" placeholder="End Payment" value="@PenaltyDate">
                                                        </div>
                                                    </td>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Serial number</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_serial" readonly="readonly" placeholder="Remark" value="@SerialNo">
                                                        </div>
                                                    </td>

                                                </tr>


                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Waive Ref</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_doc_num" placeholder="Waive Ref" value="@DocNumRef">
                                                        </div>
                                                    </td>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Waive Option</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_waiveref" readonly="readonly" placeholder="Waive Ref" value="@WaiveName">
                                                        </div>
                                                    </td>
                                                </tr>

                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border" style="color:red">Approval Decision</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Requester</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" value="@CreateBy" id="txt_requester_name" placeholder="Requester">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Approval Template</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" value="@AppTemplate" id="txt_app_template" placeholder="Approval Template">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width: 10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Last Approver</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_last_approver" value="@LastApprover">
                                                        </div>
                                                    </td>
                                                    <td style="width: 10%; ">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Request Date</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <table style="width:100%;" id="table_doc_discount">
                                                                <tr>
                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text" class="form-control pull-right datetime form-control-insde" disabled readonly="readonly" id="txt_start_payment" placeholder="Request Date" value="@CreateDate">
                                                                        </div>
                                                                    </td>

                                                                    <td style="width:10%;">
                                                                        <div class="form-group">
                                                                            <label for="inputEmail3" class="form-control controlLabel">Draf ID</label>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:40%;">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" value="@DocEntry" readonly="readonly" id="txt_draf_ID">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Requester Comment</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                  
                                                            <textarea class="form-control form-control-insde" id="txt_draf_ID" readonly rows="3">@Remark</textarea>

                                                        </div>
                                                    </td>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Approver Comment</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <textarea class="form-control form-control-insde" id="txt_approverComment" placeholder="Approver Comment" rows="3" style="resize: vertical;"></textarea>
                                                        </div>
                                                    </td>

                                                </tr>

                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border" style="font-weight: bold;">
                                        <span style="cursor: pointer;" onclick="togglePenaltyTable()">
                                            Invoice List
                                            <i id="toggle_penalty_icon" class="fa fa-chevron-up" style="margin-left: 5px;"></i>
                                        </span>
                                    </legend>

                                    <div id="penalty_table_wrapper" class="row"
                                         style="margin:0px;margin-top:10px; position: relative; min-height: 40vh; height: 100%; overflow: auto">

                                        <table class="table"
                                               style="margin-bottom: 0px; position: absolute; min-width: 2500px; width: 100%;"
                                               id="table_penalty_list">

                                            <thead style="position:sticky; top: 0; z-index: 1000;">
                                                <tr class="bg-gray">
                                                    <td>#</td>
                                                    <td>Cus.Code</td>
                                                    <td>Cus.Name</td>
                                                    <td>LoanIDRow</td>
                                                    <td>LoanID</td>
                                                    <td>Principle</td>
                                                    <td>Interest</td>
                                                    <td>CHQ Amt</td>
                                                    <td>From Accrual Date</td>
                                                    <td>To Accrual Date</td>
                                                    <td>Over Day</td>
                                                    <td>Penalty%</td>
                                                    <td>Penalty$</td>
                                                    <td>Waive Name</td>
                                                    <td>Waive%</td>
                                                    <td>Waive$</td>
                                                    <td>Inv Amt</td>
                                                    <td>Remark</td>

                                                    <td style="display:none">IDs</td>
                                                    <td style="display:none">ItemCode</td>
                                                    <td style="display:none">Serial</td>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @{
                                                    int index = 1;
                                                    foreach (var item in HeaderChange)
                                                    {
                                                        <tr>
                                                            <td>@index</td>

                                                            <td>@item.BPCode</td>
                                                            <td>@item.BPName</td>

                                                            <td style="color:blue;" title="@item.AccraulID">
                                                                @(item.AccraulID != null && item.AccraulID.Length > 10
                                                                ? item.AccraulID.Substring(0, 10) + "..."
                                                                : item.AccraulID)
                                                            </td>

                                                            <td style="color:blue; text-decoration:underline;">
                                                                <a href="/sales/PreviewLoan?DocEntry=@item.InstallmentID">
                                                                    @item.InstallmentID
                                                                </a>
                                                            </td>

                                                            <td>@String.Format("{0:N2}", item.PrincipleAmt)</td>
                                                            <td>@String.Format("{0:N2}", item.InterestAmt)</td>
                                                            <td>@String.Format("{0:N2}", item.CHQAmt)</td>

                                                            <td>@Convert.ToDateTime(item.FromAccDate).ToString("dd-MMM-yyyy")</td>
                                                            <td>@Convert.ToDateTime(item.ToAccDate).ToString("dd-MMM-yyyy")</td>

                                                            <td class="overday">@(item.OverDay ?? 0)</td>

                                                            <td>@String.Format("{0:N2}", item.PenaltyPercent)</td>
                                                            <td class="penalty">@String.Format("{0:N2}", item.PenaltyAmt)</td>
                                                            <td>@item.WaiveName</td>
                                                            <td>@String.Format("{0:N2}", item.ApplyPercent)</td>
                                                            <td class="waive">@String.Format("{0:N2}", item.WaiveAmt)</td>
                                                            <td class="inv">@String.Format("{0:N2}", item.NetAmt)</td>
                                                            <td>@item.RowRemark</td>

                                                            <!-- Hidden -->
                                                            <td style="display:none">@item.AccraulID</td>
                                                            <td style="display:none">@item.ItemCode</td>
                                                            <td style="display:none">@item.SerialNo</td>
                                                        </tr>

                                                        index++;
                                                    }
                                                }
                                            </tbody>

                                            <!-- ✅ FOOTER TOTAL -->
                                            <tfoot>
                                                <tr style="font-weight:bold; background:#f5f5f5;">
                                                    <td colspan="10" style="text-align:right;">Total:</td>

                                                    <td id="total_overday">0</td>
                                                    <td></td>
                                                    <td id="total_penalty">0.00</td>
                                                    <td></td>
                                                    <td></td>
                                                    <td id="total_waive">0.00</td>
                                                    <td id="total_inv">0.00</td>
                                                    <td></td>

                                                    <td style="display:none"></td>
                                                    <td style="display:none"></td>
                                                    <td style="display:none"></td>
                                                </tr>
                                            </tfoot>

                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button id="btnReject" type="button" class="btn btn-primary btn-flat"
                        style="background-color:red; border-color:red;"
                        onclick="cmd_save_approval_penaltyDraf('Reject')">
                    Reject
                </button>

                <button id="btnApprove" type="button" class="btn btn-primary btn-flat"
                        onclick="cmd_save_approval_penaltyDraf('Approve')">
                    Approve
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });
    });
    function toggleCustomerTable() {
        var wrapper = document.getElementById("customer_table_wrapper");
        var icon = document.getElementById("toggle_icon");

        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

    document.getElementById("btn_generate_customerlist").addEventListener("click", function () {
        var wrapper = document.getElementById("customer_table_wrapper");
        var icon = document.getElementById("toggle_icon");

        // Force show it again if hidden
        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        }
    });


    function togglePenaltyTable() {
        var wrapper = document.getElementById("penalty_table_wrapper");
        var icon = document.getElementById("toggle_penalty_icon");

        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

</script>

