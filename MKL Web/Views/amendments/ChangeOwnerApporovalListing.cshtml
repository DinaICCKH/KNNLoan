@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Change Owner Approval Status Report";
    List<ICC_Get_List_Approval_ChangeOwnerResult> applist = ViewBag.ChangeOwnerApporovalListing;
}

<head>
    <title>@ViewBag.Title</title>
</head>

@using (Html.BeginForm("ChangeOwnerApporovalListing", "amendments", FormMethod.Get))
{
    <section class="content-header content-header-title">
        <h5 style="padding-top:10px">@ViewBag.Title</h5>
    </section>

    <div class="form-inline d-flex align-items-center flex-wrap" style="gap:10px;padding-bottom:10px">

        <!-- Status -->
        <div class="form-group mb-2">
            <label class="mr-1">Status</label>
            @Html.DropDownList("Status",
                new List<SelectListItem>
                {
                    new SelectListItem { Text = "All", Value = "All" },
                    new SelectListItem { Text = "Draft", Value = "Draf" },
                    new SelectListItem { Text = "Closed", Value = "Closed" },
                    new SelectListItem { Text = "Reject", Value = "Reject" },
                    new SelectListItem { Text = "Approve", Value = "Approve" }
                },
                new { @class = "form-control form-control-sm", style = "width:120px" })
        </div>

        <!-- From Date -->
        <div class="form-group mb-2">
            <label class="mr-1">From Date</label>
            <input type="text" name="fdate" id="fdate"
                   class="form-control form-control-sm datetime"
                   readonly placeholder="From Date" style="width:130px" />
        </div>

        <!-- To Date -->
        <div class="form-group mb-2">
            <label class="mr-1">To Date</label>
            <input type="text" name="tdate" id="tdate"
                   class="form-control form-control-sm datetime"
                   readonly placeholder="To Date" style="width:130px" />
        </div>

        <!-- Item -->
        <div class="form-group mb-2">
            <label class="mr-1">Item</label>
            @Html.TextBox("Item", Request["Item"],
                new { @class = "form-control form-control-sm", style = "width:150px" })
        </div>

        <!-- Serial -->
        <div class="form-group mb-2">
            <label class="mr-1">Serial</label>
            @Html.TextBox("Serial", Request["Serial"],
                new { @class = "form-control form-control-sm", style = "width:120px" })
        </div>

        <!-- Customer -->
        <div class="form-group mb-2">
            <label class="mr-1">Customer</label>
            @Html.TextBox("Customer", Request["Customer"],
                new { @class = "form-control form-control-sm", style = "width:160px" })
        </div>

        <div class="form-group mb-2 ml-2">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment"
                       class="table table-bordered table-hover display nowrap"
                       style="width:100%">
                    <thead>
                        <tr class="bg-gray">
                            <th>Draft ID</th>
                            <th>In.Entry</th>
                            <th>Doc Date</th>
                            <th>Old Customer</th>
                            <th>New Customer</th>
                            <th>Item Name</th>
                            <th>Serial No</th>
                            <th>App. Template</th>
                            <th>Requester</th>
                            <th>Next Approver</th>
                            <th>Status</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (applist != null && applist.Any())
                        {
                            foreach (var x in applist)
                            {
                                <tr>
                                    <td class="text-center">@x.DrafID</td>
                                    <td style="color:blue;text-decoration:underline;">
                                        <a href="/amendments/EditChangeOwner?DocEntry=@x.DrafID">
                                            @x.BaseEntry
                                        </a>
                                    </td>
  
                                    <td>@(x.DocDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.OldCustomerName</td>
                                    <td>@x.NewCustomerName</td>
                                    <td>@x.ItemName</td>
                                    <td>@x.DistNumber</td>
                                    <td>@x.AppTemplate</td>
                                    <td>@x.CreateBy</td>
                                    <td>@x.NextApprover</td>
                                    <td class="text-center">@x.Status</td>
                                    <td>@x.Remark</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({
            scrollX: true,
            pageLength: 50,
            searching: true,
            ordering: true,
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'print']
        });
    });
</script>
