@using MKL_Web.Models;
@{
    ViewBag.Title = "Restructure";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_OCRD> cust = ViewBag.cust;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
    List<InstallmentList> installment = ViewBag.installment;
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script src="~/Scripts/js/Dina_CustomizationFormSettingandCopytoClibord.js"></script>
    <script>
     
        $(document).ready(function () {
            $('.datetime').datepicker({
                autoclose: true,
                format: 'dd-M-yyyy'
            });
            toggleChangePeriodRow();

            $('#cbo_option').change(function () {
                toggleChangePeriodRow();
            });

            function toggleChangePeriodRow() {
                var selectedValue = $('#cbo_option').val();
                if (selectedValue === 'RP') {
                    $('.change-period').show();
                    $('.change-amount').hide();
                    $('#removebtn').show();
                    $('#btn_generate_payment_shcedule').show();
                    $('#txt_remaining_amount').val(0.00);
                    $('#txt_installment_amount').val(0.00);
                    $('#txt_before_discount_amount').val(0.00);
                    $('#txt_item_code').val("");
                    $('#txt_serial_no').val("");
                    $('#txt_item_name').val("");
                    $('#txt_doc_num').val("");

                    $('#table_payment_schedule_restructureAmt tbody').empty();

                    $('#txt_fixed_monthly_payment').show();
                    $('#check_manual_payment').show();
                    $('#Label_Monthly_Payment').show();

                    $("#txt_period").prop("disabled", false);
                    $("#txt_installment_rate").prop("disabled", false);

                    functionType = 1;



                } else {
                    $('.change-period').hide();
                    $('.change-amount').show();
                    $('#removebtn').hide();
                    $('#btn_generate_payment_shcedule').hide();
                    $('#txt_remaining_amount').val(0.00);
                    $('#txt_installment_amount').val(0.00);
                    $('#txt_before_discount_amount').val(0.00);
                    $('#txt_item_code').val("");
                    $('#txt_serial_no').val("");
                    $('#txt_item_name').val("");
                    $('#txt_doc_num').val("");
                    $('#table_payment_schedule tbody').empty();
                    $('#txt_fixed_monthly_payment').hide();
                    $('#check_manual_payment').hide();
                    $('#Label_Monthly_Payment').hide();
                    $("#txt_period").prop("disabled", false);
                    $("#txt_installment_rate").prop("disabled", false);
                    functionType = 2;
                }
            }
            // Load column settings UI
            buildColumnSettingsCheckboxes();

            $("#txt_pop_filter_vendor_name").keyup(function () {
                $("#table_pop_customer_list >tbody >tr").each(function () {
                    var id = $(this).attr('id').replace("tr_pop_customer_", "");

                    var text = $("#td_pop_vendor_cust_code_" + id).text().toLowerCase() + $("#td_pop_vendor_cust_name_" + id).text().toLowerCase() + $("#td_pop_vendor_phone_" + id).text().toLowerCase();
                    if (text.replace(/\s+/g, '').indexOf($("#txt_pop_filter_vendor_name").val().replace(/\s+/g, '').toLowerCase()) == -1)
                        $(this).hide();
                    else
                        $(this).show();
                });
            });
        });
    </script>
</head>
<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_customer_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_fname_@rowindex">@x.CardFName</td>
                                        <td id="td_pop_vendor_cust_gender_@rowindex">@x.U_Gender</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Phone1</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_customer()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
