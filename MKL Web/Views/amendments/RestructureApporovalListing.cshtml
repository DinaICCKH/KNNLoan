@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Restructure Apporoval Listing";
    List<V_ARMemo> po = ViewBag.armemoList;
    List<ICC_Get_List_Approval_RestructureResult> applist = ViewBag.ApprovalRestructureListing;
}
<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>
</head>


@using (Html.BeginForm("RestructureApporovalListing", "amendments", FormMethod.Get))
{
    <section class="content-header content-header-title">
        <h5 style="padding-top:10px !important; padding-left:0px !important;">@ViewBag.Title</h5>
    </section>

    <div class="form-inline d-flex align-items-center flex-wrap" style="gap: 10px; padding-bottom:10px !important">
        <div class="form-group mb-2">
            <label for="Status" class="mr-1">Status</label>
            @Html.DropDownList("Status", new List<SelectListItem>
            {
                new SelectListItem { Text = "Draf", Value = "Draf" },
                new SelectListItem { Text = "Closed", Value = "Closed" },
                new SelectListItem { Text = "Reject", Value = "Reject" },
                new SelectListItem { Text = "Approve", Value = "Approve" }
            }, "All", new { @class = "form-control form-control-sm", style = "width: 120px;" })
        </div>

        <div class="form-group mb-2">
            <label for="tdate" class="mr-2">From Date</label>
            <div class="form-group">
                <div class="input-group date">
                    <div class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </div>
                    <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="fdate" placeholder="From Date">
                </div>
            </div>
        </div>

        <div class="form-group mb-2">
            <label for="tdate" class="mr-2">To Date</label>

            <div class="form-group">
                <div class="input-group date">
                    <div class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </div>
                    <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="tdate" placeholder="From Date">
                </div>
            </div>
        </div>

        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">CreateBy</label>
            @Html.TextBox("CreateBy", Request["CreateBy"], new { @class = "form-control form-control-sm", style = "width: 140px;" })
        </div>

        <div class="form-group mb-2 ml-2">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
}


<div class="row">



    <div class="col-md-12">
        <div class="box box-primary">
            <div class="table-responsive" style="overflow-x: auto;">
                <table id="table_pr_assignment" class="table table-bordered table-hover display nowrap" style="width:100%">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th>No.</th>
                            <th>DocEntry</th>
                            <th>Posting Date</th>
                            <th>DocNum Ref</th>
                            <th>Restructure Option</th>
                            <th>Approval Template</th>
                            <th>Next Approver</th>
                            <th>Request Date</th>
                            <th>Request By</th>
                            <th>Status</th>
                            <th>Remark</th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            foreach (var x in applist)
                            {
                                <tr id="tr_@rowindex">
                                    <td style="text-align:center;">@rowindex</td>
                                    <td style="color:blue;text-decoration:underline;">
                                        @if (@x.RestructureOption=="Change Period")
                                        {
                                            <a href="/amendments/PreviewRestructure?DocEntry=@x.DocEntry">@x.DocEntry</a>
                                        }
                                        else
                                        {
                                            <a href="/amendments/PreviewRestructureAmt?DocEntry=@x.DocEntry">@x.DocEntry</a>
                                        }
                                    </td>
                                    <td>@(x.PostingDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.DocNumRef </td>
                                    <td>@x.RestructureOption</td>
                                    <td>@x.TemplateDesc </td>
                                    <td>@x.NextApprover</td>
                                    <td>@(x.CreateDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.CreateBy</td>
                                    <td>@x.Status</td>
                                    <td>@x.Remark</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({
            scrollX: true,
            fixedHeader: true,
            paging: true,
            searching: true,
            autoWidth: false,
            pageLength: 50,
            dom: 'Brtip',
            buttons: ['copy', 'excel', 'print'],
            columnDefs: [
                { targets: '_all', className: 'dt-head-center' }
            ],
            language: {
                search: "Search records:",
                lengthMenu: "Display _MENU_ records per page",
                zeroRecords: "No matching records found",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                infoEmpty: "No records available",
                infoFiltered: "(filtered from _MAX_ total records)"
            }
        });
    });

</script>
