@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Accrual Penalty List Report";
    List<V_ARMemo> po = ViewBag.armemoList;
    List<ICC_Get_List_PenaltyDraf_AccraulResult> applist = ViewBag.AccraulPenaltyListing;
}
<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>
</head>


@using (Html.BeginForm("AccraulPenaltyListing", "amendments", FormMethod.Get))
{
    <section class="content-header content-header-title">
        <h5 style="padding-top:10px !important; padding-left:0px !important;">@ViewBag.Title</h5>
    </section>

    <div class="form-inline d-flex align-items-center flex-wrap" style="gap: 10px; padding-bottom:10px !important">
        <div class="form-group mb-2">
            <label for="Status" class="mr-1">Status</label>
            @Html.DropDownList("Status", new List<SelectListItem>
            {
                new SelectListItem { Text = "Draf", Value = "D" },
                new SelectListItem { Text = "Closed", Value = "C" },
                new SelectListItem { Text = "Reject", Value = "R" }
            }, "All", new { @class = "form-control form-control-sm", style = "width: 120px;" })
        </div>

        <div class="form-group mb-2">
            <label for="Status" class="mr-1">Frozen For</label>
            @Html.DropDownList("Frozen", new List<SelectListItem>
            {
                new SelectListItem { Text = "Y", Value = "Yes" },
                new SelectListItem { Text = "N", Value = "No" }
            }, "All", new { @class = "form-control form-control-sm", style = "width: 120px;" })
        </div>

        <div class="form-group mb-2">
            <label for="tdate" class="mr-2">From Date</label>
            <div class="form-group">
                <div class="input-group date">
                    <div class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </div>
                    <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="fdate" placeholder="From Date">
                </div>
            </div>
        </div>

        <div class="form-group mb-2">
            <label for="tdate" class="mr-2">To Date</label>

            <div class="form-group">
                <div class="input-group date">
                    <div class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </div>
                    <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="tdate" placeholder="From Date">
                </div>
            </div>
        </div>
        <div class="form-group mb-2">
            <label for="Item" class="mr-3">Item</label>
            @Html.TextBox("Item", Request["Item"], new { @class = "form-control form-control-sm", style = "width: 120px;" })
        </div>
        <div class="form-group mb-2">
            <label for="Serial" class="mr-2">Serial</label>
            @Html.TextBox("Serial", Request["Serial"], new { @class = "form-control form-control-sm", style = "width: 120px;" })
        </div>
        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">Customer</label>
            @Html.TextBox("Customer", Request["Customer"], new { @class = "form-control form-control-sm", style = "width: 140px;" })
        </div>

        <div class="form-group mb-2 ml-2">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
}


<div class="row">



    <div class="col-md-12">
        <div class="box box-primary">
            <div class="table-responsive" style="overflow-x: auto;">
                <table id="table_pr_assignment" class="table table-bordered table-hover display nowrap" style="width:100%">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th>ID</th>
                            <th>In.Entry</th>
                            <th>Card Code</th>
                            <th>Card Name</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Serial No</th>
                            <th>Doc Comment</th>
                            <th>Due Date</th>
                            <th>Payment Date</th>
                            <th>CHQ Amt</th>
                            <th>Principal Amt</th>
                            <th>Interest Amt</th>
                            <th>Outstanding Amt</th>
                            <th>Penalty %</th>
                            <th>Penalty Amt</th>
                            <th>Over Days</th>
                            <th>Remark</th>
                            <th>Status</th>
                            <th>Approval Template</th>
                            <th>Last Approval</th>
                            <th>Frozen For</th>
                            <th>Frozen Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            foreach (var x in applist)
                            {
                                <tr id="tr_@rowindex">
                                    <td style="text-align:center;">@x.ID</td>
                                    <td style="color:blue;text-decoration:underline;">
                                        <a href="/sales/PreviewLoan?DocEntry=@x.InstallmentID">@x.InstallmentID</a>
                                    </td>
                                    <td>@x.CardCode</td>
                                    <td>@x.CardName</td>
                                    <td>@x.ItemCode</td>
                                    <td>@x.ItemName</td>
                                    <td>@x.SerialNo</td>
                                    <td>@x.Comment</td>
                                    <td>@(x.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@(x.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</td>


                                    <td style="text-align:right;">@(x.CHQAmt.HasValue ? x.CHQAmt.Value.ToString("N2") : "")</td>
                                    <td style="text-align:right;">@(x.PrincipleAmt.HasValue ? x.PrincipleAmt.Value.ToString("N2") : "")</td>
                                    <td style="text-align:right;">@(x.InterestAmt.HasValue ? x.InterestAmt.Value.ToString("N2") : "")</td>
                                    <td style="text-align:right;">@(x.OutStandingAmt.HasValue ? x.OutStandingAmt.Value.ToString("N2") : "")</td>
                                    <td style="text-align:right;">@(x.PenaltyPercent.HasValue ? x.PenaltyPercent.Value.ToString("N2") : "")</td>
                                    <td style="text-align:right;">@(x.PenaltyAmt.HasValue ? x.PenaltyAmt.Value.ToString("N2") : "")</td>

                                    <td style="text-align:center;">@x.OverDay</td>
                                    <td>@x.Remark</td>
                                    <td>@x.Status</td>
                                    <td>@x.ApprovalTemplate</td>
                                    <td>@x.LastApproval</td>
                                    <td>@x.Frozenfor</td>
                                    <td>@x.ProzenforRemark</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({
            scrollX: true,
            fixedHeader: true,
            paging: true,
            searching: true,
            autoWidth: false,
            pageLength: 50,
            dom: 'Brtip',
            buttons: ['copy', 'excel', 'print'],
            columnDefs: [
                { targets: '_all', className: 'dt-head-center' }
            ],
            language: {
                search: "Search records:",
                lengthMenu: "Display _MENU_ records per page",
                zeroRecords: "No matching records found",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                infoEmpty: "No records available",
                infoFiltered: "(filtered from _MAX_ total records)"
            }
        });
    });

</script>
