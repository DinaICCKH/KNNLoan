@using MKL_Web.Models;
@{
    ViewBag.Title = "Edit Old Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<OCRD> cust = ViewBag.cust;
    List<v_Item_House> houselist = ViewBag.houselist;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
    SO s = ViewBag.so;
    SO1 s1 = ViewBag.so1;
    List<v_Contact> contact = ViewBag.contact;
    InstallmentRow inst = ViewBag.inst;
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script>
        $(document).ready(
            function () {
                pageID = "OldScheduleEditChangeItem";
            }
        );
    </script>
</head>


<div class="modal fade" id="modal-schedule-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">AR Memo change Item Listing</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_schedule_list" class="table">
                        <thead>
                            <tr>
                                <th style="width:10%">Ref No</th>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:20%">Customer Name</th>
                                <th style="width:15%">Item Code</th>
                                <th style="width:25%">Item Name</th>
                                <th style="width:15%">Last Option</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_AR_Memo_ChangeItem()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="row">
    <input type="hidden" id="txt_dockey" value="@s.DocEntry" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" />
    <input type="hidden" id="txt_payment_schedule_selected_row" value="-1" />
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_code" readonly="readonly" placeholder="Customer Code" value="@s.CardCode">
                                    <div class="input-group-addon">
                                        <i class="fa fa-user text-info" style="cursor:not-allowed"></i>
                                    </div>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Ref No</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_doc_num" readonly="readonly" placeholder="SO No" value="@s.DocEntry">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_name" placeholder="Customer Name" value="@s.CardName" readonly>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Posting Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_doc_date" placeholder="Posting Date" value="@s.DocDate.Value.ToString("dd-MMM-yyyy")" disabled>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Contact</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <select class="form-control form-control-insde" id="cbo_contact_person" disabled>
                                        <option value=""></option>
                                        @foreach (var a in contact.Where(a => a.CardCode == s.CardCode).ToList())
                                        {
                                            if (a.CntctCode == s.ContactPerson)
                                            {
                                                <option selected value="@a.CntctCode">@a.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@a.CntctCode">@a.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Delivery Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_due_date" placeholder="Delivery Date" value="@s.DueDate.Value.ToString("dd-MMM-yyyy")" disabled>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Item Information</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr style="display:none">
                                                    <td>
                                                        <input type="hidden" id="txt_ocrcode" value="@s.OcrCode" />
                                                        <input type="hidden" id="txt_ocrcode2" value="@s1.OcrCode2" />
                                                        <input type="hidden" id="txt_ocrcode3" value="@s1.OcrCode3" />
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Item Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="input-group">
                                                            <input type='text' style="display:none" class='form-control noborder' id="txt_item_code" readonly="readonly" placeholder='Item Code' value="@s1.ItemCode">
                                                            <input type='text' class='form-control noborder' id="txt_house_code" readonly="readonly" placeholder='Item Code' value="@s1.ItemCode">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-industry text-info" style="cursor:not-allowed"></i>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Description</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_item_name" placeholder="Item Description" value="@s1.ItemName">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">AR Amount</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_after_discount" placeholder="Special Discount Amount" value="@s.PaidAmt.Value.ToString("N2")" readonly="readonly">
                                                        </div>
                                                    </td>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Status</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="ddl_action">
                                                                <option value="ChangingProduct">Changing Product</option>
                                                            </select>
                                                        </div>
                                                    </td>

                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel" style="color:blue">New Item Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="input-group">
                                                            <input type='text' style="display:none" class='form-control noborder' id="txt_item_code" readonly="readonly" placeholder='New Item Code' value="@s1.ItemCode">
                                                            <input type='text' class='form-control noborder' id="txt_new_item_code" readonly="readonly" placeholder="New Item Code">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-industry text-info" style="cursor:not-allowed"></i>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left: 2px; color: blue" class="form-control controlLabel" >New Item Description</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_new_item_name" placeholder="New Item Description">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td>
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel" style="color:blue">AR Memo Ref</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_ar_memo_ref" placeholder="AR Memo Ref" readonly="readonly">
                                                        </div>
                                                    </td>
                                                    @*<td>
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel" style="color:blue">AR Memo Amount</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_after_discount" placeholder="Special Discount Amount" value="@s.PaidAmt.Value.ToString("N2")" readonly="readonly">
                                                        </div>
                                                    </td>*@
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <div class="btn-group">
                    <button type="button" class="btn btn-warning btn-flat">Copy From</button>
                    <button type="button" class="btn btn-warning dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                        <span class="caret"></span>
                        <span class="sr-only">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-btn">
                        <li><button type="button" style="width:90%;" class="btn btn-warning btn-flat" onclick="cmd_copy_from('Booking')">AR Memo</button></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_updateOldSchedule()">Submit</button>
            </div>
        </div>
    </div>
</div>

