                                                            <thead style="position:sticky; top: 0; z-index: 1000;">
                                                                <tr class="bg-gray" role="row">

                                                                    <td style="width:4%; text-align:left;">#</td>
                                                                    <td style="width: 7%; text-align: left;">DocDate</td>
                                                                    <td style="width: 7%; text-align: left;">DueDate</td>
                                                                    <td style="width: 7%; text-align: left;">Principle</td>
                                                                    <td style="width: 6%; text-align: left;">Interest</td>
                                                                    <td style="width: 7%; text-align: left;">MonthlyPay</td>
                                                                    <td style="width: 6%; text-align: left;">Remain</td>
                                                                    <td style="width: 7%; text-align: left;">Remain+Interest</td>
                                                                    <td style="width: 6%; text-align: left;">C.Principle</td>
                                                                    <td style="width: 7%; text-align: left;">C.Interest</td>
                                                                    <td style="width: 7%; text-align: left; ">C.Principle+Interest</td>
                                                                    <td style="width: 5%; text-align: left;">Reason</td>
                                                                    <td style="width: 26%; text-align: left;">Remark</td>
                                                                    <td style="width: 4%; text-align: left;">ARNo</td>
                                                                    <td style="width: 4%; text-align: left;">PayNo</td>
                                                                </tr>
                                                            </thead>
                                                            <tbody style="vertical-align: middle;">
                                                                @{
                                                                    int index2 = 1;
                                                                    foreach (var item in installment)
                                                                    {
                                                                        if (item.RowType == "Installment")
                                                                        {
                                                                            <tr>
                                                                                <td>@index2</td>
                                                                                <td>@Convert.ToDateTime(item.PaymentDate).ToString("dd-MMM-yyyy")</td>
                                                                                <td>@Convert.ToDateTime(item.DueDate).ToString("dd-MMM-yyyy")</td>
                                                                                <td class="principle">@String.Format("{0:N2}", item.Principle)</td>
                                                                                <td class="interest">@String.Format("{0:N2}", item.Interest)</td>
                                                                                <td class="monthly">@String.Format("{0:N2}", item.Monthly)</td>
                                                                                <td>@String.Format("{0:N2}", item.Remaining)</td>
                                                                                <td>@String.Format("{0:N2}", item.Remaining + item.Interest)</td>
                                                                                <td>@String.Format("{0:N2}", item.CuPayment)</td>
                                                                                <td>@String.Format("{0:N2}", item.CuInterest)</td>
                                                                                <td>@String.Format("{0:N2}", item.CuPayment + item.CuInterest)</td>
                                                                                <td>@item.Method</td>
                                                                                <td>@item.Remarks</td>
                                                                                <td>@item.ARNo</td>
                                                                                <td>@item.PaymentNo</td>
                                                                            </tr>
                                                                            index2++;
                                                                        }
                                                                    }

                                                                }
                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:left;"><b>Total</b></td>
                                                                    <td class="bg-gray" style="text-align:left;" id="txt_total_principle">0.00</td>
                                                                    <td class="bg-gray" style="text-align:left;" id="txt_total_interest">0.00</td>
                                                                    <td class="bg-gray" style="text-align:left;" id="txt_total_monthly">0.00</td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        <!-- /.tab-content -->
                                    </div>
                                </fieldset>

                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button id="btnReject" type="button" class="btn btn-primary btn-flat"
                        style="background-color:red; border-color:red;"
                        onclick="cmd_save_approval_Reprocessing('Reject')">
                    Reject
                </button>

                <button id="btnApprove" type="button" class="btn btn-primary btn-flat"
                        onclick="cmd_save_approval_Reprocessing('Approve')">
                    Approve
                </button>
            </div>
        </div>
    </div>
</div>


<div id="custom-alert" style="
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #28a745;
    color: white;
    padding: 15px 25px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    font-size: 16px;
    z-index: 9999;
    text-align: center;
    max-width: 80%;
    ">

</div>

<div id="alert-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>



<script>
    $(document).ready(function () {

         var checkbutton = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Checkbutton.FirstOrDefault()));
             var checkbuttonstatus = checkbutton?.Approver ?? "N";
             console.log("checkbuttonstatus:", checkbuttonstatus);

             if (checkbuttonstatus.toUpperCase() === 'Y') {
                 console.log("Showing buttons");
                 $('#btnReject').show();
                 $('#btnApprove').show();
             } else {
                 console.log("Hiding buttons");
                 $('#btnReject').hide();
                 $('#btnApprove').hide();
        }

        function sumColumnInTable(tableId, className) {
            let total = 0;
            $("#" + tableId + " ." + className).each(function () {
                let val = parseFloat($(this).text().replace(/,/g, ''));
                if (!isNaN(val)) total += val;
            });
            return total.toFixed(2);
        }


        // For #table_payment_schedule
        $('#txt_total_principle').text(sumColumnInTable("table_payment_schedule", "principle"));
        $('#txt_total_interest').text(sumColumnInTable("table_payment_schedule", "interest"));
        $('#txt_total_monthly').text(sumColumnInTable("table_payment_schedule", "monthly"));

        // For #table_payment_schedule_AR, if you have separate totals
        $('#txt_total_principleAR').text(sumColumnInTable("table_payment_schedule_AR", "principle"));
        $('#txt_total_interestAR').text(sumColumnInTable("table_payment_schedule_AR", "interest"));
        $('#txt_total_monthlyAR').text(sumColumnInTable("table_payment_schedule_AR", "monthly"));


        // Load column settings UI
        buildColumnSettingsCheckboxes();
    });

    function toggle() {
        var wrapper = document.getElementById("table_wrapper");
        var icon = document.getElementById("toggle_icon");

        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

</script>