<script>
    $(document).ready(function () {
        function sumColumn(className) {
            let total = 0;
            $("." + className).each(function () {
                let val = parseFloat($(this).text().replace(/,/g, ''));
                if (!isNaN(val)) total += val;
            });
            return total.toFixed(2);
        }

        $('#txt_total_principle').text(sumColumn("principle"));
        $('#txt_total_interest').text(sumColumn("interest"));
        $('#txt_total_monthly').text(sumColumn("monthly"));
    });

    function cmd_ShowHistory() {
        const fdate = "1999/01/01";
        const tdate = "1999/01/01";

        // Get values from inputs
        const item = document.getElementById("txt_house_code")?.value || "";
        const serial = document.getElementById("cbo_payment_option")?.value || "";

        const customer = "";
        const createBy = "";
        const updateBy = "";

        // Build URL
        const url = `/History/Historyinstallment?fdate=${encodeURIComponent(fdate)}&tdate=${encodeURIComponent(tdate)}&Item=${encodeURIComponent(item)}&Serial=${encodeURIComponent(serial)}&Customer=${encodeURIComponent(customer)}&CreateBy=${encodeURIComponent(createBy)}&UpdateBy=${encodeURIComponent(updateBy)}`;

        // Navigate
        window.location.href = url;
    }
</script>




<script>
    // Print Preview with font size 12px, Khmer OS Battambang font, and row numbers
    function cmd_Print() {

        const table = document.getElementById("table_payment_schedule");
        if (!table) return;

        const printWindow = window.open('', '_blank');
        const today = new Date().toLocaleDateString('en-GB');

        const customHeaders = [
            "No.", "Pay Date", "Due Date", "Principle", "Interest", "MonthlyPay",
            "Remain", "Remain+Int", "C.Principle", "C.Interest",
            "C.Prin+Int", "Reason", "Remark", "ARNo", "PayNo"
        ];

        function prepareTableHTML(html) {
            const container = document.createElement('div');
            container.innerHTML = html;

            // Replace first row <td> with <th> and apply custom headers
            const firstRow = container.querySelector('thead tr');
            if (firstRow) {
                const newRow = document.createElement('tr');
                Array.from(firstRow.cells).forEach((cell, idx) => {
                    const th = document.createElement('th');
                    th.innerHTML = customHeaders[idx] || cell.innerHTML;
                    th.style.textAlign = 'center';
                    th.style.fontWeight = 'bold';
                    th.style.backgroundColor = '#e0e0e0';
                    newRow.appendChild(th);
                });
                firstRow.parentNode.replaceChild(newRow, firstRow);
            }

            // Add row numbers in tbody first column (overwrite if needed)
            const tbodyRows = container.querySelectorAll('tbody tr');
            tbodyRows.forEach((row, index) => {
                if (row.cells.length > 0) {
                    const firstCell = row.cells[0];
                    firstCell.textContent = (index + 1).toString();
                    firstCell.style.textAlign = 'center';
                }
            });

            // Align tbody cells: center dates, right numbers, left text
            tbodyRows.forEach(row => {
                Array.from(row.cells).forEach(cell => {
                    const text = cell.textContent.trim();
                    if (/\d{2}-[A-Za-z]{3}-\d{4}/.test(text)) {
                        cell.style.textAlign = 'center';
                    } else if (!isNaN(text.replace(/,/g, '')) && text !== '') {
                        cell.style.textAlign = 'right';
                    } else {
                        cell.style.textAlign = 'left';
                    }
                });
            });

            // Style totals row in tfoot
            const tfootRow = container.querySelector('tfoot tr');
            if (tfootRow) {
                Array.from(tfootRow.cells).forEach((cell, i) => {
                    if (i < 3) {
                        cell.style.textAlign = 'left';
                        if (i === 2) cell.style.fontWeight = 'bold';
                    } else {
                        cell.style.textAlign = 'right';
                    }
                    cell.style.backgroundColor = '#e0e0e0';
                    cell.style.fontWeight = 'bold';
                });
            }

            // Smaller first column (#) and wider Remark column
            const allRows = container.querySelectorAll('tr');
            allRows.forEach(row => {
                const firstCell = row.cells[0];
                if (firstCell) {
                    firstCell.style.width = '2%';
                    firstCell.style.fontSize = '12px';
                    firstCell.style.textAlign = 'center';
                }
                const remarkCell = row.cells[12]; // 13th column (Remark)
                if (remarkCell) {
                    remarkCell.style.width = '26%';
                    remarkCell.style.wordWrap = 'break-word';
                    remarkCell.style.textAlign = 'left';
                }
            });

            // Set font size for entire table
            container.querySelectorAll('table').forEach(tbl => {
                tbl.style.fontSize = '12px';
            });

            return container.innerHTML;
        }

        const formattedTableHTML = prepareTableHTML(table.outerHTML);

        const cardCode = document.getElementById('txt_card_code')?.value || '';
        const cardName = document.getElementById('txt_card_name')?.value || '';
        const houseCode = document.getElementById('txt_house_code')?.value || '';
        const itemName = document.getElementById('txt_item_name')?.value || '';
        const paymentOption = document.getElementById('cbo_payment_option')?.value || '';

        printWindow.document.write(`
        <html>
        <head>
            <title>Schedule Preview</title>
            <style>
                body {
                    font-family: 'Khmer OS Battambang', serif;
                    font-size: 12px;
                    padding: 8px;
                }
                h2, h4 {
                    margin: 0;
                    text-align: center;
                }
                .company-info {
                    text-align: center;
                    margin-bottom: 20px;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    word-wrap: break-word;
                    border: 1px solid black;
                }
                th, td {
                    border: 1px solid black;
                    padding: 4px;
                }
                th:first-child, td:first-child {
                    width: 2%;
                    font-size: 12px;
                    text-align: center;
                }
                th:nth-child(13), td:nth-child(13) {
                    width: 26%;
                    word-wrap: break-word;
                    text-align: left;
                }
                .footer-sign {
                    margin-top: 60px;
                    display: flex;
                    justify-content: space-between;
                    font-size: 12px;
                }
                .footer-sign div {
                    text-align: center;
                    width: 30%;
                }
                .page-footer {
                    margin-top: 20px;
                    text-align: center;
                    font-size: 12px;
                }
                .btn-print {
                    margin: 20px 0;
                    display: block;
                    width: 100px;
                    padding: 6px;
                    background: #007bff;
                    color: white;
                    border: none;
                    border-radius: 4px;
                    cursor: pointer;
                }
                .btn-print:hover {
                    background: #0056b3;
