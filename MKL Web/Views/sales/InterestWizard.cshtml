@using MKL_Web.Models;
@{
    ViewBag.Title = "Interest Wizard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<v_OCRD_Penalty> cust = ViewBag.cust;
    List<v_OCRD_Penalty> custNew = ViewBag.custNew;
    List<InstallmentList> installment = ViewBag.installment;

    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
}

<head>
    <script src="../../Scripts/js/sales.js"></script>

    <script>
        $(document).ready(function () {

            $("#txt_pop_filter_vendor_name").keyup(function () {

                $("#table_pop_customer_list > tbody > tr").each(function () {

                    var id = $(this).attr('id').replace("tr_pop_customer_", "");

                    var text =
                        $("#td_pop_vendor_cust_code_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_cust_name_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_phone_" + id).text().toLowerCase();

                    if (text.replace(/\s+/g, '')
                        .indexOf($("#txt_pop_filter_vendor_name")
                            .val()
                            .replace(/\s+/g, '')
                            .toLowerCase()) == -1)
                        $(this).hide();
                    else
                        $(this).show();
                });
            });
        });
    </script>
</head>

<!-- ========================= MODAL CUSTOMER ========================= -->

<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>

            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px; overflow:auto">

                    <table id="table_pop_customer_list" class="table">

                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text"
                                               class="form-control form-control-insde"
                                               id="txt_pop_filter_vendor_name"
                                               placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>
                            </tr>
                        </thead>

                        <tbody>
                            @*
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex"
                                        onclick="tr_pop_customer_selected(@rowindex)">

                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_fname_@rowindex">@x.CardFName</td>
                                        <td id="td_pop_vendor_cust_gender_@rowindex">@x.U_Gender</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Phone1</td>
                                    </tr>
                                    rowindex++;
                                }
                            *@
                        </tbody>

                    </table>
                </div>
            </div>

            <div class="modal-footer" style="padding:5px;">
                <button type="button"
                        class="btn btn-success btn-flat"
                        onclick="cmd_pop_choose_customer_change_owner()">
                    Choose
                </button>

                <button type="button"
                        class="btn btn-danger btn-flat"
                        data-dismiss="modal">
                    Cancel
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ========================= MAIN SECTION ========================= -->

<div class="row">

    <!-- Hidden Fields -->
    <input type="hidden" id="txt_module_id" value="Penalty" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" value="-1" />
    <input type="hidden" id="txt_payment_schedule_selected_row" value="-1" />
    <input type="hidden" id="txt_so_entry" value="-1" />
    <input type="hidden" id="txt_so_line" value="-1" />
    <input type="hidden" id="txt_ocrcode" value="-1" />
    <input type="hidden" id="txt_ocrcode2" value="-1" />
    <input type="hidden" id="txt_ocrcode3" value="-1" />
    <input type="hidden" id="txt_cardtype" value="-1" />

    <div class="col-md-12">
        <div class="box box-primary">

            <!-- Header -->
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>

            <!-- Filter Section -->
            <div class="box-header with-border">

                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td colspan="1" style="width:100%;">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"
                                            style="width:25%; font-weight:bold;"></legend>

                                    <div class="row" style="margin:0px; margin-top:10px; margin-left:-10px;">

                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>

                                                    <!-- Posting Date -->
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label class="form-control controlLabel">
                                                                Posting Date
                                                            </label>
                                                        </div>
                                                    </td>

                                                    <td style="width:40%;">
                                                        <div class="form-group">

                                                            <table style="width:100%;">
                                                                <tr>
                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text"
                                                                                   class="form-control pull-right datetime form-control-insde"
                                                                                   readonly
                                                                                   id="txt_posting_date"
                                                                                   value="@docdate">
                                                                        </div>
                                                                    </td>

                                                                    <td style="width:20%; text-align:right; padding-right:10px">
                                                                        Due Date
                                                                    </td>

                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text"
                                                                                   class="form-control pull-right datetime form-control-insde"
                                                                                   readonly
                                                                                   id="txt_due_date"
                                                                                   value="@docdate">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>

                                                        </div>
                                                    </td>

                                                    <!-- Customer -->
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label class="form-control controlLabel">
                                                                Customer
                                                            </label>
                                                        </div>
                                                    </td>

                                                    <td style="width:40%;">
                                                        <div class="input-group">
                                                            <input type="text"
                                                                   class="form-control form-control-insde"
                                                                   id="txt_card_code"
                                                                   readonly
                                                                   placeholder="Customer">

                                                            <div class="input-group-addon">
                                                                <i class="fa fa-user text-info"
                                                                   onclick="cmd_show_customer_change_house('1','1')"
                                                                   style="cursor:pointer"></i>
                                                            </div>
                                                        </div>
                                                    </td>

                                                </tr>

                                                <!-- Remark + Ref -->
                                                <tr>
                                                    <td>
                                                        <div class="form-group">
                                                            <label class="form-control controlLabel">
                                                                Remark
                                                            </label>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <input type="text"
                                                               class="form-control form-control-insde"
                                                               id="txt_remark"
                                                               placeholder="Remark">
                                                    </td>

                                                    <td>
                                                        <div class="form-group">
                                                            <label class="form-control controlLabel">
                                                                Ref
                                                            </label>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <input type="text"
                                                               class="form-control form-control-insde"
                                                               id="txt_ref"
                                                               placeholder="Ref">
                                                    </td>
                                                </tr>

                                            </thead>
                                        </table>

                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                        <!-- ================= INTEREST LISTING ================= -->

                        <tr>
                            <td colspan="4">

                                <fieldset class="scheduler-border" style="padding:5px;">
                                    <legend class="scheduler-border" style="font-weight:bold;">
                                        <span style="cursor:pointer;"
                                              onclick="togglePenaltyTable()">
                                            Interest Listing
                                            <i id="toggle_penalty_icon"
                                               class="fa fa-chevron-up"
                                               style="margin-left:5px;"></i>
                                        </span>
                                    </legend>

                                    <div id="penalty_table_wrapper"
                                         class="row"
                                         style="margin:0px; margin-top:10px; position:relative; min-height:30vh; height:100%; overflow:auto">

                                        <table class="table"
                                               id="table_penalty_list"
                                               style="margin-bottom:0px; position:absolute; min-width:2000px; width:100%;">

                                            <thead style="position:sticky; top:0; z-index:1000;">
                                                <tr class="bg-gray">
                                                    <td style="width:2%;">#</td>
                                                    <td style="width:7%;">Posting Date</td>
                                                    <td style="width:7%;">Accrual Date</td>
                                                    <td style="width:5%;">Cus.Code</td>
                                                    <td style="width:8%;">Cus.Name</td>
                                                    <td style="width:6%;">Principle</td>
                                                    <td style="width:5%;">Interest</td>
                                                    <td style="width:4%;">Penalty%</td>
                                                    <td style="width:6%;">Penalty$</td>
                                                    <td style="width:5%;">Waive%</td>
                                                    <td style="width:5%;">Waive$</td>
                                                    <td style="width:5%;">Inv Amt</td>
                                                    <td style="width:11%;">Remark</td>
                                                </tr>
                                            </thead>

                                            <tbody></tbody>

                                        </table>

                                    </div>
                                </fieldset>

                            </td>
                        </tr>

                    </thead>
                </table>
            </div>

            <!-- Footer Buttons -->
            <div class="box-footer">
                <button type="button"
                        class="btn btn-danger btn-flat"
                        onclick="cmd_remove_all_row_payment_schedule()">
                    Remove Row
                </button>

                <button type="button"
                        style="background-color:green"
                        class="btn btn-info btn-flat"
                        id="btn_generate_penalty_List"
                        onclick="cmd_penaltydraf_waive_generate()">
                    Load Interest
                </button>

                <button type="button"
                        class="btn btn-primary btn-flat"
                        onclick="cmd_save_penaltyDraf()">
                    Submit
                </button>
            </div>

        </div>
    </div>
</div>