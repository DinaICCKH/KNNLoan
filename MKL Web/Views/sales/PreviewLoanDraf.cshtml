                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <table style="width:100%;" id="table_doc_discount">
                                                                <tr>
                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text" class="form-control pull-right datetime form-control-insde" disabled readonly="readonly" id="txt_request_date" placeholder="Request Date" value="@CreateDate">
                                                                        </div>
                                                                    </td>

                                                                    <td style="width:10%;">
