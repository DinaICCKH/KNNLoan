                                                    <td class="bg-gray" style="text-align:left;" id="txt_total_interest">0.00</td>
                                                    <td class="bg-gray" style="text-align:left;" id="txt_total_monthly">0.00</td>
                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                    <td class="bg-gray" style="text-align:right;"></td>
