</div>

<div id="alert-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>


<script>
    $(document).ready(function () {

         var checkbutton = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Checkbutton.FirstOrDefault()));
             var checkbuttonstatus = checkbutton?.Approver ?? "N";
             console.log("checkbuttonstatus:", checkbuttonstatus);

             if (checkbuttonstatus.toUpperCase() === 'Y') {
                 console.log("Showing buttons");
                 $('#btnReject').show();
                 $('#btnApprove').show();
             } else {
                 console.log("Hiding buttons");
                 $('#btnReject').hide();
                 $('#btnApprove').hide();
        }

        function sumColumn(className) {
            let total = 0;
            $("." + className).each(function () {
                let val = parseFloat($(this).text().replace(/,/g, ''));
                if (!isNaN(val)) total += val;
            });
            return total.toFixed(2);
        }

        $('#txt_total_principle').text(sumColumn("principle"));
        $('#txt_total_interest').text(sumColumn("interest"));
        $('#txt_total_monthly').text(sumColumn("monthly"));

        // Load column settings UI
        buildColumnSettingsCheckboxes();
    });

    function toggle() {
        var wrapper = document.getElementById("table_wrapper");
        var icon = document.getElementById("toggle_icon");

        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

</script>


