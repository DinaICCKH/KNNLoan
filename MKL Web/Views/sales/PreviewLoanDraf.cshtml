                        <tr class="change-period">
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border" style="font-weight: bold;">
                                        <span style="cursor: pointer;" onclick="toggle()">
                                            Schedule List
                                            <i id="toggle_chnagePeriod_icon" class="fa fa-chevron-up" style="margin-left: 5px;"></i>
                                        </span>
                                    </legend>

                                    <div class="text-right" style="margin-top: 0px; margin-bottom: 10px;">

                                        <!-- Settings button -->
                                        <button type="button" class="btn btn-check btn-flat" onclick="openColumnSettings('table_payment_schedule')">
                                            <i class="fa fa-cog"></i> Settings
                                        </button>

                                        <button type="button" class="btn btn-success btn-flat" id="btn_copy_schedule_to_excel" onclick="copyTableToClipboard('table_payment_schedule',1,'Restructure change Period')">
                                            <i class="fa fa-copy"></i> Copy Table
                                        </button>

                                    </div>

                                    <!-- Toggleable content - shown by default -->
                                    <div id="table_wrapper" class="row" style="position: relative; overflow: auto; height: 100%; min-height: 30vh">
                                        <table class="table" style="margin-bottom: 0px; position: absolute; min-width: 2000px; width: 100%;">
                                            <thead style="position:sticky; top: 0; z-index: 1000;">
                                                <tr class="bg-gray" role="row">

                                                    <th style="width:1%; text-align:left;">#</th>
                                                    <th style="width: 10%; text-align: left;">DocDate</th>
                                                    <th style="width: 7%; text-align: left;">DueDate</th>
                                                    <th style="width: 6%; text-align: left;">Principle</th>
                                                    <th style="width: 6%; text-align: left;">Interest</th>
                                                    <th style="width: 6%; text-align: left;">Monthly</th>
                                                    <th style="width: 6%; text-align: left;">Remain</th>
                                                    <th style="width: 6%; text-align: left;">Re+Int</th>
                                                    <th style="width: 6%; text-align: left;">C.Prin</th>
                                                    <th style="width: 5%; text-align: left;">C.Int</th>
                                                    <th style="width: 6%; text-align: left;">C.Prin+Int</th>
                                                    <th style="width: 6%; text-align: left;">Pay.Type</th>
                                                    <th style="width: 5%; text-align: left;">ARNo</th>
                                                    <th style="width: 5%; text-align: left;">PayNo</th>
                                                    <th style="width: 5%; text-align: left;">Int.ARNo</th>
                                                    <th style="width: 5%; text-align: left;">Int.PayNo</th>
                                                    <th style="width: 2%; text-align: left;">V.Day</th>
                                                    <th style="width: 5%; text-align: left;">Int.Re.Amt</th>
                                                    <th style="width: 8%; text-align: left;">Remark</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int index = 1;
                                                    foreach (var item in installment)
                                                    {
                                                        <tr>
                                                            <td>@index</td>
                                                            <td>@Convert.ToDateTime(item.PaymentDate).ToString("dd-MMM-yyyy")</td>
                                                            <td>@Convert.ToDateTime(item.DueDate).ToString("dd-MMM-yyyy")</td>
                                                            <td class="principle">@String.Format("{0:N2}", item.Principle)</td>
                                                            <td class="interest">@String.Format("{0:N2}", item.Interest)</td>
                                                            <td class="monthly">@String.Format("{0:N2}", item.Monthly)</td>
                                                            <td>@String.Format("{0:N2}", item.Remaining)</td>
                                                            <td>@String.Format("{0:N2}", item.Remaining + item.Interest)</td>
                                                            <td>@String.Format("{0:N2}", item.CuPayment)</td>
                                                            <td>@String.Format("{0:N2}", item.CuInterest)</td>
                                                            <td>@String.Format("{0:N2}", item.CuPayment + item.CuInterest)</td>
                                                            <td>@item.Method</td>

                                                            <td>@item.ARNo</td>
                                                            <td>@item.PaymentNo</td>
                                                            <td>@item.ARNoInterest</td>
                                                            <td>@item.PaymentNoInterest</td>
                                                            <td style="color:@(item.VarianDay > 0 ? "red" : (item.VarianDay < 0 ? "green" : "inherit"))">
                                                                @item.VarianDay
                                                            </td>
                                                            <td style="color:@(item.InterestonsheduleVarian > 0 ? "red" : (item.InterestonsheduleVarian < 0 ? "green" : "inherit"))">
                                                                @String.Format("{0:N2}", item.InterestonsheduleVarian)
                                                            </td>

                                                            <td>@item.Remarks</td>
                                                        </tr>
                                                        index++;
                                                    }
                                                }
                                            </tbody>

                                            <tfoot>
                                                <tr>
                                                    <td class="bg-gray" style="text-align:right;"></td>
                                                    <td class="bg-gray" style="text-align:right;"></td>
