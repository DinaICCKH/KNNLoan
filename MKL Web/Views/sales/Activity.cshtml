<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        // Event delegation: Bind click event to dynamically created remove icons
        $("#table_customer_list").on("click", ".fa-remove", function () {
            $(this).closest("tr").remove(); // Remove the row
        });
    });


    document.getElementById("btn_generate_customerlist").addEventListener("click", function () {
        var wrapper = document.getElementById("customer_table_wrapper");
        var icon = document.getElementById("toggle_icon");

        // Force show it again if hidden
        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        }
    });


    function togglePenaltyTable() {
        var wrapper = document.getElementById("penalty_table_wrapper");
        var icon = document.getElementById("toggle_penalty_icon");

        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

</script>

