@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Interest Wizard Approval Listing";
    List<ICC_Get_List_Approval_interestWizardResult> applist = ViewBag.Listing;
}

<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>
</head>

<section class="content-header">
    <h4 style="margin:0;padding:8px 0;">
        @ViewBag.Title
    </h4>
</section>

@using (Html.BeginForm("InterestWizardApprovalListing", "Sales", FormMethod.Get))
{
    <div class="box box-primary">
        <div class="box-body">

            <div class="form-inline" style="display:flex;align-items:center;gap:12px;flex-wrap:nowrap;overflow-x:auto;">

                <div class="form-group">
                    <label style="margin-right:5px;">Status</label>

                    @Html.DropDownList("Status",
                        new List<SelectListItem>
                        {
                            new SelectListItem{Text="Draf",Value="Draf"},
                            new SelectListItem{Text="Approve",Value="Approve"},
                            new SelectListItem{Text="Reject",Value="Reject"},
                            new SelectListItem{Text="Closed",Value="Closed"}
                        },
                        "All",
                        new
                        {
                            @class = "form-control input-sm",
                            style = "width:110px;"
                        })
                </div>

                <div class="form-group">
                    <label style="margin-right:5px;">From</label>

                    <div class="input-group date">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>

                        <input type="text"
                               id="fdate"
                               name="fdate"
                               value="@Request["fdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:105px;" />
                    </div>
                </div>

                <div class="form-group">
                    <label style="margin-right:5px;">To</label>

                    <div class="input-group date">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>

                        <input type="text"
                               id="tdate"
                               name="tdate"
                               value="@Request["tdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:105px;" />
                    </div>
                </div>

                <div class="form-group">
                    <label style="margin-right:5px;">Create By</label>

                    @Html.TextBox(
                        "CreateBy",
                        Request["CreateBy"],
                        new
                        {
                            @class = "form-control input-sm",
                            style = "width:120px;",
                            placeholder = "Create By"
                        })
                </div>

                <div class="form-group">
                    <label style="margin-right:5px;">Serial</label>

                    @Html.TextBox(
                        "Serial",
                        Request["Serial"],
                        new
                        {
                            @class = "form-control input-sm",
                            style = "width:120px;",
                            placeholder = "Serial"
                        })
                </div>

                <div class="form-group">
                    <label style="margin-right:5px;">Customer</label>

                    @Html.TextBox(
                        "Customer",
                        Request["Customer"],
                        new
                        {
                            @class = "form-control input-sm",
                            style = "width:170px;",
                            placeholder = "Customer"
                        })
                </div>

                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-search"></i>
                    Search
                </button>

                <a href="@Url.Action("InterestWizardApprovalListing","Sales")"
                   class="btn btn-default btn-sm">
                    <i class="fa fa-refresh"></i>
                    Reset
                </a>

            </div>

        </div>
    </div>
}

<div class="box box-primary">

    <div class="box-body">

        <div class="table-responsive">

            <table id="table_pr_assignment"
                   class="table table-bordered table-hover nowrap"
                   style="width:100%;">

                <thead>

                    <tr class="bg-gray">

                        <th style="width:50px;">No.</th>
                        <th>DocEntry</th>
                        <th>Card Code</th>
                        <th>Card Name</th>
                        <th>Serial</th>
                        <th>Posting Date</th>
                        <th>DocNum Ref</th>
                        <th>Approval Template</th>
                        <th>Next Approver</th>
                        <th>Request Date</th>
                        <th>Request By</th>
                        <th>Status</th>
                        <th>Remark</th>
                        <th>SAP DocNum</th>
                        <th>Sync Message</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int row = 1;

                        foreach (var x in applist)
                        {
                                        <tr>

                                            <td class="text-center">
                                                @row
                                            </td>

                                            <td>
                                                <a href="/Sales/PreviewInterestwizard?DocEntry=@x.DocEntry">
                                                    @x.DocEntry
                                                </a>
                                            </td>

                                            <td>@x.CardCode</td>

                                            <td>@x.CardName</td>
                                            <td>@x.Serial</td>

                                            <td>
                                                @x.PostingDate.ToString("dd-MMM-yyyy")
                                            </td>

                                            <td>@x.DocNumRef</td>

                                            <td>@x.TemplateDesc</td>

                                            <td>@x.NextApprover</td>

                                            <td>
                                                @(x.CreateDate?.ToString("dd-MMM-yyyy"))
                                            </td>

                                            <td>@x.CreateBy</td>

                                            <td>
                                                @if (x.Status == "Approve")
                                                {
                                                    <span class="label label-success">@x.Status</span>
                                                }
                                                else if (x.Status == "Reject")
                                                {
                                                    <span class="label label-danger">@x.Status</span>
                                                }
                                                else if (x.Status == "Closed")
                                                {
                                                    <span class="label label-primary">@x.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-warning">@x.Status</span>
                                                }
                                            </td>

                                            <td>@x.Remark</td>

                                            <td>@x.SapDocNum</td>

                                            <td>@x.LastError</td>

                                        </tr>

                            row++;
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

    $(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({

            scrollX: true,
            fixedHeader: true,
            pageLength: 50,
            autoWidth: false,

            order: [[1, "desc"]],

            dom: 'Bfrtip',

            buttons: [
                'copy',
                'excel',
                'print'
            ],

            language: {
                search: "Search :",
                lengthMenu: "Show _MENU_ Rows",
                info: "Showing _START_ to _END_ of _TOTAL_ Rows",
                zeroRecords: "No matching records found"
            }

        });

    });

</script>