@using MKL_Web.Models;
@{
    ViewBag.Title = "Invoice Listing";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> block = ViewBag.block;
    List<v_OCRD> cust = ViewBag.cust;
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
</head>
<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_customer_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>
                                <th style="width:15%">ID</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_fname_@rowindex">@x.CardFName</td>
                                        <td id="td_pop_vendor_cust_gender_@rowindex">@x.U_Gender</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Phone1</td>
                                        <td id="td_pop_vendor_cust_id_@rowindex">@x.AddID</td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_customer_InvoiceList()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="row">
    <input type="hidden" id="txt_bp_selected_row" />
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td>
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Search House Info</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:6%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Project</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:13%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_project">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in project)
                                                                    {
                                                                        <option value="@x.PrcName">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:6%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Block</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:11%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_block">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in block)
                                                                    {
                                                                        <option value="@x.PrcCode">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:9%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:13%;">
                                                        <div class="input-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_card_code" readonly="readonly" placeholder="Customer Code">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-user text-info" onclick="cmd_show_customer()" style="cursor:pointer"></i>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:9%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:25%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_card_name" readonly="readonly" placeholder="Customer Name">
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <button type="button" class="btn btn-info btn-flat" onclick="get_invoice_listing()">Search</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                        <table class="table" style="margin-bottom:0px;" id="table_sales_invoice_list">
                                            <thead>
                                                <tr class="bg-gray" role="row">
                                                    <td style="width:3%;">#</td>
                                                    <td style="width:8%">AR No</td>
                                                    <td style="width:7%">Posting Date</td>
                                                    <td style="width:7%">Due Date</td>
                                                    <td style="width:8%">Customer Code</td>
                                                    <td>Customer Name</td>
                                                    <td style="width:8%">Project</td>
                                                    <td style="width:7%">Block</td>
                                                    <td style="width:7%">House</td>
                                                    <td style="width:9%">Total</td>
                                                    <td style="width:5%">Status</td>
                                                    <td style="width:5%">Syn</td>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button type="button" class="btn btn-danger btn-flat" onclick="cmd_cancel_reload()">Cancel</button>
            </div>
        </div>
    </div>
</div>

