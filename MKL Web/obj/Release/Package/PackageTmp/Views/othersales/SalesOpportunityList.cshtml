@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sales Opportunity Listing";
    List<SalesOpport> po = ViewBag.saleList;
    //List<USR> user = ViewBag.user;
}
<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h5>@ViewBag.Title</h5>
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment" class="table table-bordered table-hover dataTable no-footer">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" style="width: 5%">Sales No</th>
                            <th class="sorting_disabled" style="width: 10%">Start Date</th>
                            <th class="sorting_disabled" style="width: 10%">Closed Date</th>
                            <th class="sorting_disabled" style="width: 10%">Customer Code</th>
                            <th class="sorting_disabled">Costomer Name</th>
                            <th class="sorting_disabled" style="width: 10%">Potential Amount</th>
                            <th class="sorting_disabled" style="width: 10%">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            string boqtype = "";
                            foreach (var x in po)
                            {
                                <tr id="tr_@rowindex">
                                    <td style="display:none">@x.DocEntry</td>
                                    <td style="cursor:pointer;color:blue;text-decoration:underline;text-align:center;">
                                        <a href="/othersales/SalesOpportunityEdit?key=@x.DocEntry">@x.DocEntry</a>
                                    </td>
                                    <td style="text-align:center;">@x.StartDate.Value.ToString("dd-MMM-yyyy")</td>
                                    @if (x.DocStatus == "Open")
                                    {
                                        <td style="text-align:center;"></td>
                                    }
                                    else
                                    {
                                        <td style="text-align:center;">@x.ClosedDate.Value.ToString("dd-MMM-yyyy")</td>
                                    }
                                    <td style="text-align:center;">@x.CardCode</td>
                                    <td style="text-align:left;">@x.CardName</td>
                                    <td style="text-align:right;">@x.PotentialAmt.Value.ToString("N2")</td>
                                    <td style="text-align:center;">@x.DocStatus</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
