@using MKL_Web.Models;
@{
    ViewBag.Title = "Approval Stage";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<AppStage>
    applist = ViewBag.appstage;
    List<USR> user = ViewBag.user;
    int rowindex = 1;
    List<v_CostCenter> pro = ViewBag.pro;
    List<v_Department> dep = ViewBag.dep;
}
<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/ApprovalTemplate.js"></script>
</head>
<input type="hidden" id="txt_stage_code" value="-1" />
<input type="hidden" id="txt_selected_approver_stage_index" value="1" />
<input type="hidden" id="txt_selected_approver_index" value="1" />
<input type="hidden" id="txt_selected_user_index" value="1" />
<input type="hidden" id="txt_user_stage1_index" value="1" />

<select style="display:none" id="cbo_app_order">
    <option value="1">1</option>
    <option value="2">2</option>
    <option value="3">3</option>
    <option value="4">4</option>
    <option value="5">5</option>
    <option value="6">6</option>
</select>

<div class="modal fade" id="modal_stage_ist" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Approval Stage List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_popup_approval_stage_list" class="table">
                        <thead>
                            <tr>
                                <td colspan="2">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_up_search_approval_stage" onkeyup="Find_Stage()" autofocus placeholder="Find Approval Stage">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:15%">Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in applist)
                                {
                                    <tr onclick="tr_approval_stage_click(@rowindex)" id="tr_approval_stage_@rowindex">
                                        <td>@rowindex</td>
                                        <td id="td_stage_code_@rowindex">@x.AppStageCode</td>
                                        <td id="td_stage_name_@rowindex">@x.AppDes</td>
                                        <td id="td_fn_stock_@rowindex" style="display:none">@x.FNStock</td>
                                        <td id="td_ocrcode_@rowindex" style="display:none">@x.OcrCode</td>
                                        <td id="td_department_@rowindex" style="display:none">@x.Department</td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_choose_stage()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="modal_user_ist" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5>User List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_popup_user_list" class="table">
                        <thead>
                            <tr>
                                <td colspan="2">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt_pop_up_search_user" onkeyup="Find_Stage_User()" placeholder="search user">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:15%">User Code</th>
                                <th>User Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in user)
                                {
                                    <tr onclick="tr_user_click(@rowindex)" id="tr_user_@rowindex">
                                        <td>@rowindex</td>
                                        <td id="td_user_code_@rowindex">@x.UserCode</td>
                                        <td id="td_user_name_@rowindex">@x.UserName</td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_choose_user()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-2">

        </div>
        <div class="col-md-8">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h5 class="box-title">@ViewBag.Title</h5>
                </div>
                <div class="box-header with-border">
                    <table class="table" role="none">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Description</label>
                                    </div>
                                </td>
                                <td style="width:80%;">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_app_name" placeholder="Description">
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-flat" onclick="show_stage()">Find</button>
                                </td>
                            </tr>
                            
                            @*<tr>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Project</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <select class="form-control" id="cbo_ocrcode">
                                        @{
                                            foreach (var x in pro)
                                            {
                                                <option value="@x.PrcCode">@x.PrcName</option>
                                            }
                                        }
                                    </select>
                                </td>
                            </tr>*@
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Department</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <select class="form-control" id="cbo_department">
                                        <option value="-1">NON</option>
                                        @{
                                            foreach (var x in dep)
                                            {
                                                <option value="@x.Code">@x.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                            </tr>
                        </thead>
                    </table>
                    <table class="table" role="none" id="table_stage1">
                        <thead>
                            <tr class="bg-gray" role="row">
                                <td>#</td>
                                <td style="width:45%;">Approver</td>
                                <td style="width:15%">Approver Order</td>
                                <td>Description</td>
                                <td style="width:15%">Location ID</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="tr_stage1_0">
                                <td><span><i class="fa fa-remove text-danger"></i></span></td>
                                <td><input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_approver_0" placeholder="Approver" ondblclick='cmd_show_stage_user(0)'></td>
                                <td>
                                    <select class="form-control form-control-insde form-group" id="cbo_app_order_0">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                        <option value="5">5</option>
                                        <option value="6">6</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-insde" id="txt_description_0" placeholder="Description">
                                </td>
                                <td>
                                    <select class="form-control form-control-insde form-group" id="cbo_app_location_0">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                        <option value="5">5</option>
                                        <option value="6">6</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="box-footer btnaction">
                        <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_stage()">Submit</button>
                        <button type="button" class="btn btn-info btn-flat" onclick="cmd_new_stage()">New</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">

        </div>
    </div>
</div>