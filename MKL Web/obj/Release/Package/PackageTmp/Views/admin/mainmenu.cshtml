@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string pagename = ViewBag.Title;
    string adminpage = "";
    List<Main> mainmenu = ViewBag.mainmenu;
}
<head>
   <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h1>@pagename</h1>
        @Html.ActionLink("Back to Admin", "admin", "admin")|@Html.ActionLink("Create Sub Menu", "submenu", "admin")
    </section>

    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_admin_main_menu" class="table table-bordered table-hover dataTable no-footer" role="grid">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 20%">Code</th>
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 60%">Name</th>
                            <th style="width:150px" class="sorting_disabled" rowspan="1" colspan="1">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var x in mainmenu)
                            {
                                <tr role="row" class="odd">
                                    <td>
                                        <input type="text" class="form-control" placeholder="Menu Code" readonly="readonly" value="@x.MainCode" >
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" placeholder="Menu Description" value="@x.MainName">
                                    </td>
                                    <td>
                                        <select class="form-control" name="status">
                                            @if (x.MainStatus == "Active")
                                            {
                                                <option value="Active" selected>Active</option>
                                                <option value="Inactive">Inactive</option>
                                            }
                                            else
                                            {
                                                <option value="Active">Active</option>
                                                <option value="Inactive" selected>Inactive</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3">
                                <div class="col-md-12 clszeropadding-left">
                                    <div class="col-md-1 clszeropadding-left">
                                        <button type="button" style="padding-left:10%;" class="btn btn-block btn-info btn-flat" id="cmd_pa_submit" onclick="add_new_main_menu()">Add Menu</button>
                                    </div>
                                    <div class="col-md-1 clszeropadding-left">
                                        <button type="button" class="btn btn-block btn-primary btn-flat" id="cmd_pa_submit" onclick="cmd_save_admin('mainmenu')">Submit</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
