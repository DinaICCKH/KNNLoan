            <!-- /.tab-content -->
            <!--</div>-->
        <div class="box-footer">
            <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_user('new')">Submit</button>
            <button type="button" class="btn btn-primary btn-flat" onclick="window.location.href='/admin/Adm';">Back</button>
        </div>
        </div>
    </div>
</div>
