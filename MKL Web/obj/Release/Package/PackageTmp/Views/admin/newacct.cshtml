@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string pagename = ViewBag.Title;
    List<v_Department> dep = ViewBag.deplist;
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> Blocks = ViewBag.Blocks;

}
<head>
    <title>@ViewBag.Title</title>
</head>
<select id="cbo_block_list" style="display:none">
    @{
        foreach (var x in Blocks)
        {
            <option value="@x.PrcCode">@x.PrcName</option>
        }
    }
</select>

<div class="row">
    <!-- left column -->
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <div class="col-md-8" style="padding-left:0px">
                    <table class="table" role="none" style="border:none;padding:0px">
                        <thead>
                            <tr>
                                <td style="padding-top:10px;">User Code</td>
                                <td><input type="text" class="form-control" id="txt_admin_usercode" onchange="cbo_admin_check_user()" placeholder="User Code" value=""></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Full Name</td>
                                <td><input type="text" class="form-control" id="txt_admin_fullname" placeholder="Full Name"></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;width:20%;" class="no-border">Gender</td>
                                <td>
                                    <select class="form-control" id="cbo_admin_gender">
                                        @{
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Phone</td>
                                <td><input type="text" class="form-control" id="txt_admin_phone" placeholder="Phone"></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Email</td>
                                <td><input type="text" class="form-control" id="txt_admin_email" placeholder="Email"></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Position</td>
                                <td><input type="text" class="form-control" id="txt_position" placeholder="Position"></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Department</td>
                                <td>
                                    <select class="form-control" id="cbo_department">
                                        <option value=""></option>
                                        @{
                                            foreach (var x in dep)
                                            {
                                                <option value="@x.Code">@x.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Status</td>
                                <td>
                                    <select class="form-control" id="cbo_user_status">
                                        <option value="Active" selected>Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Password</td>
                                <td><input type="password" class="form-control" id="txt_admin_password" placeholder="Password" value="1111"></td>
                            </tr>
                            <tr>
                                <td style="padding-top:10px;">Change Next LogIn?</td>
                                <td>
                                    <select class="form-control" id="cbo_next_change">
                                        <option value="Y">Yes</option>
                                        <option value="N">No</option>
                                    </select>
                                </td>
                            </tr>
                        </thead>
                    </table>
                </div>
                <div class="col-md-2" style="padding-left:0px">
                    <table>
                        <thead>
                            <tr>
                                <td><img src="" id="img_preview" style="width:200px;height:200px;" /> </td>
                            </tr>
                            <tr>
                                <td><input type="file" id="img_user_signature" accept="image/png, image/gif, image/jpeg" onchange="esignature()" /></td>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
