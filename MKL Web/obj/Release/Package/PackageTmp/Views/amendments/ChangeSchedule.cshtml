@using MKL_Web.Models;
@{
    ViewBag.Title = "Reschedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_OCRD> cust = ViewBag.cust;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
    List<InstallmentList> installment = ViewBag.installment;
}

<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script src="~/Scripts/js/Dina_CustomizationFormSettingandCopytoClibord.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script>
        var originalInstallmentDates = [];

        $(document).ready(function () {

            // ===============================
            // STORE ORIGINAL INSTALLMENT DATES
            // ===============================
            window.storeOriginalDates = function () {
                originalInstallmentDates = [];
                $("input[id^='InstallmentDate_']").each(function () {
                    originalInstallmentDates.push($(this).val());
                });
            };

            // ===============================
            // UPDATE VARIAN DAY (ONLY OPEN ROWS)
            // ===============================

            function updateVarianDays() {

                let effectiveDate = moment($("#txt_effective_date").val(), "DD-MMM-YYYY");
                if (!effectiveDate.isValid()) return;

                let openRowCounter = 0;

                $("#table_payment_schedule tbody tr").each(function (index) {

                    let rowIndex = index + 1;
                    let rowStatus = $("#tr_payment_detail_status_line_" + rowIndex).text().trim();

                    if (rowStatus !== "O") return;

                    openRowCounter++;

                    let dueDateText = $("#tr_payment_detail_paymentdate_line_" + rowIndex).text().trim();
                    let dueDate = moment(dueDateText, "DD-MMM-YYYY");
                    if (!dueDate.isValid()) return;

                    if (dueDate.isAfter(effectiveDate)) {
                        $("#tr_payment_detail_varianday_line_" + rowIndex).text(0).css("color", "black");
                        $("#tr_payment_detail_interestonscheduleamt_line_" + rowIndex).text("0.00").css("color", "black");
                        return;
                    }

                    let postDateText = $("#InstallmentDate_" + rowIndex).val();
                    let postDate = moment(postDateText, "DD-MMM-YYYY");

                    let varianDay = 0;

                    if (openRowCounter === 1) {
                        varianDay = effectiveDate.diff(dueDate, 'days');
                    } else {
                        if (!postDate.isValid()) return;
                        varianDay = postDate.diff(dueDate, 'days');
                    }

                    if (isNaN(varianDay) || varianDay < 0) varianDay = 0;

                    $("#tr_payment_detail_varianday_line_" + rowIndex)
                        .text(varianDay)
                        .css("color", varianDay === 0 ? "black" : "red");

                    let monthlyPay = parseFloat(
                        $("#tr_payment_detail_monthlypay_line_" + rowIndex)
                            .text()
                            .replace(/,/g, '')
                    ) || 0;

                    let result = varianDay === 0
                        ? 0
                        : (monthlyPay * 0.0125) / 30 * varianDay;

                    if (isNaN(result)) result = 0;

                    $("#tr_payment_detail_interestonscheduleamt_line_" + rowIndex)
                        .text(result.toFixed(2))
                        .css("color", result === 0 ? "black" : "red");
                });
            }

            // ===============================
            // INSTALLMENT DATE CHANGE
            // ===============================
            $(document).on("change", "input[id^='InstallmentDate_']", function () {

                let changedInput = $(this);
                let changedId = changedInput.attr("id");
                let changedIndex = parseInt(changedId.split("_")[1]);

                let newDate = moment(changedInput.val(), "DD-MMM-YYYY");
                if (!newDate.isValid()) return;

                let targetDay = newDate.date();

                Swal.fire({
                    title: 'Apply date change to all next OPEN rows?',
                    text: "Yes = update all next OPEN rows. No = only this row.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, update all',
                    cancelButtonText: 'No, only this'
                }).then((result) => {

                    if (result.isConfirmed) {

                        let monthOffset = 0;

                        $("#table_payment_schedule tbody tr").each(function (index) {

                            let rowIndex = index + 1;
                            let rowStatus = $("#tr_payment_detail_status_line_" + rowIndex).text().trim();

                            if (rowIndex >= changedIndex && rowStatus === "O") {

                                let updatedDate = moment(newDate).add(monthOffset, 'months');
                                updatedDate.date(Math.min(targetDay, updatedDate.daysInMonth()));

                                $("#InstallmentDate_" + rowIndex)
                                    .val(updatedDate.format("DD-MMM-YYYY"));

                                monthOffset++;
                            }
                        });
                    }

                    updateVarianDays();
                    storeOriginalDates();
                });
            });

            // ===============================
            // VENDOR FILTER SCRIPT (ADDED)
            // ===============================
            $("#txt_pop_filter_vendor_name").on("keyup", function () {

                let keyword = $(this).val()
                    .replace(/\s+/g, '')
                    .toLowerCase();

                $("#table_pop_customer_list > tbody > tr").each(function () {

                    let id = $(this).attr('id').replace("tr_pop_customer_", "");

                    let text =
                        $("#td_pop_vendor_cust_code_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_cust_name_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_phone_" + id).text().toLowerCase();

                    text = text.replace(/\s+/g, '');

                    if (text.indexOf(keyword) === -1) {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });
            });

        });
    </script>


