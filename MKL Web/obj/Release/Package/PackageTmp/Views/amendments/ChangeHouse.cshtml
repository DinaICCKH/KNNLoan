<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    const txtBuyback = document.getElementById("txt_buyback_amt");
    let valueBeforeEdit = txtBuyback.value;

    // 🔹 Store value before editing
    txtBuyback.addEventListener("focus", function () {
        valueBeforeEdit = this.value;
        this.value = this.value.replace(/,/g, ''); // remove commas for edit
    });

    // 🔹 Allow only numbers and one decimal point
    txtBuyback.addEventListener("input", function () {
        this.value = this.value
            .replace(/[^0-9.]/g, '')      // remove non-numeric
            .replace(/(\..*)\./g, '$1');  // allow only one dot
    });

    // 🔹 On blur → format + confirm change
    txtBuyback.addEventListener("blur", function () {

        if (this.value === '') {
            this.value = '0';
        }

        // format with thousand separator
        this.value = formatAmount(this.value);

        // compare with previous value
        if (this.value !== valueBeforeEdit) {

            Swal.fire({
                title: 'Confirm Change',
                text: 'You have changed the buyback amount. The schedule will be reloaded again.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'No',
                allowOutsideClick: false
            }).then((result) => {
                if (result.isConfirmed) {
                    get_selected_payment_schedule_changeitem_by_so();
                } else {
                    this.value = valueBeforeEdit; // revert value
                }
            });
        }
    });

    // 🔹 Format number → 14,000.00
    function formatAmount(value) {
        let num = parseFloat(value);
        if (isNaN(num)) num = 0;

        return num.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }
</script>



