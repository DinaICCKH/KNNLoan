@using MKL_Web.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Accrual Penalty List Report";
}

<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>

    <style>
        td {
            vertical-align: middle !important;
            white-space: nowrap;
        }

        .short-text {
            display: inline;
        }

        .full-text {
            display: none;
            white-space: normal;
            max-width: 300px;
        }

        .toggle-text {
            margin-left: 5px;
            cursor: pointer;
            font-size: 12px;
        }

        tfoot td {
            font-weight: bold;
            background-color: #f1f1f1;
        }
    </style>
</head>

@using (Html.BeginForm("AccraulPenaltyListing", "amendments", FormMethod.Get))
{
    <section class="content-header content-header-title">
        <h5 style="padding-top:10px !important; padding-left:0px !important;">
            @ViewBag.Title
        </h5>
    </section>

    <div class="form-inline d-flex align-items-center flex-wrap" style="gap:10px; padding-bottom:10px !important">

        <div class="form-group mb-2">
            <label class="mr-1">Status</label>
            @Html.DropDownList("Status", new List<SelectListItem>
            {
                new SelectListItem { Text = "Draf", Value = "D" },
                new SelectListItem { Text = "Closed", Value = "C" },
                new SelectListItem { Text = "Reject", Value = "R" }
            }, "All", new { @class = "form-control form-control-sm", style = "width:120px;" })
        </div>

        <div class="form-group mb-2">
            <label class="mr-1">Frozen For</label>
            @Html.DropDownList("Frozen", new List<SelectListItem>
            {
                new SelectListItem { Text = "Y", Value = "Yes" },
                new SelectListItem { Text = "N", Value = "No" }
            }, "All", new { @class = "form-control form-control-sm", style = "width:120px;" })
        </div>

        <div class="form-group mb-2">
            <label class="mr-2">From Date</label>
            <div class="input-group date">
                <div class="input-group-addon"><i class="fa fa-calendar"></i></div>
                <input type="text" class="form-control datetime" id="fdate" placeholder="From Date" readonly />
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="mr-2">To Date</label>
            <div class="input-group date">
                <div class="input-group-addon"><i class="fa fa-calendar"></i></div>
                <input type="text" class="form-control datetime" id="tdate" placeholder="To Date" readonly />
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="mr-3">Item</label>
            @Html.TextBox("Item", Request["Item"], new { @class = "form-control form-control-sm", style = "width:120px;" })
        </div>

        <div class="form-group mb-2">
            <label class="mr-2">Serial</label>
            @Html.TextBox("Serial", Request["Serial"], new { @class = "form-control form-control-sm", style = "width:120px;" })
        </div>

        <div class="form-group mb-2">
            <label class="mr-2">Customer</label>
            @Html.TextBox("Customer", Request["Customer"], new { @class = "form-control form-control-sm", style = "width:140px;" })
        </div>

        <div class="form-group mb-2 ml-2">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment" class="table table-bordered table-hover display nowrap" style="width:100%">
                    <thead>
                        <tr class="bg-gray">
                            <th>ID</th>
                            <th>In.Entry</th>
                            <th>Card Code</th>
                            <th>Card Name</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Serial No</th>
                            <th>Doc Comment</th>
                            <th>Due Date</th>
                            <th>Payment Date</th>
                            <th>CHQ Amt</th>
                            <th>Principal Amt</th>
                            <th>Interest Amt</th>
                            <th>Outstanding Amt</th>
                            <th>Penalty %</th>
                            <th>Penalty Amt</th>
                            <th>Over Days</th>
                            <th>Remark</th>
                            <th>Status</th>
                            <th>Approval Template</th>
                            <th>Last Approval</th>
                            <th>Frozen For</th>
                            <th>Frozen Remark</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <td colspan="16" style="text-align:right">Totals:</td>
                            <td id="totalOverDays"></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {

    $('.datetime').datepicker({ autoclose: true, format: 'dd-M-yyyy' });

    var table = $('#table_pr_assignment').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '@Url.Action("GetAccrualPenaltyAjax", "amendments")',
            type: 'GET',
            data: function(d) {
                d.Status = $('#Status').val();
                d.Frozen = $('#Frozen').val();
                d.fdate = $('#fdate').val();
                d.tdate = $('#tdate').val();
                d.Item = $('input[name="Item"]').val();
                d.Serial = $('input[name="Serial"]').val();
                d.Customer = $('input[name="Customer"]').val();
            }
        },
        scrollX: true,
        fixedHeader: true,
        lengthMenu: [[20, 50, 100, -1], [20, 50, 100, "All"]],
        pageLength: 50,
        dom: 'Bfrtip',
        buttons: ['copy', 'excel', 'print'],
        columnDefs: [{ targets: '_all', className: 'dt-head-center' }],
        drawCallback: function(settings) {
            var api = this.api();
            var totalOver = api.column(16, { page: 'current' }).data().reduce(function(a,b){
                return a + parseFloat(b) || 0;
            }, 0);
            var totalPenalty = api.column(15, { page: 'current' }).data().reduce(function(a,b){
                return a + parseFloat(b) || 0;
            }, 0);
            var totalInv = api.column(13, { page: 'current' }).data().reduce(function(a,b){
                return a + parseFloat(b) || 0;
            }, 0);
            $('#totalOverDays').html(totalOver);
        }
    });

    // Toggle Show/Hide
    $(document).on("click", ".toggle-text", function () {
        var td = $(this).closest("td");
        var shortText = td.find(".short-text");
        var fullText = td.find(".full-text");
        if(fullText.is(":visible")) {
            fullText.hide(); shortText.show(); $(this).text("Show");
        } else {
            shortText.hide(); fullText.show(); $(this).text("Hide");
        }
    });

});
</script>