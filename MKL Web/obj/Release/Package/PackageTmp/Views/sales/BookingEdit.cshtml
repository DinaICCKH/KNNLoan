@using MKL_Web.Models;
@{
    ViewBag.Title = "Edit Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> block = ViewBag.block;
    List<OCRD> cust = ViewBag.cust;
    List<v_Item_House> houselist = ViewBag.houselist;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
    SO s = ViewBag.so;
    SO1 s1 = ViewBag.so1;
    List<v_Contact> contact = ViewBag.contact;
    InstallmentRow inst = ViewBag.inst;
}
<head>
    <script src="../../Scripts/js/Booking.js"></script>
</head>
<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_customer_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_fname_@rowindex">@x.FrgnName</td>
                                        <td id="td_pop_vendor_cust_gender_@rowindex">@x.Gender</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Tel1</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_customer()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="modal fade" id="modal-item-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">House Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_vendor_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="House Code">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Description</th>
                                <th style="width:23%">Description KH</th>
                                <th style="width:10%">Amount</th>
                                <th style="width:15%">Project</th>
                                <th style="width:8%">Block</th>
                                <th style="width:10%">House Code</th>
                                <th style="width:10%">Streett</th>
                                <th style="width:12%">House No</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in houselist)

                                {
                                    <tr id="tr_pop_item_@rowindex" onclick="tr_pop_item_selected(@rowindex)">
                                        <td id="td_pop_item_code_@rowindex" style="display:none">@x.ItemCode</td>
                                        <td id="td_pop_item_name_@rowindex">@x.ItemName</td>
                                        <td id="td_pop_item_fname_@rowindex">@x.FrgnName</td>
                                        <td id="td_pop_item_amount_@rowindex" style="text-align:right">@x.HouseAmount.ToString("N2")</td>
                                        <td id="td_pop_item_project_name_@rowindex">@x.Project</td>
                                        <td id="td_pop_item_zone_name_@rowindex">@x.ZoneName</td>
                                        <td id="td_pop_item_house_code_@rowindex">@x.HouseCode</td>
                                        <td id="td_pop_item_street_@rowindex">@x.U_Street</td>
                                        <td id="td_pop_item_house_no_@rowindex">@x.HouseNo</td>
                                        <td id="td_pop_item_ocrcode_@rowindex" style="display:none">@x.Project</td>
                                        <td id="td_pop_item_ocrcode2_@rowindex" style="display:none">@x.Zone</td>
                                        <td id="td_pop_item_ocrcode3_@rowindex" style="display:none">@x.HouseCode</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_item()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="row">
    <input type="hidden" id="txt_dockey" value="@s.DocEntry" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" />
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_code" readonly="readonly" placeholder="Customer Code" value="@s.CardCode">
                                    <div class="input-group-addon">
                                        <i class="fa fa-user text-info" style="cursor:not-allowed"></i>
                                    </div>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">SO No</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_doc_num" readonly="readonly" placeholder="SO No" value="@s.DocNum">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_name" placeholder="Customer Name" value="@s.CardName" readonly>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Posting Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_doc_date" placeholder="Posting Date" value="@s.DocDate.Value.ToString("dd-MMM-yyyy")" disabled>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Contact</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <select class="form-control form-control-insde" id="cbo_contact_person" disabled>
                                        <option value=""></option>
                                        @foreach (var a in contact.Where(a => a.CardCode == s.CardCode).ToList())
                                        {
                                            if (a.CntctCode == s.ContactPerson)
                                            {
                                                <option selected value="@a.CntctCode">@a.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@a.CntctCode">@a.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Delivery Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_due_date" placeholder="Delivery Date" value="@s.DueDate.Value.ToString("dd-MMM-yyyy")" disabled>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Referral</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    @if (s.Reason == "BKN" && s.DocStatus=="Booking")
                                    {
                                        <input type="text" class="form-control form-control-insde" id="txt_referral" placeholder="Referral" value="@s.Referral">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-insde" id="txt_referral" placeholder="Referral" value="@s.Referral" readonly>
                                    }
                                </div>
                            </td>
                            <td style="width:12%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Construction Period</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    @if (s.Reason == "BKN" && s.DocStatus=="Booking")
                                    {
                                    <input type="text" class="form-control form-control-insde" id="txt_con_period" placeholder="Construction Period" value="@s.ConPeriod">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-insde" id="txt_con_period" placeholder="Construction Period" value="@s.ConPeriod" readonly>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">House Information</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr style="display:none">
                                                    <td>
                                                        <input type="hidden" id="txt_ocrcode" value="@s.OcrCode"/>
                                                        <input type="hidden" id="txt_ocrcode2" value="@s1.OcrCode2"/>
                                                        <input type="hidden" id="txt_ocrcode3" value="@s1.OcrCode3"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">House Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="input-group">
                                                            <input type='text' style="display:none" class='form-control noborder' id="txt_item_code" readonly="readonly" placeholder='House Code' value="@s1.ItemCode">
                                                            <input type='text' class='form-control noborder' id="txt_house_code" readonly="readonly" placeholder='House Code' value="@s1.OcrCode3">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-industry text-info" style="cursor:not-allowed"></i>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Description</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_item_name" placeholder="House Description" value="@s1.ItemName">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Before Disc. Amt</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_before_discount_amount" placeholder="Before Disc. Amt" value="@s.DocTotalBef.Value.ToString("N2")">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Project</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_project" placeholder="Project" value="@s.OcrCode">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Discount Amount</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <table style="width:100%">
                                                            @if (s.Reason == "BKN" && s.DocStatus=="Booking")
                                                            {
                                                            <tr>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_amount" placeholder="Discount Amt" value="@inst.DiscountAmount.Value.ToString("N2")" onchange="txt_discount_amount_change()">
                                                                    </div>
                                                                </td>
                                                                <td style="width:5%">(%)</td>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_per" placeholder="Discount Per" value="@inst.DiscountPer.Value.ToString("N2")" onchange="txt_discount_per_change()">
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            }
                                                            else
                                                            {
                                                            <tr>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_amount" placeholder="Discount Amt" value="@inst.DiscountAmount.Value.ToString("N2")" readonly>
                                                                    </div>
                                                                </td>
                                                                <td style="width:5%">(%)</td>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_per" placeholder="Discount Per" value="@inst.DiscountPer.Value.ToString("N2")" readonly>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            }
                                                        </table>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Booking Amount</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <table style="width:100%">
                                                            @if (s.Reason == "BKN" && s.DocStatus == "Booking")
                                                            {
                                                                <tr>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_booking_amount" placeholder="Discount Amt" value="@s.DepositAmt.Value.ToString("N2")" onchange="txt_booking_amount_change()">
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:5%">(%)</td>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_booking_per" placeholder="Discount Per" value="@s.DepositPer.Value.ToString("N2")" onchange="txt_booking_per_change()">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_booking_amount" placeholder="Discount Amt" value="@s.DepositAmt.Value.ToString("N2")" readonly>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:5%">(%)</td>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_booking_per" placeholder="Discount Per" value="@s.DepositPer.Value.ToString("N2")" readonly>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Special Disc. Amt</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <table style="width:100%">
                                                            @if (s.Reason == "BKN" && s.DocStatus=="Booking")
                                                            {
                                                                <tr>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_special_dis_amount" placeholder="Special Discount Amount" value="@inst.SpecialDisAmount.Value.ToString("N2")" onchange="txt_special_discount_amount_change()">
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:5%">(%)</td>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_special_dis_per" placeholder="Special Discount %" value="@inst.SpecialDisPer.Value.ToString("N2")" onchange="txt_special_discount_per_change()">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_special_dis_amount" placeholder="Special Discount Amount" value="@inst.SpecialDisAmount.Value.ToString("N2")" readonly>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:5%">(%)</td>
                                                                    <td style="width:45%">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" id="txt_special_dis_per" placeholder="Special Discount %" value="@inst.SpecialDisPer.Value.ToString("N2")" readonly>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </table>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Remaning</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_remaining_amount" placeholder="Discount Amt" value="@inst.Remaining.Value.ToString("N2")" readonly="readonly">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">House Amount</label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_after_discount" placeholder="Special Discount Amount" value="@s.SubTotal.Value.ToString("N2")" readonly="readonly">
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">

                @if (s.Reason == "BKN" && s.DocStatus == "Booking")
                {
                    <button type="button" class="btn btn-primary btn-flat" onclick="save_booking()">Submit</button>
                    <button type="button" class="btn btn-warning btn-flat" onclick="cancel_booking()">Cancel</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-flat" disabled>Submit</button>
                    <button type="button" class="btn btn-warning btn-flat" disabled>Cancel</button>
                }
            </div>
        </div>
    </div>
</div>

