    </div>
</div>


<div class="modal fade" id="modal-schedule-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Old Scheduled List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_schedule_list" class="table">
                        <thead>
                            <tr style="display:none">
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" placeholder="House Code">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:10%">RefNo</th>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:20%">Customer Name</th>
                                <th style="width:15%">Item Code</th>
                                <th style="width:25%">Item Name</th>
                                <th style="width:15%">Last Option</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="get_listloan_forActivity()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<script>
    $(document).ready(function () {
        // Initialize datepicker for any date fields dynamically
        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        // Remove single row by clicking the "X"
        $("#loan_list_body").on("click", ".fa-remove-row, .remove-single-row", function () {
            $(this).closest("tr").remove();
            calculateTotals_for_activity();
        });

        // Check/Uncheck all rows
        window.checkAllRows_for_activity = function (checkbox) {
            $("#loan_list_body input.row_checkbox_for_activity").prop('checked', checkbox.checked);
        };

        // Remove selected rows
        window.removeSelectedRows_for_activity = function () {
            $("#loan_list_body input.row_checkbox_for_activity:checked").each(function () {
                $(this).closest("tr").remove();
            });
            $("#check_all_for_activity").prop('checked', false);
            calculateTotals_for_activity();
        };
    });

    // Toggle Loan/Penalty Table
    function togglePenaltyTable_for_activity() {
        var wrapper = document.getElementById("penalty_table_wrapper");
        var icon = document.getElementById("toggle_penalty_icon");
        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.remove("fa-chevron-down");
            icon.classList.add("fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.remove("fa-chevron-up");
            icon.classList.add("fa-chevron-down");
        }
    }

    // Fetch loan/payment schedule and populate table
    function get_listloan_forActivity() {
        var row = $("#txt_payment_schedule_selected_row").val();
        if (row == -1) {
            ShowAlertCus("No AR Memo selected!", "warning");
            return;
        }

        var docentry = $("#td_pop_payment_schedule_so_entry_" + row).text();
        var serialno = $("#td_pop_payment_schedule_serial_" + row).text();
        var itemname = $("#td_pop_payment_schedule_ocrcode_" + row).text();

        $("#txt_loanID").val(docentry);
        $("#txt_item_name").val(itemname);
        $("#txt_serial").val(serialno);

        $.ajax({
            url: '/sales/get_payment_schedule_by_so_forActivity',
            type: 'POST',
            data: { soEntry: docentry, rowStatus: 'All' },
            datatype: 'json',
            async: false,
            beforeSend: function () { $("#loading").show(); },
            complete: function () { $("#loading").hide(); },
            success: function (data) {
                var mydata = data.data;
                var tbody = $("#loan_list_body");
                tbody.empty();

                function formatDate(dateStr) {
                    if (!dateStr) return "";
                    var d = new Date(dateStr);
                    if (isNaN(d)) return dateStr;
                    var day = d.getDate();
                    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    var month = monthNames[d.getMonth()];
                    var year = d.getFullYear();
                    return day + "-" + month + "-" + year;
                }

                for (var i = 0; i < mydata.length; i++) {
                    var x = mydata[i];
                    var index = i + 1;
                    var trId = "tr_payment_detail_for_activity_" + index;

                    var tr = "<tr id='" + trId + "'>";

                    // Remove icon "X"
                    tr += "<td id='td_remove_" + index + "' style='text-align:center; color:red; cursor:pointer;' class='remove-single-row'>X</td>";

                    // Checkbox
                    tr += "<td id='td_checkbox_" + index + "' style='text-align:center;'><input type='checkbox' class='row_checkbox_for_activity'></td>";

                    // Row number
                    tr += "<td id='td_rowno_" + index + "' style='text-align:center;'>" + index + "</td>";

                    // Payment info with formatted dates
                    tr += "<td id='td_paymentdate_" + index + "' style='text-align:left;'>" + formatDate(x.PaymentDate) + "</td>";
                    tr += "<td id='td_duedate_" + index + "' style='text-align:left;'>" + formatDate(x.DueDate) + "</td>";
                    tr += "<td id='td_principle_" + index + "' style='text-align:right;'>" + convert2digit(x.Principle) + "</td>";
                    tr += "<td id='td_interest_" + index + "' style='text-align:right;'>" + convert2digit(x.Interest) + "</td>";
                    tr += "<td id='td_monthly_" + index + "' style='text-align:right;'>" + convert2digit(x.Monthly) + "</td>";
                    tr += "<td id='td_method_" + index + "' style='text-align:left;'>" + (x.Method || "") + "</td>";
                    tr += "<td id='td_arno_" + index + "' style='text-align:left;'>" + (x.ARNo || "") + "</td>";
                    tr += "<td id='td_arbalance_" + index + "' style='text-align:right;'>" + convert2digit(x.ARBalance) + "</td>";
                    tr += "<td id='td_openbalar_" + index + "' style='text-align:right;'>" + convert2digit(x.OpenBalanceAR) + "</td>";
                    tr += "<td id='td_intno_" + index + "' style='text-align:right;'>" + (x.ARNoInterest || "") + "</td>";
                    tr += "<td id='td_intbalance_" + index + "' style='text-align:right;'>" + convert2digit(x.IntBalance) + "</td>";
                    tr += "<td id='td_openbalint_" + index + "' style='text-align:right;'>" + convert2digit(x.OpenIntBalance) + "</td>";
                    tr += "<td id='td_accrualpenalty_" + index + "' style='text-align:right;'>" + convert2digit(x.AccrualPenalty) + "</td>";

                    // Editable remark
                    tr += "<td id='td_remark_" + index + "' contenteditable='true' style='text-align:left; color:blue;'>" + (x.Remarks || "") + "</td>";

                    tr += "</tr>";

                    tbody.append(tr);
                }

                calculateTotals_for_activity();
                $("#modal-schedule-list").modal('hide');
                $("#txt_payment_schedule_selected_row").val("-1");
            },
            error: function (error) {
                alert('Error while reading data => ' + error);
            }
        });
    }

    // Remove all rows
    function cmd_remove_all_row_payment_schedule() {
        $("#loan_list_body tr").remove();
        $("#check_all_for_activity").prop('checked', false);
        calculateTotals_for_activity();
    }

    // Recalculate totals
    function calculateTotals_for_activity() {
        var totalAR = 0, totalOpenAR = 0, totalInt = 0, totalOpenInt = 0, totalPenalty = 0;

        $("#loan_list_body tr").each(function () {
            totalAR += parseFloat($(this).find("td:eq(10)").text()) || 0;
            totalOpenAR += parseFloat($(this).find("td:eq(11)").text()) || 0;
            totalInt += parseFloat($(this).find("td:eq(13)").text()) || 0;
            totalOpenInt += parseFloat($(this).find("td:eq(14)").text()) || 0;
            totalPenalty += parseFloat($(this).find("td:eq(15)").text()) || 0;
        });

        $("#total_ar_balance").text(totalAR.toFixed(2));
        $("#total_openbalance_ar").text(totalOpenAR.toFixed(2));
        $("#total_int_balance").text(totalInt.toFixed(2));
        $("#total_openint_balance").text(totalOpenInt.toFixed(2));
        $("#total_accrual_penalty").text(totalPenalty.toFixed(2));

        // NEW: Sum Open AR + Open Interest and set to txt_ar_balance
        const totalARCombined = totalOpenAR + totalOpenInt;
        $("#txt_ar_balance").val(totalARCombined.toFixed(2));
    }

    // Utility function to format numbers
    function convert2digit(val) {
        return parseFloat(val || 0).toFixed(2);
    }
</script>
