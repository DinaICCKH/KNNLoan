@using MKL_Web.Models;
@{
    ViewBag.Title = "Interest Wizard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<v_OCRD_Interest> cust = ViewBag.cust;
    List<InstallmentList> installment = ViewBag.installment;

    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
}

<head>
    <script src="../../Scripts/js/sales.js"></script>

    <script>
        $(document).ready(function () {

            // =====================================================
            // ================= SUM CHECKED ROWS ==================
            // =====================================================
            function sum_checked_interestwizard() {

                let sumInterest = 0,
                    sumGenerated = 0,
                    sumRemaining = 0,
                    sumApply = 0,
                    sumNewRemaining = 0;

                $("#table_interestwizard_list tbody tr").each(function () {

                    let rowindex = $(this).attr('id').split("_").pop();

                    if ($("#chk_interest_wizard_line_" + rowindex).is(":checked")) {

                        let interest = parseFloat($("#tr_interestwizard_interestamt_" + rowindex).text()) || 0;
                        let generated = parseFloat($("#tr_interestwizard_generatedamt_" + rowindex).text()) || 0;
                        let remaining = parseFloat($("#tr_interestwizard_remaining_" + rowindex).text()) || 0;
                        let apply = parseFloat($("#applyamt_interest_wizard_line_" + rowindex).val()) || 0;
                        let newRemaining = parseFloat($("#tr_interestwizard_newremaining_" + rowindex).text()) || 0;

                        sumInterest += interest;
                        sumGenerated += generated;
                        sumRemaining += remaining;
                        sumApply += apply;
                        sumNewRemaining += newRemaining;
                    }
                });

                $("#sum_interest_amt").text(sumInterest.toFixed(2));
                $("#sum_generated_amt").text(sumGenerated.toFixed(2));
                $("#sum_remaining").text(sumRemaining.toFixed(2));
                $("#sum_apply_amt").text(sumApply.toFixed(2));
                $("#sum_new_remaining").text(sumNewRemaining.toFixed(2));
            }


            // =====================================================
            // ================= CUSTOMER FILTER ===================
            // =====================================================
            $("#txt_pop_filter_vendor_name").keyup(function () {

                var searchText = $("#txt_pop_filter_vendor_name")
                    .val()
                    .replace(/\s+/g, '')
                    .toLowerCase();

                $("#table_pop_customer_list > tbody > tr").each(function () {

                    var id = $(this).attr('id').replace("tr_pop_customer_", "");

                    var text =
                        $("#td_pop_vendor_cust_code_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_cust_name_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_cust_distnumber_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_cust_baseentry_" + id).text().toLowerCase() +
                        $("#td_pop_vendor_phone_" + id).text().toLowerCase();

                    text = text.replace(/\s+/g, '');

                    if (text.indexOf(searchText) === -1)
                        $(this).hide();
                    else
                        $(this).show();
                });
            });


            // =====================================================
            // ================= CHECK ALL =========================
            // =====================================================
            $(document).on("change", "#chk_interestwizard_select_all", function () {

                var checked = $(this).is(":checked");

                $("input[type=checkbox][id^='chk_interest_wizard_line_']")
                    .prop("checked", checked);

                sum_checked_interestwizard();
            });


            // =====================================================
            // ================= ROW CHECKBOX CHANGE ===============
            // =====================================================
            $(document).on("change", "input[type=checkbox][id^='chk_interest_wizard_line_']", function () {

                var totalRows = $("input[type=checkbox][id^='chk_interest_wizard_line_']").length;
                var checkedRows = $("input[type=checkbox][id^='chk_interest_wizard_line_']:checked").length;

                $("#chk_interestwizard_select_all")
                    .prop("checked", totalRows === checkedRows);

                sum_checked_interestwizard();
            });


            // =====================================================
            // ================= APPLY AMT INPUT ===================
            // =====================================================
            $(document).on("input", ".apply-amt-input", function () {

                let rowindex = $(this).attr("id").split("_").pop();

                let remaining = parseFloat($("#tr_interestwizard_remaining_" + rowindex).text()) || 0;
                let apply = parseFloat($(this).val()) || 0;

                // 🚫 Prevent negative
                if (apply < 0) {
                    apply = 0;
                    $(this).val(0);
                }

                // 🚫 Prevent Apply > Remaining
                if (apply > remaining) {
                    apply = remaining;
                    $(this).val(remaining.toFixed(2));
                }

                let newRemaining = remaining - apply;

                $("#tr_interestwizard_newremaining_" + rowindex)
                    .text(newRemaining.toFixed(2));

                sum_checked_interestwizard();
            });


            // =====================================================
            // ================= LOAN DETAIL POPUP =================
            // =====================================================

            var loanCache = {};

            $(document).on("mouseenter", ".loanid-cell", function (e) {

                var loanId = $(this).data("loanid");
                if (!loanId) return;

                var popup = $("#loan_detail_popup");

                // ✅ Set Title
                $("#loan_popup_header").text("Loan ID : " + loanId);

                // ================= CACHE CHECK =================
                if (loanCache[loanId]) {
                    $("#loan_popup_body").html(loanCache[loanId]);
                    popup.css({
                        top: e.pageY + 10,
                        left: e.pageX + 10
                    }).show();
                    return;
                }

                // ================= AJAX =================
                $.ajax({
                    url: '/sales/GetLoanDetail',
                    type: 'GET',
                    data: { LoanID: loanId },
                    success: function (data) {
                        console.log("Data received for LoanID " + loanId, data);

                        var html = "";

                        if (!data || data.length === 0) {
                            html = "<div style='margin:6px; font-size:12px; color:red;'><b>No AR history yet.</b></div>";
                        } else {
                            for (var i = 0; i < data.length; i++) {
                                html += "<div style='margin-bottom:6px; font-size:12px;'>" +
                                    "<b>AR:</b> " + (data[i].ARNo || "") + "<br/>" +
                                    "<b>Posting:</b> " + (data[i].NewPostingDate || "") + "<br/>" +
                                    "<b>Due:</b> " + (data[i].NewDueDate || "") +
                                    "</div>";
                            }
                        }

                        // Save to cache
                        loanCache[loanId] = html;

                        // Show popup
                        $("#loan_popup_body").html(html);
                        popup.css({
                            top: e.pageY + 10,
                            left: e.pageX + 10
                        }).show();
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);
                        $("#loan_popup_body").html("<div style='margin:6px; font-size:12px; color:red;'><b>Error loading AR data.</b></div>");
                        popup.css({
                            top: e.pageY + 10,
                            left: e.pageX + 10
                        }).show();
                    }
                });

            }).on("mousemove", ".loanid-cell", function (e) {
                // Make popup follow the mouse
                var popup = $("#loan_detail_popup");
                popup.css({
                    top: e.pageY + 10,
                    left: e.pageX + 10
                });
            }).on("mouseleave", ".loanid-cell", function () {
                $("#loan_detail_popup").hide();
            });

        });
    </script>
</head>

<div id="loan_detail_popup"
     style="position:absolute;
            display:none;
            background:#ffffff;
            border:1px solid #ccc;
            padding:0;
            min-width:260px;
            z-index:9999;
            box-shadow:0 4px 10px rgba(0,0,0,0.2);
            border-radius:6px;
            overflow:hidden;">

    <div id="loan_popup_header"
         style="background:#f5f5f5;
                padding:6px 10px;
                font-weight:bold;
                border-bottom:1px solid #ddd;">
    </div>

    <div id="loan_popup_body"
         style="padding:8px 10px;
                font-size:12px;">
    </div>

</div>
<!-- ========================= MODAL CUSTOMER ========================= -->

<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>

            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px; overflow:auto">

                    <table id="table_pop_customer_list" class="table">

                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text"
                                               class="form-control form-control-insde"
                                               id="txt_pop_filter_vendor_name"
                                               placeholder="customer,serial or base Entry">
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Serial</th>
                                <th style="width:10%">BaseEntry</th>
                                <th style="width:15%">Phone</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_distnumber_@rowindex">@x.DistNumber</td>
                                        <td id="td_pop_vendor_cust_baseentry_@rowindex">@x.BaseEntry</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Phone1</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }

                        </tbody>

                    </table>
                </div>
            </div>

            <div class="modal-footer" style="padding:5px;">
                <button type="button"
                        class="btn btn-success btn-flat"
                        onclick="cmd_pop_choose_customer_interest()">
                    Choose
                </button>

                <button type="button"
                        class="btn btn-danger btn-flat"
                        data-dismiss="modal">
                    Cancel
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ========================= MAIN SECTION ========================= -->

<div class="row">

    <!-- Hidden Fields -->
    <input type="hidden" id="txt_module_id" value="Penalty" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" value="-1" />
    <input type="hidden" id="txt_payment_schedule_selected_row" value="-1" />
    <input type="hidden" id="txt_so_entry" value="-1" />
    <input type="hidden" id="txt_so_line" value="-1" />
    <input type="hidden" id="txt_ocrcode" value="-1" />
    <input type="hidden" id="txt_ocrcode2" value="-1" />
    <input type="hidden" id="txt_ocrcode3" value="-1" />
    <input type="hidden" id="txt_cardtype" value="-1" />

        <div class="col-md-12">
            <div class="box box-primary">

                <!-- Header -->
                <div class="box-header with-border">
                    <h5 class="box-title">@ViewBag.Title</h5>
                </div>

                <!-- Filter Section -->
                <div class="box-header with-border">

                    <table class="table" role="none">
                        <thead>
                            <tr>
                                <td colspan="1" style="width:100%;">
                                    <fieldset class="scheduler-border">
                                        <legend class="scheduler-border"
                                                style="width:25%; font-weight:bold;"></legend>

                                        <div class="row" style="margin:0px; margin-top:10px; margin-left:-10px;">

                                            <table class="table" style="margin-bottom:0px;">
                                                <thead>
                                                    <tr>

                                                        <!-- Posting Date -->
                                                        <td style="width:10%;">
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Posting Date
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td style="width:40%;">
                                                            <div class="form-group">

                                                                <table style="width:100%;">
                                                                    <tr>
                                                                        <td style="width:40%;">
                                                                            <div class="input-group date">
                                                                                <div class="input-group-addon">
                                                                                    <i class="fa fa-calendar"></i>
                                                                                </div>
                                                                                <input type="text"
                                                                                       class="form-control pull-right datetime form-control-insde"
                                                                                       readonly
                                                                                       id="txt_posting_date"
                                                                                       value="@docdate">
                                                                            </div>
                                                                        </td>

                                                                        <td style="width:20%; text-align:right; padding-right:10px">
                                                                            Due Date
                                                                        </td>

                                                                        <td style="width:40%;">
                                                                            <div class="input-group date">
                                                                                <div class="input-group-addon">
                                                                                    <i class="fa fa-calendar"></i>
                                                                                </div>
                                                                                <input type="text"
                                                                                       class="form-control pull-right datetime form-control-insde"
                                                                                       readonly
                                                                                       id="txt_due_date"
                                                                                       value="@docdate">
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </table>

                                                            </div>
                                                        </td>

                                                        <!-- Customer -->
                                                        <td style="width:10%;">
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Customer
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td style="width:40%;">
                                                            <div class="input-group">
                                                                <input type="text"
                                                                       class="form-control form-control-insde"
                                                                       id="txt_card_code"
                                                                       readonly
                                                                       placeholder="Customer">

                                                                <div class="input-group-addon">
                                                                    <i class="fa fa-user text-info"
                                                                       onclick="cmd_show_customer_penaltywizard()"
                                                                       style="cursor:pointer"></i>
                                                                </div>
                                                            </div>
                                                        </td>

                                                    </tr>

                                                    <!-- Customer Name + Ref -->
                                                    <tr>
                                                        <td>
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Customer Name
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <input type="text"
                                                                   class="form-control form-control-insde"
                                                                   id="txt_card_name"
                                                                   placeholder="Customer Name" disabled>
                                                        </td>

                                                        <td>
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Ref
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <input type="text"
                                                                   class="form-control form-control-insde"
                                                                   id="txt_ref"
                                                                   placeholder="Ref" disabled>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td style="width:10%;">
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Remark
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td style="width:45%;">
                                                            <input type="text"
                                                                   class="form-control form-control-insde"
                                                                   id="txt_remark"
                                                                   placeholder="Remark"
                                                                   style="width:100%;">
                                                        </td>

                                                        <td style="width:10%;">
                                                            <div class="form-group">
                                                                <label class="form-control controlLabel">
                                                                    Serial
                                                                </label>
                                                            </div>
                                                        </td>

                                                        <td style="width:35%;">
                                                            <input type="text"
                                                                   class="form-control form-control-insde"
                                                                   id="txt_serial"
                                                                   placeholder="Serial"
                                                                   style="width:100%;" disabled>
                                                        </td>
                                                    </tr>

                                                </thead>
                                            </table>

                                        </div>
                                    </fieldset>
                                </td>
                            </tr>

                            <!-- ================= INTEREST LISTING ================= -->

                            <tr>
                                <td colspan="4">

                                    <fieldset class="scheduler-border" style="padding:5px;">
                                        <legend class="scheduler-border" style="font-weight:bold;">
                                            <span style="cursor:pointer;"
                                                  onclick="togglePenaltyTable()">
                                                Interest Listing
                                                <i id="toggle_penalty_icon"
                                                   class="fa fa-chevron-up"
                                                   style="margin-left:5px;"></i>
                                            </span>
                                        </legend>

                                        <div id="penalty_table_wrapper"
                                             class="row"
                                             style="margin:0px; margin-top:10px; position:relative; min-height:60vh; height:100%; overflow:auto">

                                            <table class="table"
                                                   id="table_interestwizard_list"
                                                   style="margin-bottom:0px; position:absolute; min-width:2000px; width:100%;">

                                                <thead style="position:sticky; top:0; z-index:1000;">
                                                    <tr class="bg-gray">
                                                        <td style="width:2%; text-align:center;">#</td>

                                                        <th style="width:1%; text-align:center;">
                                                            <input type="checkbox" id="chk_interestwizard_select_all" />
                                                        </th>
                                                        <td style="width:4%;">BaseEntry</td>
                                                        <td style="width:2%;">LoanID</td>
                                                        <td style="width:4%;">Posting Date</td>
                                                        <td style="width:4%;">Due Date</td>
                                                        <td style="width:5%;">Item Code</td>
                                                        <td style="width:10%;">Item Name</td>
                                                        <td style="width:6%;">Serial</td>
                                                        <td style="width:2%;">Reason</td>
                                                        <td style="width:4%; text-align:right;">Interest Amt</td>
                                                        <td style="width:4%; text-align:right;">Generated Amt</td>
                                                        <td style="width:4%; text-align:right;">Remaining</td>
                                                        <td style="width:4%; text-align:right;">Apply Amt</td>
                                                        <td style="width:4%; text-align:right;">New Remaining</td>
                                                        <td style="width:34%;">Remark</td>
                                                    </tr>
                                                </thead>

                                                <tbody id="interest_body">
                                                </tbody>

                                                <tfoot>
                                                    <tr class="bg-light">
                                                        <td colspan="10" style="text-align:right; font-weight:bold;">Total:</td>
                                                        <td id="sum_interest_amt" style="text-align:right;">0.00</td>
                                                        <td id="sum_generated_amt" style="text-align:right;">0.00</td>
                                                        <td id="sum_remaining" style="text-align:right;">0.00</td>
                                                        <td id="sum_apply_amt" style="text-align:right;">0.00</td>
                                                        <td id="sum_new_remaining" style="text-align:right;">0.00</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>

                                        </div>
                                    </fieldset>

                                </td>
                            </tr>

                        </thead>
                    </table>
                </div>

                <!-- Footer Buttons -->
                <div class="box-footer">

                    <button type="button"
                            style="background-color:green"
                            class="btn btn-info btn-flat"
                            id="btn_generate_penalty_List"
                            onclick="cmd_interestwizard_generate()">
                        Load Interest
                    </button>

                    <button type="button"
                            class="btn btn-primary btn-flat"
                            onclick="cmd_save_interestwizard()">
                        Submit
                    </button>
                </div>

            </div>
        </div>
</div>