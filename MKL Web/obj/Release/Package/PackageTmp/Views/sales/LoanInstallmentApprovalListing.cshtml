@using MKL_Web.Models;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Loan Installment Approval Listing";

    List<ICC_Get_List_Approval_LoanInstallmentResult> applist = ViewBag.Listing;
}


<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>
</head>


<style>

    /* Filter */
    .filter-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .filter-row .form-group {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }


        .filter-row label {
            margin-right: 5px;
            margin-bottom: 0;
            white-space: nowrap;
            font-weight: 600;
        }


    /* Table */

    #table_pr_assignment th {
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }


    #table_pr_assignment td {
        vertical-align: middle;
        white-space: nowrap;
    }


        /* Long text */

        #table_pr_assignment td:nth-child(4),
        #table_pr_assignment td:nth-child(8),
        #table_pr_assignment td:nth-child(9),
        #table_pr_assignment td:nth-child(13) {
            max-width: 250px;
            overflow: hidden;
            text-overflow: ellipsis;
        }
</style>



@using (Html.BeginForm("LoanInstallmentApprovalListing", "sales", FormMethod.Get))
{


    <section class="content-header content-header-title">

        <h5 style="padding-top:10px;">
            @ViewBag.Title
        </h5>

    </section>




    <div class="box box-primary">

        <div class="box-body">


            <div class="filter-row">



                <!-- Status -->
                <div class="form-group">

                    <label>
                        Status
                    </label>


                    @Html.DropDownList("Status",
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Draf", Value = "Draf" },
                        new SelectListItem { Text = "Closed", Value = "Closed" },
                        new SelectListItem { Text = "Reject", Value = "Reject" },
                        new SelectListItem { Text = "Approve", Value = "Approve" }
                    },
                    "All",
                    new
                    {
                        @class = "form-control form-control-sm",
                        style = "width:120px;"
                    })


                </div>




                <!-- From -->

                <div class="form-group">


                    <label>
                        From
                    </label>


                    <div class="input-group date">


                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>


                        <input type="text"
                               id="fdate"
                               name="fdate"
                               value="@Request["fdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:110px;" />


                    </div>


                </div>





                <!-- To -->

                <div class="form-group">


                    <label>
                        To
                    </label>


                    <div class="input-group date">


                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>


                        <input type="text"
                               id="tdate"
                               name="tdate"
                               value="@Request["tdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:110px;" />


                    </div>


                </div>






                <!-- Create By -->

                <div class="form-group">


                    <label>
                        Create By
                    </label>


                    @Html.TextBox("CreateBy",
                    Request["CreateBy"],
                    new
                    {
                        @class = "form-control input-sm",
                        placeholder = "Create By",
                        style = "width:120px;"
                    })


                </div>






                <!-- Item -->

                <div class="form-group">


                    <label>
                        Item
                    </label>


                    @Html.TextBox("Item",
                    Request["Item"],
                    new
                    {
                        @class = "form-control input-sm",
                        placeholder = "Item",
                        style = "width:140px;"
                    })


                </div>







                <!-- Serial -->

                <div class="form-group">


                    <label>
                        Serial
                    </label>


                    @Html.TextBox("Serial",
                    Request["Serial"],
                    new
                    {
                        @class = "form-control input-sm",
                        placeholder = "Serial",
                        style = "width:120px;"
                    })


                </div>







                <!-- Customer -->

                <div class="form-group">


                    <label>
                        Customer
                    </label>


                    @Html.TextBox("Customer",
                    Request["Customer"],
                    new
                    {
                        @class = "form-control input-sm",
                        placeholder = "Customer",
                        style = "width:160px;"
                    })


                </div>





                <!-- Button -->

                <div class="form-group">


                    <button type="submit"
                            class="btn btn-primary btn-sm">

                        <i class="fa fa-search"></i>
                        Search

                    </button>



                    <a href="@Url.Action("LoanInstallmentApprovalListing","sales")"
                       class="btn btn-default btn-sm"
                       style="margin-left:5px;">


                        <i class="fa fa-refresh"></i>
                        Reset


                    </a>


                </div>



            </div>


        </div>

    </div>


}






<div class="row">

    <div class="col-md-12">


        <div class="box box-primary">


            <div class="table-responsive">


                <table id="table_pr_assignment"
                       class="table table-bordered table-hover display nowrap"
                       style="width:100%;table-layout:auto;">



                    <thead>

                        <tr class="bg-gray">

                            <th>No.</th>
                            <th>DocEntry</th>
                            <th>Card Code</th>
                            <th>Card Name</th>
                            <th>Serial</th>
                            <th>Posting Date</th>
                            <th>DocNum Ref</th>
                            <th>Approval Template</th>
                            <th>Next Approver</th>
                            <th>Request Date</th>
                            <th>Request By</th>
                            <th>Status</th>
                            <th>Remark</th>

                        </tr>

                    </thead>



                    <tbody>


                        @{

                            int rowindex = 1;


                            foreach (var x in applist)

                            {

                                <tr>


                                    <td style="text-align:center;">
                                        @rowindex
                                    </td>



                                    <td>

                                        <a href="/sales/PreviewLoanDraf?DocEntry=@x.DocEntry"
                                           style="color:blue;text-decoration:underline;">

                                            @x.DocEntry

                                        </a>

                                    </td>



                                    <td>
                                        @x.CardCode
                                    </td>


                                    <td>
                                        @x.CardName
                                    </td>


                                    <td>
                                        @x.Serial
                                    </td>



                                    <td>
                                        @(x.PostingDate?.ToString("dd-MMM-yyyy") ?? "-")
                                    </td>



                                    <td>
                                        @x.DocNumRef
                                    </td>



                                    <td>
                                        @x.TemplateDesc
                                    </td>



                                    <td>
                                        @x.NextApprover
                                    </td>



                                    <td>
                                        @(x.CreateDate?.ToString("dd-MMM-yyyy") ?? "-")
                                    </td>



                                    <td>
                                        @x.CreateBy
                                    </td>



                                    <td>
                                        @x.Status
                                    </td>



                                    <td>
                                        @x.Remark
                                    </td>


                                </tr>


                                rowindex++;

                            }

                        }


                    </tbody>



                </table>


            </div>


        </div>


    </div>

</div>






<script>


    $(document).ready(function () {


        $('.datetime').datepicker({

            autoclose: true,
            format: 'dd-M-yyyy'

        });





        $('#table_pr_assignment').DataTable({


            scrollX: true,


            fixedHeader: true,


            paging: true,


            searching: true,


            autoWidth: true,


            responsive: false,


            pageLength: 50,



            dom: 'Bfrtip',



            buttons: [

                'copy',
                'excel',
                'print'

            ],




            columnDefs: [

                {
                    targets: 0,
                    width: "40px",
                    className: "dt-head-center"
                },

                {
                    targets: 3,
                    width: "250px"
                },

                {
                    targets: 12,
                    width: "200px"
                }

            ],




            language: {


                search: "Search records:",

                lengthMenu: "Display _MENU_ records per page",

                zeroRecords: "No matching records found",

                info: "Showing _START_ to _END_ of _TOTAL_ records",

                infoEmpty: "No records available",

                infoFiltered: "(filtered from _MAX_ total records)"


            }


        });



    });

</script>