@using MKL_Web.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Activity Details";
    var activities = Model as List<ICC_GET_ActivitybyIDResult>; // cast Model to list
}

<head>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/DataTables/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/Content/buttons.bootstrap4.min.css" />
    <script src="~/Scripts/js/sales.js"></script>
</head>

<section class="content-header content-header-title">
    <h5 style="padding-top:10px !important; padding-left:0px !important;">@ViewBag.Title</h5>
</section>

<!-- Global Search -->
<div class="form-group mb-3">
    <input type="text" id="globalSearch" class="form-control form-control-sm" style="width:100%;" placeholder="Search all columns...">
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-body table-responsive p-0" style="overflow-x:auto;">

                <table id="table_activity_list" class="table table-striped table-bordered display nowrap" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>No.</th>
                            <th>HeaderID</th>
                            <th>Activity</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Recurrence</th>
                            <th>Activity Remark</th>
                            <th>Customer Response</th>
                            <th>Next Action</th>
                            <th>Content</th>
                            <th>CustomerCode</th>
                            <th>CardName</th>
                            <th>Phone</th>
                            <th>Ref</th>
                            <th>LoanID</th>
                            <th>Item Name</th>
                            <th>Serial</th>
                            <th>Total AR Balance</th>
                            <th>AssignedBy</th>
                            <th>HandledBy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            if (activities != null && activities.Any())
                            {
                                foreach (var header in activities)
                                {
                                                <tr id="tr_@rowindex">
                                                    <td style="text-align:center;">@rowindex</td>
                                                    <td style="cursor:pointer;color:blue;text-decoration:underline;">
                                                        <a href="/sales/EditActivity?headerID=@header.HeaderID">
                                                            @header.HeaderID
                                                        </a>
                                                    </td>

                                                    <td>@header.Activity</td>
                                                    <td>@header.Type</td>
                                                    <td>@header.Priority</td>
                                                    <td>@header.Status</td>
                                                    <td>@(header.StartDate?.ToString("dd-MMM-yyyy") ?? "")</td>
                                                    <td>@(header.EndDate?.ToString("dd-MMM-yyyy") ?? "")</td>
                                                    <td>@header.Recurrence</td>
                                                    <td>@header.ActivityRemark</td>
                                                    <td>@header.CustomerResponse</td>
                                                    <td>@header.NextAction</td>
                                                    <td>@header.Content</td>
                                                    <td>@header.CustomerCode</td>
                                                    <td>@header.CardName</td>
                                                    <td>@header.Phone</td>
                                                    <td>@header.Ref</td>
                                                    <td>@header.LoanID</td>
                                                    <td>@header.ItemName</td>
                                                    <td>@header.Serial</td>
                                                    <td style="text-align:right;">@string.Format("{0:N2}", header.TotalARBalance)</td>
                                                    <td>@header.AssignedBy</td>
                                                    <td>@header.HandledBy</td>
                                                </tr>
                                    rowindex++;
                                }
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        // Initialize DataTable
        var table = $('#table_activity_list').DataTable({
            scrollX: true,
            fixedHeader: true,
            paging: true,
            searching: false,
            autoWidth: false,
            pageLength: 25,
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'print'],
            columnDefs: [
                { targets: '_all', className: 'dt-head-center' }
            ]
        });

        // Global search
        $('#globalSearch').on('keyup', function () {
            table.search(this.value).draw();
        });

    });
</script>