<script>

    $(document).ready(function () {


        document.getElementById('approval-link').addEventListener('click', function (event) {
            event.preventDefault(); // Prevents the link from navigating
            alert('Coming Soon!');
        });

        $("#toggleSidebar").click(function () {
            $("body").toggleClass("sidebar-hidden");
            updateLogo(); // update logo when toggled
        });

        // -----------------------------
        // Update logo based on sidebar state
        // -----------------------------
        function updateLogo() {
            if ($('body').hasClass('sidebar-hidden')) {
                $('.logo-mini').show();
                $('.logo-lg').hide();
            } else {
                $('.logo-mini').hide();
                $('.logo-lg').show();
            }
        }

        // Run on page load
        updateLogo();

        // Listen to AdminLTE sidebar events
        document.body.addEventListener('collapsed.pushMenu', updateLogo);
        document.body.addEventListener('expanded.pushMenu', updateLogo);

        // Initialize datepicker on elements with class 'datetime'
        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        // Load UOM group data if table is empty
        if ($("#table_uom_group > tbody > tr").length === 0) {
            get_uom_group();
        }

        // Check if user session is valid
        checkUser();

    });

</script>