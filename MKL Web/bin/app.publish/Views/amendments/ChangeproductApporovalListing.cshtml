@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Change Product Approval List";
    List<ICC_Get_List_Approval_ChangeItemResult> applist = ViewBag.Listing;
}

<style>
    .truncate {
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }
</style>

<head>
    <title>@ViewBag.Title</title>
</head>

<section class="content-header content-header-title">
    <h5 style="padding-top:10px;">@ViewBag.Title</h5>
</section>

@using (Html.BeginForm("ChangeproductApporovalListing", "amendments", FormMethod.Get))
{
    <div class="box box-primary">
        <div class="box-body">
            <div class="form-inline" style="display:flex;align-items:center;gap:10px;flex-wrap:nowrap;overflow-x:auto;">

                <div class="form-group">
                    <label>Status</label>
                    @Html.DropDownList("Status",
                    new List<SelectListItem>
                    {
                        new SelectListItem{Text="All",Value=""},
                        new SelectListItem{Text="Draf",Value="Draf"},
                        new SelectListItem{Text="Closed",Value="Closed"},
                        new SelectListItem{Text="Reject",Value="Reject"},
                        new SelectListItem{Text="Approve",Value="Approve"}
                    },
                    new { @class = "form-control input-sm", style = "width:120px;" })
                </div>

                <div class="form-group">
                    <label style="margin-left:10px;">From</label>
                    <div class="input-group date">
                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                        <input type="text" id="fdate" name="fdate" value="@Request["fdate"]" class="form-control datetime" readonly style="width:110px;" />
                    </div>
                </div>

                <div class="form-group">
                    <label style="margin-left:10px;">To</label>
                    <div class="input-group date">
                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                        <input type="text" id="tdate" name="tdate" value="@Request["tdate"]" class="form-control datetime" readonly style="width:110px;" />
                    </div>
                </div>

                <div class="form-group">
                    <label style="margin-left:10px;">Create By</label>
                    @Html.TextBox("CreateBy", Request["CreateBy"], new { @class = "form-control input-sm", placeholder = "Create By", style = "width:140px;" })
                </div>

                <div class="form-group">
                    <label style="margin-left:10px;">Serial</label>
                    @Html.TextBox("Serial", Request["Serial"], new { @class = "form-control input-sm", placeholder = "Serial", style = "width:130px;" })
                </div>

                <div class="form-group">
                    <label style="margin-left:10px;">Customer</label>
                    @Html.TextBox("Customer", Request["Customer"], new { @class = "form-control input-sm", placeholder = "Customer", style = "width:160px;" })
                </div>

                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-search"></i> Search
                </button>

                <a href="@Url.Action("ChangeproductApporovalListing","amendments")" class="btn btn-default btn-sm">
                    <i class="fa fa-refresh"></i> Reset
                </a>

            </div>
        </div>
    </div>
}


<div class="box box-primary">
    <div class="box-body">
        <div class="table-responsive">

            <table id="table_pr_assignment" class="table table-bordered table-hover nowrap" style="width:100%">

                <thead>
                    <tr class="bg-gray">
                        <th>No</th>
                        <th>DocEntry</th>
                        <th>Card Code</th>
                        <th>Card Name</th>
                        <th>Posting Date</th>
                        <th>DocNum Ref</th>
                        <th>Old Serial</th>
                        <th>New Serial</th>
                        <th>Approval Template</th>
                        <th>Next Approver</th>
                        <th>Request Date</th>
                        <th>Request By</th>
                        <th>Status</th>
                        <th>Remark</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int rowindex = 1;
                        foreach (var x in applist)
                        {
                                        <tr>
                                            <td style="text-align:center;">@rowindex</td>

                                            <td>
                                                <a href="/amendments/PreviewChangeItem?DocEntry=@x.DocEntry" style="color:blue;text-decoration:underline;">
                                                    @x.DocEntry
                                                </a>
                                            </td>
                                            <td>@x.CardCode</td>
                                            <td>@x.CardName</td>
                                            <td>@(x.PostingDate?.ToString("dd-MMM-yyyy") ?? "")</td>
                                            <td>@x.DocNumRef</td>
                                            <td>@x.OldSerial</td>
                                            <td>@x.NewSerial</td>
                                            <td>@x.TemplateDesc</td>
                                            <td>@x.NextApprover</td>
                                            <td>@(x.CreateDate?.ToString("dd-MMM-yyyy") ?? "")</td>
                                            <td>@x.CreateBy</td>
                                            <td>@x.Status</td>

                                            <td class="truncate" title="@x.Remark">
                                                @(x.Remark != null && x.Remark.Length > 20 ? x.Remark.Substring(0,20)+"..." : x.Remark)
                                            </td>

                                        </tr>
                            rowindex++;
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>


<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({
            scrollX: true,
            fixedHeader: true,
            autoWidth: false,
            pageLength: 50,
            order: [[1, 'desc']],
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'print'],
            language: {
                search: "Search :",
                lengthMenu: "Show _MENU_ Rows",
                info: "Showing _START_ to _END_ of _TOTAL_ Rows",
                zeroRecords: "No matching records found"
            }
        });

    });
</script>