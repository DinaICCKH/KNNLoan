@using MKL_Web.Models;
@{
    ViewBag.Title = "Change Owner";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string docdate = DateTime.Now.ToString("dd-MM-yyyy");

    List<ICC_Get_List_Approval_ChangeOwnerDraf_By_IDResult> HeaderChangeOwner = ViewBag.HeaderChangeOwner;
    List<ICC_Approval_Check_EnableButtonResult> Checkbutton = ViewBag.Checkbutton;
    
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script>
        $(document).ready(function () {

            var checkbutton = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Checkbutton.FirstOrDefault()));
            var checkbuttonstatus = checkbutton?.Approver ?? "N";
            console.log("checkbuttonstatus:", checkbuttonstatus);

            if (checkbuttonstatus.toUpperCase() === 'Y') {
                console.log("Showing buttons");
                $('#btnReject').show();
                $('#btnApprove').show();
            } else {
                console.log("Hiding buttons");
                $('#btnReject').hide();
                $('#btnApprove').hide();
            }
        });
    </script>
</head>

<div class="row">
    @{
        var header = HeaderChangeOwner?.FirstOrDefault();
        var drafID = header?.ID ?? -1;
        var OldCardCode = header?.OldCustomerCode ?? "";
        var OldCardName = header?.OldCustomerName ?? "";
        var oldPhone = header?.OldPhone ?? "";

        var NewCardCode = header?.NewCustomerCode ?? "";
        var NewCardName = header?.NewCustomerName ?? "";
        var NewPhone = header?.NewPhone ?? "";

        var ItemCode = header?.ItemCode ?? "";
        var ItemName = header?.ItemName ?? "";
        var SerialNo = header?.SerialNo ?? "";

        var DocEntry = header?.DocEntry ?? -1;
        var DocTotalBef = header?.DocTotalBef ?? 0;
        var DocDate = header?.DocDate?.ToString("dd-MM-yyyy") ?? "";
        var CreateDate = header?.CreateDate?.ToString("dd-MM-yyyy") ?? "";
        var CreateBy = header?.CreateBy ?? "";
        var AppTemplate = header?.AppTemplate ?? "";
        var Remark = header?.Remark ?? "";
        var AppStatus = header?.Status ?? "";

    }

    <input type="hidden" id="txt_drafID" value="@drafID" />
    <input type="hidden" id="txt_module_id" value="ChangeOwner" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" value="-1" />
    <input type="hidden" id="txt_payment_schedule_selected_row" value="-1" />
    <input type="hidden" id="txt_so_entry" value="-1" />
    <input type="hidden" id="txt_so_line" value="-1" />
    <input type="hidden" id="txt_ocrcode" value="-1" />
    <input type="hidden" id="txt_ocrcode2" value="-1" />
    <input type="hidden" id="txt_ocrcode3" value="-1" />
    <input type="hidden" id="txt_cardtype" value="-1" />

    <table id="tbl_Remove_List" style="display:none;">
        <thead>
            <tr>
                <td>HeaderLine</td>
                <td>DetailLine</td>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">
                    @ViewBag.Title
                    <span class="app-status-highlight">@AppStatus</span>
                </h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td colspan="2">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Old Customer Informatin</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_card_code" readonly="readonly" placeholder="Customer Code" value="@OldCardCode" />

                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_card_name" readonly="readonly" placeholder="Customer Name" value="@OldCardName" onchange="txt_po_vendor_name_change()" onkeydown='txtautocompletepo()'>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Phone</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_phone" readonly="readonly" placeholder="phnone number" value="@oldPhone">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr style="visibility:hidden">
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Contact</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_contact_person"></select>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                            <td colspan="2">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">New Customer Informatin</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_new_card_code" readonly="readonly" value="@NewCardCode" placeholder="Customer Code">

                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_new_card_name" readonly="readonly" placeholder="Customer Name" value="@NewCardName" onchange="txt_po_vendor_name_change()" onkeydown='txtautocompletepo()'>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Phone</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_new_phone" readonly="readonly" placeholder="Phone" value="@NewPhone">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr style="visibility:hidden">
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Contact</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_new_contact_person"></select>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Item Information</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Item Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" value="@ItemCode" readonly="readonly" id="txt_item_code" placeholder="Item Description">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Description</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" value="@ItemName" readonly="readonly" id="txt_item_name" placeholder="Item Description">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">AR Amt</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" value="@DocTotalBef" readonly="readonly" id="txt_after_discount" placeholder="AR Amt">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Start Payment</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <table style="width:100%;" id="table_doc_discount">
                                                                <tr>
                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text" class="form-control pull-right datetime form-control-insde" disabled readonly="readonly" id="txt_start_payment" placeholder="Start Payment" value="@DocDate">
                                                                        </div>
                                                                    </td>

                                                                    <td style="width:10%;">
                                                                        <div class="form-group">
                                                                            <label for="inputEmail3" class="form-control controlLabel">Ref No</label>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:40%;">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" value="@DocEntry" readonly="readonly" id="txt_docentry">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Serial Number</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" value="@SerialNo" id="txt_after_serial" placeholder="Serial No">
                                                        </div>
                                                    </td>

                                                </tr>

                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border" style="color:red">Approval Decision</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Requester</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" value="@CreateBy" id="txt_requester_name" placeholder="Requester">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Approval Template</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" value="@AppTemplate" id="txt_app_template" placeholder="Approval Template">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width: 10%; visibility: hidden">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">AR Amt</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%; visibility:hidden">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_after_discount" placeholder="AR Amt" value="0.00">
                                                        </div>
                                                    </td>
                                                    <td style="width: 10%; ">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Request Date</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <table style="width:100%;" id="table_doc_discount">
                                                                <tr>
                                                                    <td style="width:40%;">
                                                                        <div class="input-group date">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa fa-calendar"></i>
                                                                            </div>
                                                                            <input type="text" class="form-control pull-right datetime form-control-insde" disabled readonly="readonly" id="txt_start_payment" placeholder="Request Date" value="@CreateDate">
                                                                        </div>
                                                                    </td>

                                                                    <td style="width:10%;">
                                                                        <div class="form-group">
                                                                            <label for="inputEmail3" class="form-control controlLabel">Draf ID</label>
                                                                        </div>
                                                                    </td>
                                                                    <td style="width:40%;">
                                                                        <div class="form-group">
                                                                            <input type="text" class="form-control form-control-insde" value="@drafID" readonly="readonly" id="txt_draf_ID">
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Requester Comment</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <textarea class="form-control form-control-insde" id="txt_draf_ID" readonly rows="3">@Remark</textarea>
                                                        </div>
                                                    </td>

                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Approver Comment</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <textarea class="form-control form-control-insde" id="txt_approverComment" placeholder="Approver Comment" rows="3" style="resize: vertical;"></textarea>
                                                        </div>
                                                    </td>

                                                </tr>

                                            </thead>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button id="btnReject" type="button" class="btn btn-primary btn-flat"
                        style="background-color:red; border-color:red;"
                        onclick="cmd_save_approval_changeowner('Reject')">
                    Reject
                </button>

                <button id="btnApprove" type="button" class="btn btn-primary btn-flat"
                        onclick="cmd_save_approval_changeowner('Approve')">
                    Approve
                </button>
            </div>

        </div>
    </div>
</div>

