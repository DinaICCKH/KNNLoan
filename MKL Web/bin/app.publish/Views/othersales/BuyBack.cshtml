            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-info pull-left btn-flat" onclick="cmd_pop_special_payment_add_row()">Add Row</button>
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_payment_generate()">Generate</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
