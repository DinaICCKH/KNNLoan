    <script src="../../Content//dist/js/demo.js"></script>
    <!-- Bootstrap 5 -->
    <link href="~/Content/Font1.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="~/Content/Font2.css" rel="stylesheet" />
     @*Google Font*@ 
    <link href="~/Content/Font3.css" rel="stylesheet" />


    <script>
        $(document).ready(function () {
            $("#cmdlogin").click(function () {
                $.ajax({
                    url: '/log/login',
                    type: 'POST',
                    data: { userid: $("#txtuserid").val(), pwd: $("#txtpassword").val() },
                    datatype: 'json',
                    ContentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        if (data.status == "OK") {
                            var baseUrl = "@Url.Action("welcome", "admin")?id=" + $("#txtuserid").val();
                            window.location.href=baseUrl;
                        }
                        else {
                            alert("Invalid User or Password");
                        }
                    },
                    error: function (error) {
                        alert('Error while saving data => ' + error);
                    }
                });
            });
        });
    </script>

    <style>

        .h1, .h2, .h3, .h4, .h5, .h6, h1, h2, h3, h4, h5, h6 {
            margin-top: 0px;
            font-size: 2.75rem;
        }
        body {
            background-color: #dddddd;
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
        }

        .login-box {
            max-width: 400px;
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }
    </style>
</head>


<body class="d-flex justify-content-center align-items-center vh-100">
    <div class="login-box text-center">
        <img src="~/Photo/logo.png" alt="Logo" class="mb-3" style="max-width: 100px;">
        <h3 class="mb-3">Loan Application</h3>
        <form method="post">
            <div class="mb-3" style="font-size:15px !important">
                <input type="text" class="form-control" placeholder="User ID" id="txtuserid" style="font-size:15px !important">
            </div>
            <div class="mb-3" style="font-size:15px !important">
                <input type="password" class="form-control" placeholder="Password" id="txtpassword" style="font-size:15px !important">
            </div>
            <button type="button" class="btn btn-primary w-100" id="cmdlogin" style="font-size:15px !important">Log In</button>
        </form>
    </div>
</body>
</html>
