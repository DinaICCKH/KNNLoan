@using MKL_Web.Models;
@{
    ViewBag.Title = "View BP";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_Vendor> ocrd = ViewBag.vender;
}
<head>
    <title>@ViewBag.Title</title>
</head>

<div class="row">
    <section class="content-header content-header-title">
        <h1>@ViewBag.Title</h1>
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment" class="table table-bordered table-hover dataTable no-footer">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" style="width: 10%">BP Code</th>
                            <th class="sorting_disabled" style="width: 10%">EN Name</th>
                            <th class="sorting_disabled" style="width: 10%">KH Name</th>
                            <th class="sorting_disabled" style="width: 10%">Type</th>
                            <th class="sorting_disabled" style="width: 10%">Group</th>
                            <th class="sorting_disabled" style="width: 10%">Tel 1</th>
                            <th class="sorting_disabled" style="width: 10%">Gender</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            string cardtype = "";
                            foreach (var x in ocrd)
                            {
                                cardtype = "Customer";
                                if (x.CardType != "C")
                                {
                                    cardtype = "Lead";
                                }
                                                <tr id="tr_@rowindex">

                                                    <td>@x.CardCode</td>
                                                    <td>@x.CardName</td>
                                                    <td>@x.FrgnName</td>
                                                    <td>@cardtype</td>
                                                    <td>@x.GroupName</td>
                                                    <td>@x.Tel1</td>
                                                    <td>@(x.Gender == "M" ? "Male" : "Female")</td>
                                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>