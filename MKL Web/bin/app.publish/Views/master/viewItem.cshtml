@using MKL_Web.Models;
@{
    ViewBag.Title = "View Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_Item> oitm = ViewBag.Item;
}
<head>
    <title>@ViewBag.Title</title>
</head>

<div class="row">
    <section class="content-header content-header-title">
        <h1>@ViewBag.Title</h1>
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment" class="table table-bordered table-hover dataTable no-footer">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" style="width: 10%">Item Code</th>
                            <th class="sorting_disabled" style="width: 20%">Item Name</th>
                            <th class="sorting_disabled" style="width: 20%">KH Name</th>
                            <th class="sorting_disabled" style="width: 15%">Item Type</th>
                            <th class="sorting_disabled" style="width: 20%">Group Name</th>
                            <th class="sorting_disabled" style="width: 15%">Brand</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            foreach (var x in oitm)
                            {
                                <tr id="tr_@rowindex">
                                    <td>
                                        @x.ItemCode
                                    </td>
                                    <td>@x.ItemName</td>
                                    <td>@x.FrgnName</td>
                                    <td>@x.U_Type</td>
                                    <td>@x.ItmsGrpNam</td>
                                    <td>@x.ItemBrandName</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>