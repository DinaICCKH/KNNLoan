
@using MKL_Web.Models;
@{
    ViewBag.Title = "Add BP";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_Province> province = ViewBag.province;
    List<v_InforSource> infosource = ViewBag.infosource;
    List<v_PaymentTerm> term = ViewBag.term;
    List<v_PriceList> pricelist = ViewBag.pricelist;
    List<v_Currency> cur = ViewBag.cur;
    //List<v_BPGroup> bpgroup = ViewBag.bpgroup;
    List<v_Relationship> relation = ViewBag.relation;
    //List<v_DepBPGroup> depBpGroup = ViewBag.depBpGroup;
    USR u = (USR)Session["USR"];
    int depcode = 0;
    if (u != null)
    {
        depcode = (int)u.DepCode;
    }
}
<head>
    <script src="../../Scripts/js/Vendor.js"></script>
</head>
<div class="row">
    <select id="cbo_province_list" style="display:none">
        @{
            <option value=""></option>
            foreach (var x in province)
            {
                <option value="@x.Code">@x.Name</option>
            }
        }
    </select>
    <select id="cbo_relationship" style="display:none">
        @{
            foreach (var x in relation)
            {
                <option value="@x.Code">@x.Name</option>
            }
        }
    </select>

    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">BP Code(*)</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <table style="width:100%">
                                        <tr>
                                            <td style="width:50%"><input type="text" class="form-control form-control-insde" id="txt_bp_code" readonly="readonly" placeholder="BP Code"></td>
                                            <td style="width:50%">
                                                <select class="form-control form-control-insde" id="cbo_bp_type"  onchange="cbo_bp_group_change()">
                                                    <option value="C">Customer</option>
                                                    <option value="L">Lead</option>
                                                </select>
                                            </td>
                                        </tr>
                                    </table>
                                    
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">EN Name(*)</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_bp_en_name" placeholder="BP Name">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Group(*)</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <select class="form-control form-control-insde" id="cbo_bp_group" onchange="cbo_bp_group_change()">
                                        <option value=""></option>
                                        @{
                                            foreach (var x in depBpGroup)
                                            {
                                                <option value="@x.GroupCode">@x.GroupName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </td>
                            <td style="width:12%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">KH Name</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_bp_kh_name" placeholder="Foreign Name">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Currency(*)</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <select class="form-control form-control-insde" id="cbo_currency">
                                        @{
                                            foreach (var x in cur)
                                            {
                                                if (x.CurrCode == "US$")
                                                {
                                                    <option value="@x.CurrCode" selected="selected">@x.CurrName</option>
                                                }
                                                else
                                                {
                                                    <option value="@x.CurrCode">@x.CurrName</option>
                                                }
                                            }
                                        }
                                        <option value="*">All</option>
                                    </select>
                                </div>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab_1" data-toggle="tab" aria-expanded="true">General</a></li>
                    <li class=""><a href="#tab_2" data-toggle="tab" aria-expanded="false">Contact</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_1">
                        <table class="table" role="none">
                            <thead>
                                <tr>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Tel 1(*)</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-insde" placeholder="Tel 1" id="txt_tel1">
                                        </div>
                                    </td>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Tel 2</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-insde" placeholder="Tel 2" id="txt_tel2">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">E-Mail</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-insde" id="txt_mail" placeholder="E-Mail">
                                        </div>
                                    </td>
                                    <td style="width:12%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">ID No.</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-insde" id="txt_id" placeholder="ID No.">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Gender</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <select class="form-control form-control-insde" id="cbo_gender">
                                                <option value="Male">Male</option>
                                                <option value="Femal">Femal</option>
                                            </select>
                                        </div>
                                    </td>
                                    <td style="width:12%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Date of Birth</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <div class="input-group date">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                                <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" placeholder="Date of Birth" id="txt_dbo">
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Source</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <select class="form-control form-control-insde" id="cbo_source" name="whs">
                                                <option value=""></option>
                                                @{
                                                    foreach (var x in infosource)
                                                    {
                                                        <option value="@x.Code">@x.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </td>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Price List</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <select class="form-control form-control-insde" id="cbo_price_list">
                                                <option value=""></option>
                                                @{
                                                    foreach (var x in pricelist)
                                                    {
                                                        <option value="@x.ListNum">@x.ListName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Payment Terms</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <select class="form-control form-control-insde" id="cbo_payment_term">
                                                <option value=""></option>
                                                @{
                                                    foreach (var x in term)
                                                    {
                                                        <option value="@x.GroupNum">@x.PymntGroup</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </td>
                                    <td style="width:10%;">
                                        <div class="form-group">
                                            <label for="inputEmail3" class="form-control controlLabel">Credit Limit</label>
                                        </div>
                                    </td>
                                    <td style="width:40%;">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-insde" id="txt_credit_limit" placeholder="Credit Limit" value="0.00">
                                        </div>
                                    </td>
                                </tr>
                            </thead>
                        </table>
                        <table class="table" role="none" id="table_province">
                            <thead>
                                <tr class="bg-gray" role="row">
                                    <td style="width:1%"></td>
                                    <td style="width:1%">#</td>
                                    <td style="width:15%">Type</td>
                                    <td style="width:10%">Province/City</td>
                                    <td style="width:10%">Srok/Khan</td>
                                    <td style="width:10%">Khum/Sangkat</td>
                                    <td style="width:15%">Address EN</td>
                                    <td style="width:15%">Address KH</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr tr id="tr_address_1">
                                    <td></td>
                                    <td>1</td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_add_type_1">
                                            <option value="B">Bill To</option>
                                            <option value="S">Ship To</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_province_1" onchange="get_district_by_province_change(1)">
                                            <option value=""></option>
                                            @{
                                                foreach (var x in province)
                                                {
                                                    <option value="@x.Code">@x.Name</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_district_1" onchange="get_commune_by_district_change(1)"></select>
                                    </td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_commune_1" onchange="get_address_change(1)"></select>
                                    </td>
                                    <td><input type='text' class='form-control noborder' id="txt_address_en_1" placeholder='Address EN'></td>
                                    <td><input type='text' class='form-control noborder' id="txt_address_kh_1" placeholder='Address KH'></td>
                                    <td style="display:none" id="td_postal_1"></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                    <!-- /.tab-pane -->
                    <div class="tab-pane" id="tab_2">
                        <table class="table" role="none" id="table_contact_person">
                            <thead>
                                <tr class="bg-gray" role="row">
                                    <td></td>
                                    <td style="width:1%">#</td>
                                    <td style="width:10%">EN Name</td>
                                    <td style="width:10%">KH Name</td>
                                    <td style="width:6%">Gender</td>
                                    <td style="width:6%">ID</td>
                                    <td style="width:6%">Relationship</td>
                                    <td style="width:10%">Address</td>
                                    <td style="width:6%">Tel 1</td>
                                    <td style="width:8%">Tel 2</td>
                                    <td style="width:8%">E-Mail</td>
                                    <td style="width:8%">Telegram</td>
                                    <td style="width:8%">Facebook</td>
                                    <td style="width:8%">WhatsApp</td>
                                    <td style="width:8%">Line</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr tr id="tr_contact_1">
                                    <td></td>
                                    <td>1</td>
                                    <td><input type='text' class='form-control noborder' placeholder='EN Name' id="txt_contact_enname_1" onchange="txt_contact_enname_change(1)"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='KH Name' id="txt_contact_khname_1"></td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_contact_gender_1">
                                            <option value="Male">Male</option>
                                            <option value="Female">Femal</option>
                                        </select>
                                    </td>
                                    <td><input type='text' class='form-control noborder' placeholder='ID/Passport' id="txt_contact_id_1"></td>
                                    <td>
                                        <select class="form-control form-control-insde" id="cbo_contact_relationship_1">
                                            <option value=""></option>
                                            @{
                                                foreach (var x in relation)
                                                {
                                                    <option value="@x.Code">@x.Name</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td><input type='text' class='form-control noborder' placeholder='Address' id="txt_contact_address_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='Tel 1' id="txt_contact_tel1_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='Tel 2' id="txt_contact_tel2_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='E-Mail' id="txt_contact_mail_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='Telegram' id="txt_contact_telegram_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='Facebook' id="txt_contact_facebook_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='WhatsApp' id="txt_contact_whatapp_1"></td>
                                    <td><input type='text' class='form-control noborder' placeholder='Line' id="txt_contact_line_1"></td>
                                    <td style="display:none" id="td_contact_code_1">-1</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- /.tab-content -->
            </div>
            <div class="box-footer">
                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_bp()">Submit</button>
                <button type="button" class="btn btn-warning btn-flat">Cancel</button>
            </div>
        </div>
    </div>
</div>
