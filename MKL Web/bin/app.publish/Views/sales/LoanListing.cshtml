@using MKL_Web.Models;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Loan Listing";

    List<ICC_Get_List_LoanResult> applist = ViewBag.ChangeOwnerApporovalListing;
}

<style>
    .truncate {
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }
</style>


<head>
    <title>@ViewBag.Title</title>
</head>


<section class="content-header content-header-title">
    <h5 style="padding-top:10px;">
        @ViewBag.Title
    </h5>
</section>



@using (Html.BeginForm("LoanListing", "Sales", FormMethod.Get))
{
    <div class="box box-primary">

        <div class="box-body">

            <div class="form-inline"
                 style="display:flex;align-items:center;gap:10px;flex-wrap:nowrap;overflow-x:auto;">



                <!-- From Date -->
                <div class="form-group">

                    <label style="margin-right:5px;">
                        From
                    </label>

                    <div class="input-group date">

                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>


                        <input type="text"
                               id="fdate"
                               name="fdate"
                               value="@Request["fdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:110px;" />

                    </div>

                </div>



                <!-- To Date -->
                <div class="form-group">

                    <label style="margin-left:10px;margin-right:5px;">
                        To
                    </label>


                    <div class="input-group date">

                        <span class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </span>


                        <input type="text"
                               id="tdate"
                               name="tdate"
                               value="@Request["tdate"]"
                               class="form-control datetime"
                               readonly
                               style="width:110px;" />

                    </div>

                </div>




                <!-- Item -->
                <div class="form-group">

                    <label style="margin-left:10px;margin-right:5px;">
                        Item
                    </label>


                    @Html.TextBox("Item",
                        Request["Item"],
                        new
                        {
                            @class = "form-control input-sm",
                            placeholder = "Item",
                            style = "width:140px;"
                        })

                </div>




                <!-- Serial -->
                <div class="form-group">

                    <label style="margin-left:10px;margin-right:5px;">
                        Serial
                    </label>


                    @Html.TextBox("Serial",
                        Request["Serial"],
                        new
                        {
                            @class = "form-control input-sm",
                            placeholder = "Serial",
                            style = "width:120px;"
                        })

                </div>




                <!-- Customer -->
                <div class="form-group">

                    <label style="margin-left:10px;margin-right:5px;">
                        Customer
                    </label>


                    @Html.TextBox("Customer",
                        Request["Customer"],
                        new
                        {
                            @class = "form-control input-sm",
                            placeholder = "Customer",
                            style = "width:160px;"
                        })

                </div>




                <!-- Search -->
                <button type="submit"
                        class="btn btn-primary btn-sm"
                        style="margin-left:10px;">

                    <i class="fa fa-search"></i>
                    Search

                </button>




                <!-- Reset -->
                <a href="@Url.Action("LoanListing","Sales")"
                   class="btn btn-default btn-sm">

                    <i class="fa fa-refresh"></i>
                    Reset

                </a>


            </div>

        </div>

    </div>
}






<div class="box box-primary">

    <div class="box-body">


        <div class="table-responsive">


            <table id="table_pr_assignment"
                   class="table table-bordered table-hover nowrap"
                   style="width:100%">


                <thead>

                    <tr class="bg-gray">

                        <th style="width:3%">
                            No
                        </th>

                        <th>
                            DocNo
                        </th>

                        <th>
                            Doc Date
                        </th>

                        <th>
                            Card Code
                        </th>

                        <th>
                            Card Name
                        </th>

                        <th>
                            Item Code
                        </th>

                        <th>
                            Item Name
                        </th>

                        <th>
                            Serial No
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Loan Status
                        </th>

                        <th>
                            Remark
                        </th>

                    </tr>

                </thead>



                <tbody>


                    @{
                        int rowindex = 1;


                        foreach (var x in applist)
                        {

                            <tr>


                                <td style="text-align:center;">
                                    @rowindex
                                </td>




                                <td>
                                    <a href="/sales/PreviewLoan?DocEntry=@x.DocEntry"
                                       style="color:blue;text-decoration:underline;">

                                        @x.DocEntry

                                    </a>
                                </td>




                                <td>
                                    @(x.DocDate.HasValue
                                        ? x.DocDate.Value.ToString("dd-MMM-yyyy")
                                        : "")
                                </td>




                                <td>
                                    @x.CardCode
                                </td>



                                <td>
                                    @x.CardName
                                </td>



                                <td>
                                    @x.ItemCode
                                </td>



                                <td>
                                    @x.ItemName
                                </td>



                                <td>
                                    @x.DistNumber
                                </td>




                                <td>
                                    @x.DocStatus
                                </td>




                                <td class="truncate"
                                    title="@x.LoanStatus">

                                    @(x.LoanStatus != null &&
                                      x.LoanStatus.Length > 20
                                      ? x.LoanStatus.Substring(0,20) + "..."
                                      : x.LoanStatus)

                                </td>




                                <td class="truncate"
                                    title="@x.Comment">

                                    @(x.Comment != null &&
                                      x.Comment.Length > 20
                                      ? x.Comment.Substring(0,20) + "..."
                                      : x.Comment)

                                </td>


                            </tr>


                            rowindex++;

                        }

                    }


                </tbody>


            </table>


        </div>


    </div>

</div>





<script>

    $(document).ready(function () {


        $('.datetime').datepicker({

            autoclose: true,
            format: 'dd-M-yyyy'

        });



        $('#table_pr_assignment').DataTable({

            scrollX: true,

            fixedHeader: true,

            autoWidth: false,

            pageLength: 50,


            order: [
                [1, 'desc']
            ],


            dom: 'Bfrtip',


            buttons: [

                'copy',
                'excel',
                'print'

            ],


            language: {

                search: "Search :",

                lengthMenu: "Show _MENU_ Rows",

                info: "Showing _START_ to _END_ of _TOTAL_ Rows",

                zeroRecords: "No matching records found"

            }


        });


    });

</script>