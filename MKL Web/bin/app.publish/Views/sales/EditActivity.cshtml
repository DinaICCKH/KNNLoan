                                                    <th style="width:4%; text-align:right;">AR Balance</th>
                                                    <th style="width:4%; text-align:right;">Open Bal (A/R)</th>
                                                    <th style="width:4%; text-align:right;">Int. No</th>
                                                    <th style="width:4%; text-align:right;">Int. Balance</th>
                                                    <th style="width:4%; text-align:right;">Open Bal (Int)</th>
                                                    <th style="width:4%; text-align:right;">Accrual. Penalty</th>
                                                    <th style="width:14%; text-align:left;">Remark</th>
                                                </tr>
                                            </thead>

                                            <tbody id="loan_list_body">
                                                @* Razor loop for existing rows with full IDs *@
                                                @{
                                                    int rowNumber = 1;
                                                    var loanRows = ViewBag.LoanRows as List<ActivityRow>;
                                                    if (loanRows != null && loanRows.Any())
                                                    {
                                                        foreach (var row in loanRows)
                                                        {
                                                                                                <tr id="tr_payment_detail_for_activity_@rowNumber">
                                                                                                    <td id="td_remove_@rowNumber" style="text-align:center; color:red; cursor:pointer;" class="remove-single-row">X</td>
                                                                                                    <td id="td_checkbox_@rowNumber" style="text-align:center;">
                                                                                                        <input type="checkbox" class="row_checkbox_for_activity">
                                                                                                    </td>
                                                                                                    <td id="td_rowno_@rowNumber" style="text-align:center;">@rowNumber</td>
                                                                                                    <td id="td_baseEntry_@rowNumber">@row.BaseEntry</td>
                                                                                                    <td id="td_baseID_@rowNumber">@row.BaseID</td>
                                                                                                    <td id="td_model_@rowNumber">@row.Model</td>

                                                                                                    <td id="td_itemName_@rowNumber">@row.ItemName</td>
                                                                                                    <td id="td_serial_@rowNumber">@row.Serial</td>
                                                                                                    <td id="td_saleemp1_@rowNumber">@row.Slp1</td>
                                                                                                    <td id="td_saleemp2_@rowNumber">@row.Slp2</td>
                                                                                                    <td id="td_RemaincheqQty_@rowNumber">@row.RemainChq</td>
                                                                                                    <td id="td_OverDuecheqQty_@rowNumber">@row.OverdueChqNo</td>
                                                                                                    <td id="td_sumOverDuecheq_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.SumofOverdueChq)</td>
                                                                                                    <td id="td_sumOpenAR_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.SumofARBalance)</td>

                                                                                                    <td id="td_paymentdate_@rowNumber">@(!string.IsNullOrEmpty(row.PaymentDate?.ToString()) ? ((DateTime)row.PaymentDate).ToString("dd-MMM-yyyy") : "")</td>
                                                                                                    <td id="td_duedate_@rowNumber">@(!string.IsNullOrEmpty(row.DueDate?.ToString()) ? ((DateTime)row.DueDate).ToString("dd-MMM-yyyy") : "")</td>

                                                                                                    <td id="td_overDueDay_@rowNumber">@row.OverdueDays</td>

                                                                                                    <td id="td_principle_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.Principle)</td>
                                                                                                    <td id="td_interest_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.Interest)</td>
                                                                                                    <td id="td_monthly_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.Monthly)</td>
                                                                                                    <td id="td_method_@rowNumber">@row.PaymentType</td>
                                                                                                    <td id="td_arno_@rowNumber">@row.ARNo</td>
                                                                                                    <td id="td_arbalance_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.ARBalance)</td>
                                                                                                    <td id="td_openbalar_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.OpenBalanceAR)</td>
                                                                                                    <td id="td_intno_@rowNumber" style="text-align:right;">@row.IntNo</td>
                                                                                                    <td id="td_intbalance_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.IntBalance)</td>
                                                                                                    <td id="td_openbalint_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.OpenIntBalance)</td>
                                                                                                    <td id="td_accrualpenalty_@rowNumber" style="text-align:right;">@string.Format("{0:N2}", row.AccrualPenalty)</td>
                                                                                                    <td id="td_remark_@rowNumber" contenteditable="true" style="text-align:left; color:blue;">@row.Remarks</td>
                                                                                                </tr>
                                                            rowNumber++;
                                                        }
                                                    }
                                                }
                                            </tbody>

                                            <tfoot style="background-color:#f0f0f0; font-weight:bold;">
                                                <tr>
                                                    <td colspan="15" style="text-align:right;">Total:</td>
                                                    <td></td>
                                                    <td></td>
                                                    <td style="text-align:right;"></td>
                                                    <td style="text-align:right;"></td>
                                                    <td style="text-align:right;"></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td id="total_ar_balance" style="text-align:right;">0.00</td>
                                                    <td id="total_openbalance_ar" style="text-align:right;">0.00</td>
                                                    <td id="total_int_no" style="text-align:right;">0</td>
                                                    <td id="total_int_balance" style="text-align:right;">0.00</td>
                                                    <td id="total_openint_balance" style="text-align:right;">0.00</td>
                                                    <td id="total_accrual_penalty" style="text-align:right;">0.00</td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>

                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <div class="btn-group">
                    <button type="button" class="btn btn-warning btn-flat">Copy From</button>
                    <button type="button" class="btn btn-warning dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                        <span class="caret"></span>
                        <span class="sr-only">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-btn">
                        <li><button type="button" style="width:90%;" class="btn btn-warning btn-flat" onclick="cmd_copy_from_loanActivity()">Loan Schedule</button></li>
                    </ul>
                </div>

                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_activity()">Submit</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-schedule-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Old Scheduled List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_schedule_list" class="table">
                        <thead>
                            <tr style="display:none">
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" placeholder="House Code">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:10%">RefNo</th>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:20%">Customer Name</th>
                                <th style="width:15%">Item Code</th>
                                <th style="width:25%">Item Name</th>
                                <th style="width:15%">Last Option</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="get_listloan_forActivity()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<script>
    $(document).ready(function () {
        // Initialize datepicker for any date fields dynamically
        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy',
            todayHighlight: true
        });

        // Remove single row by clicking the "X"
        $("#loan_list_body").on("click", ".remove-single-row", function () {
            $(this).closest("tr").remove();
            calculateTotals_for_activity();
        });

        // Check/Uncheck all rows
        window.checkAllRows_for_activity = function (checkbox) {
            $("#loan_list_body input.row_checkbox_for_activity").prop('checked', checkbox.checked);
        };

        // Remove selected rows
        window.removeSelectedRows_for_activity = function () {
            $("#loan_list_body input.row_checkbox_for_activity:checked").each(function () {
                $(this).closest("tr").remove();
            });
            $("#check_all_for_activity").prop('checked', false);
            calculateTotals_for_activity();
        };
    });

    // Toggle Loan/Penalty Table
    function togglePenaltyTable_for_activity() {
        var wrapper = document.getElementById("penalty_table_wrapper");
        var icon = document.getElementById("toggle_penalty_icon");
        if (wrapper.style.display === "none") {
            wrapper.style.display = "block";
            icon.classList.replace("fa-chevron-down", "fa-chevron-up");
        } else {
            wrapper.style.display = "none";
            icon.classList.replace("fa-chevron-up", "fa-chevron-down");
        }
    }

    // Fetch loan/payment schedule and populate table
    function get_listloan_forActivity() {
        var row = $("#txt_payment_schedule_selected_row").val();

        var docEntries = [];

        $("#table_pop_schedule_list tbody tr").each(function (i) {
            var checkbox = $(this).find("input[type='checkbox']");

            if (checkbox.is(":checked")) {
                var docEntry = $("#td_pop_payment_schedule_so_entry_" + i).text().trim();
                if (docEntry) {
                    docEntries.push(docEntry);
                }
            }
        });

        if (docEntries.length === 0) {
            ShowAlertCus("Please select at least one schedule!", "warning");
            return;
        }

        // Combine with ;
        var docentry = docEntries.join(";");


        $.ajax({
            url: '/sales/get_payment_schedule_by_so_forActivity',
            type: 'POST',
            data: { soEntry: docentry, rowStatus: 'All' },
            datatype: 'json',
            async: false,
            beforeSend: function () { $("#loading").show(); },
            complete: function () { $("#loading").hide(); },
            success: function (data) {
                var mydata = data.data;
                var tbody = $("#loan_list_body");
                tbody.empty();

                function formatDate(dateStr) {
                    if (!dateStr) return "";
                    var d = new Date(dateStr);
                    if (isNaN(d)) return dateStr;
                    var day = d.getDate();
                    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    var month = monthNames[d.getMonth()];
                    var year = d.getFullYear();
                    return day + "-" + month + "-" + year;
                }

                for (var i = 0; i < mydata.length; i++) {
                    var x = mydata[i];
                    var index = i + 1;
                    var trId = "tr_payment_detail_for_activity_" + index;

                    var tr = "<tr id='" + trId + "'>";

                    // Remove icon "X"
                    tr += "<td id='td_remove_" + index + "' style='text-align:center; color:red; cursor:pointer;' class='remove-single-row'>X</td>";

                    // Checkbox
                    tr += "<td id='td_checkbox_" + index + "' style='text-align:center;'><input type='checkbox' class='row_checkbox_for_activity'></td>";

                    // Row number
                    tr += "<td id='td_rowno_" + index + "' style='text-align:center;'>" + index + "</td>";


                    tr += "<td id='td_model_" + index + "' style='text-align:left;'>" + (x.Model || "") + "</td>";
                    tr += "<td id='td_itemName_" + index + "' style='text-align:left;'>" + (x.ItemName || "") + "</td>";
                    tr += "<td id='td_serial_" + index + "' style='text-align:left;'>" + (x.Serial || "") + "</td>";
                    tr += "<td id='td_saleemp1_" + index + "' style='text-align:left;'>" + (x.SaleEmp1 || "") + "</td>";
                    tr += "<td id='td_saleemp2_" + index + "' style='text-align:left;'>" + (x.SaleEmp2 || "") + "</td>";

                    tr += "<td id='td_RemaincheqQty_" + index + "' style='text-align:left;'>" + (x.RemaincheqQty || 0) + "</td>";
                    tr += "<td id='td_OverDuecheqQty_" + index + "' style='text-align:left;'>" + (x.OverDuecheqQty || 0) + "</td>";
                    tr += "<td id='td_sumOverDuecheq_" + index + "' style='text-align:right;'>" + convert2digit(x.SumOverDuecheq) + "</td>";
                    tr += "<td id='td_sumOpenAR_" + index + "' style='text-align:right;'>" + convert2digit(x.SumOpenAR) + "</td>";

                    // Payment info with formatted dates
                    tr += "<td id='td_paymentdate_" + index + "' style='text-align:left;'>" + formatDate(x.PaymentDate) + "</td>";
                    tr += "<td id='td_duedate_" + index + "' style='text-align:left;'>" + formatDate(x.DueDate) + "</td>";
                    tr += "<td id='td_overDueDay_" + index + "' style='text-align:left;'>" + (x.OverDueDay || 0) + "</td>";
                    tr += "<td id='td_principle_" + index + "' style='text-align:right;'>" + convert2digit(x.Principle) + "</td>";
                    tr += "<td id='td_interest_" + index + "' style='text-align:right;'>" + convert2digit(x.Interest) + "</td>";
                    tr += "<td id='td_monthly_" + index + "' style='text-align:right;'>" + convert2digit(x.Monthly) + "</td>";
                    tr += "<td id='td_method_" + index + "' style='text-align:left;'>" + (x.Method || "") + "</td>";
                    tr += "<td id='td_arno_" + index + "' style='text-align:left;'>" + (x.ARNo || "") + "</td>";
                    tr += "<td id='td_arbalance_" + index + "' style='text-align:right;'>" + convert2digit(x.ARBalance) + "</td>";
                    tr += "<td id='td_openbalar_" + index + "' style='text-align:right;'>" + convert2digit(x.OpenBalanceAR) + "</td>";
                    tr += "<td id='td_intno_" + index + "' style='text-align:right;'>" + (x.ARNoInterest || "") + "</td>";
                    tr += "<td id='td_intbalance_" + index + "' style='text-align:right;'>" + convert2digit(x.IntBalance) + "</td>";
                    tr += "<td id='td_openbalint_" + index + "' style='text-align:right;'>" + convert2digit(x.OpenIntBalance) + "</td>";
                    tr += "<td id='td_accrualpenalty_" + index + "' style='text-align:right;'>" + convert2digit(x.AccrualPenalty) + "</td>";

                    // Editable remark
                    tr += "<td id='td_remark_" + index + "' contenteditable='true' style='text-align:left; color:blue;'>" + (x.Remarks || "") + "</td>";

                    tr += "</tr>";

                    tbody.append(tr);
                }

                calculateTotals_for_activity();
                $("#modal-schedule-list").modal('hide');
                $("#txt_payment_schedule_selected_row").val("-1");
            },
            error: function (error) {
                alert('Error while reading data => ' + error);
            }
        });
    }

    // Remove all rows
    function cmd_remove_all_row_payment_schedule() {
        $("#loan_list_body tr").remove();
        $("#check_all_for_activity").prop('checked', false);
        calculateTotals_for_activity();
    }

    // Recalculate totals
    function calculateTotals_for_activity() {
        var totalAR = 0, totalOpenAR = 0, totalInt = 0, totalOpenInt = 0, totalPenalty = 0;

        $("#loan_list_body tr").each(function () {
            var cells = $(this).find("td");
            totalAR += parseFloat(cells.eq(20).text()) || 0;
            totalOpenAR += parseFloat(cells.eq(21).text()) || 0;
            totalInt += parseFloat(cells.eq(23).text()) || 0;
            totalOpenInt += parseFloat(cells.eq(24).text()) || 0;
            totalPenalty += parseFloat(cells.eq(25).text()) || 0;
        });

        $("#total_ar_balance").text(totalAR.toFixed(2));
        $("#total_openbalance_ar").text(totalOpenAR.toFixed(2));
        $("#total_int_balance").text(totalInt.toFixed(2));
        $("#total_openint_balance").text(totalOpenInt.toFixed(2));
        $("#total_accrual_penalty").text(totalPenalty.toFixed(2));

        // NEW: Sum Open AR + Open Interest and set to txt_ar_balance
        const totalARCombined = totalOpenAR + totalOpenInt;
        $("#txt_ar_balance").val(totalARCombined.toFixed(2));
    }

    // Utility function to format numbers
    function convert2digit(val) {
        return parseFloat(val || 0).toFixed(2);
    }
</script>
