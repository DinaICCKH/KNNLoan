@using MKL_Web.Models;
@{
    ViewBag.Title = "Edit Activity";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //List<v_CostCenter> project = ViewBag.project;
    //List<v_CostCenter> block = ViewBag.block;
    List<v_OCRD_Penalty> cust = ViewBag.cust;
    List<v_OCRD_Penalty_AllCustomer> custAll = ViewBag.custAll;
    List<v_OCRD_Penalty> custNew = ViewBag.custNew;
    //List<v_Item> houselist = ViewBag.houselist;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy"); // Capital 'MMM' for month name
    List<InstallmentList> installment = ViewBag.installment;
    MKL_Web.Models.USR usr = (MKL_Web.Models.USR)Session["USR"];
    List<ICC_GET_AssignToActivityResult> assignto = ViewBag.assignTo;
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script>
        $(document).ready(function () {
            $("#txt_pop_filter_vendor_name").keyup(function () {
                $("#table_pop_customer_list >tbody >tr").each(function () {
                    var id = $(this).attr('id').replace("tr_pop_customer_", "");

                    var text = $("#td_pop_vendor_cust_code_" + id).text().toLowerCase() + $("#td_pop_vendor_cust_name_" + id).text().toLowerCase() + $("#td_pop_vendor_phone_" + id).text().toLowerCase();
                    if (text.replace(/\s+/g, '').indexOf($("#txt_pop_filter_vendor_name").val().replace(/\s+/g, '').toLowerCase()) == -1)
                        $(this).hide();
                    else
                        $(this).show();
                });
            });
        });


    </script>

    <style>
        #table_penalty_list td,
        #table_penalty_list th {
            padding: 2px 5px; /* smaller padding: top/bottom 2px, left/right 5px */
            vertical-align: middle; /* keep text vertically centered */
        }

        #table_penalty_list tbody tr {
            height: auto; /* let height shrink based on padding */
        }

        #table_penalty_list thead th {
            padding: 4px 5px; /* slightly larger for header */
        }
    </style>
</head>
<div class="modal fade" id="modal-cust_list">
    <input type="hidden" id="txt_module_id" value="ChangeSchedule" />
    <div class="modal-dialog modal-xl modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_customer_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td style="width:50%;">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                                <td colspan="4" style="vertical-align: middle;">
                                    <div class="form-check" style="margin-bottom: 15px;">
                                        <label class="form-check-label">
                                            <input type="checkbox" id="chk_display_all_customers" class="form-check-input" onchange="toggleCustomerListView()"> Display all customers
                                        </label>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:30%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>
                                <th style="width:5%"></th>
                            </tr>
                        </thead>

                        <tbody id="tbody_penalty_customers">
                            @{
                                int rowindex = 1;
                                if (cust != null)
                                {
                                    foreach (var x in cust)
                                    {
                                        <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                            <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                            <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                            <td id="td_pop_vendor_cust_fname_@rowindex">@x.CardFName</td>
                                            <td id="td_pop_vendor_cust_gender_@rowindex">@x.U_Gender</td>
                                            <td id="td_pop_vendor_phone_@rowindex">@x.Phone1</td>
                                            <td></td>
                                        </tr>
                                        rowindex++;
                                    }
                                }
                            }
                        </tbody>

                        <tbody id="tbody_all_customers" style="display: none;">
                            @{
                                int allRowIndex = 1;
                                if (custAll != null)
                                {
                                    foreach (var x in custAll)
                                    {
                                        <tr id="tr_pop_customer_all_@allRowIndex" onclick="tr_pop_customer_all_selected(@allRowIndex)">
                                            <td id="td_pop_vendor_cust_code_all_@allRowIndex">@x.CardCode</td>
                                            <td id="td_pop_vendor_cust_name_all_@allRowIndex">@x.CardName</td>
                                            <td id="td_pop_vendor_cust_fname_all_@allRowIndex">@x.CardFName</td>
                                            <td id="td_pop_vendor_cust_gender_all_@allRowIndex">@x.U_Gender</td>
                                            <td id="td_pop_vendor_phone_all_@allRowIndex">@x.Phone1</td>
                                            <td></td>
                                        </tr>
                                        allRowIndex++;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_customer_activity()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>

    
    <!-- /.modal-dialog -->
</div>


<script>
    function toggleCustomerListView() {
        var isChecked = document.getElementById("chk_display_all_customers").checked;
        var penaltyBody = document.getElementById("tbody_penalty_customers");
        var allBody = document.getElementById("tbody_all_customers");

        if (isChecked) {
            penaltyBody.style.display = "none";
            allBody.style.display = "table-row-group";
        } else {
            penaltyBody.style.display = "table-row-group";
            allBody.style.display = "none";
        }
    }

    function tr_pop_customer_all_selected(index) {
        console.log("All Customer list row selected index: " + index);
        // You can call your regular selection method here or build a custom callback if needed.
    }
</script>


