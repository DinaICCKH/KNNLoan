@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Booking Listing";
    List<SO> po = ViewBag.saleList;
    //List<USR> user = ViewBag.user;
}
<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h5>@ViewBag.Title</h5>
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_pr_assignment" class="table table-bordered table-hover dataTable no-footer">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" style="width: 10%">Sales No</th>
                            <th class="sorting_disabled" style="width: 10%">Posting Date</th>
                            <th class="sorting_disabled" style="width: 10%">Due Date</th>
                            <th class="sorting_disabled" style="width: 10%">Customer Code</th>
                            <th class="sorting_disabled">Costomer Name</th>
                            <th class="sorting_disabled" style="width: 10%;text-align:right">Total</th>
                            <th class="sorting_disabled" style="width: 10%">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            string boqtype = "";
                            foreach (var x in po)
                            {
                                <tr id="tr_@rowindex">
                                    <td style="display:none">@x.DocEntry</td>
                                    <td style="cursor:pointer;color:blue;text-decoration:underline;text-align:left;">
                                        @*@if (x.DocNum == null)
                                        {
                                            <a href="/sales/BookingEdit?key=@x.DocEntry">@x.DocEntry</a>
                                        }
                                        else
                                        {
                                            <a href="/sales/BookingEdit?key=@x.DocEntry">@x.DocNum</a>
                                        }*@

                                        @x.DocEntry

                                    </td>
                                    <td style="text-align:center;">@x.DocDate.Value.ToString("dd-MMM-yyyy")</td>
                                    <td style="text-align:center;">@x.DueDate.Value.ToString("dd-MMM-yyyy")</td>
                                    <td style="text-align:center;">@x.CardCode</td>
                                    <td style="text-align:left;">@x.CardName</td>
                                    <td style="text-align:right;">@x.SubTotal.Value.ToString("N2")</td>
                                    <td style="text-align:center;">@x.DocStatus</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
