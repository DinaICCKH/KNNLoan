@using MKL_Web.Models;
@{
    ViewBag.Title = "Edit Payment Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> block = ViewBag.block;
    List<OCRD> cust = ViewBag.cust;
    List<v_Item_House> houselist = ViewBag.houselist;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy");
    List<InstallmentList> installment = ViewBag.installment;
    SO s = ViewBag.so;
    SO1 s1 = ViewBag.so1;
    List<v_Contact> contact = ViewBag.contact;
    InstallmentRow inst = ViewBag.inst;
}
<head>
    <script src="../../Scripts/js/sales.js"></script>
    <script>
        $(document).ready(function () {
            get_payment_schedule_by_DocEntry(@s.DocEntry);
        });
        
    </script>
</head>
<div class="modal fade" id="modal-cust_list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Customer Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_customer_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="Customer Code or Customer Name">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Customer Code</th>
                                <th style="width:25%">Customer Name</th>
                                <th style="width:25%">Customer KH</th>
                                <th style="width:10%">Gender</th>
                                <th style="width:15%">Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowindex = 1;
                                foreach (var x in cust)
                                {
                                    <tr id="tr_pop_customer_@rowindex" onclick="tr_pop_customer_selected(@rowindex)">
                                        <td id="td_pop_vendor_cust_code_@rowindex">@x.CardCode</td>
                                        <td id="td_pop_vendor_cust_name_@rowindex">@x.CardName</td>
                                        <td id="td_pop_vendor_cust_fname_@rowindex">@x.FrgnName</td>
                                        <td id="td_pop_vendor_cust_gender_@rowindex">@x.Gender</td>
                                        <td id="td_pop_vendor_phone_@rowindex">@x.Tel1</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_customer()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="modal fade" id="modal-item-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">House Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_vendor_list" class="table">
                        <thead>
                            <tr>
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="House Code">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:15%">Description</th>
                                <th style="width:23%">Description KH</th>
                                <th style="width:10%">Amount</th>
                                <th style="width:15%">Project</th>
                                <th style="width:8%">Block</th>
                                <th style="width:10%">House Code</th>
                                <th style="width:10%">Streett</th>
                                <th style="width:12%">House No</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in houselist)

                                {
                                    <tr id="tr_pop_item_@rowindex" onclick="tr_pop_item_selected(@rowindex)">
                                        <td id="td_pop_item_code_@rowindex" style="display:none">@x.ItemCode</td>
                                        <td id="td_pop_item_name_@rowindex">@x.ItemName</td>
                                        <td id="td_pop_item_fname_@rowindex">@x.FrgnName</td>
                                        <td id="td_pop_item_amount_@rowindex" style="text-align:right">@x.HouseAmount.ToString("N2")</td>
                                        <td id="td_pop_item_project_name_@rowindex">@x.ProjectName</td>
                                        <td id="td_pop_item_zone_name_@rowindex">@x.ZoneName</td>
                                        <td id="td_pop_item_house_code_@rowindex">@x.HouseCode</td>
                                        <td id="td_pop_item_street_@rowindex">@x.U_Street</td>
                                        <td id="td_pop_item_house_no_@rowindex">@x.HouseNo</td>
                                        <td id="td_pop_item_ocrcode_@rowindex" style="display:none">@x.Project</td>
                                        <td id="td_pop_item_ocrcode2_@rowindex" style="display:none">@x.Zone</td>
                                        <td id="td_pop_item_ocrcode3_@rowindex" style="display:none">@x.HouseCode</td>
                                        <td></td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_item()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="modal fade" id="modal-schedule-list">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="pop_h5">Payment Schedule Filter</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_schedule_list" class="table">
                        <thead>
                            <tr style="display:none">
                                <td style="width:10%;">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_filter_vendor_name" placeholder="House Code">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:10%">Customer Code</th>
                                <th style="width:20%">Customer Name</th>
                                <th style="width:10%">House Code</th>
                                <th style="width:15%">Project</th>
                                <th style="width:15%">Block</th>
                                <th style="width:10%">Last Option</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_pop_choose_payment_schedule()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="modal fade" id="modal_special_payment">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Speical Payment</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_pop_special_payment" class="table">
                        <thead>
                            <tr>
                                <td colspan="7">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel" style="text-align:right" >Installment Amount</label>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" style="text-align:right" class="form-control form-control-insde" id="txt_pop_special_installment_amount" readonly="readonly" placeholder="Installment Amount" value="0.00">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="7">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel" style="text-align:right" >Remaining Amount</label>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" style="text-align:right" class="form-control form-control-insde" id="txt_pop_remaining_amount" readonly="readonly" placeholder="Remaining Amt" value="0.00">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:3%">#</th>
                                <th style="width:15%">Method</th>
                                <th style="width:15%">Payment Date</th>
                                <th style="width:15%">Amount</th>
                                <th style="width:10%">Percentage</th>
                                <th style="width:10%">AnnualRate</th>
                                <th style="width:10%">Period</th>
                                <th style="width:25%">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="tr_pop_speical_payment_1">
                                <td><span class='input-group-addon input-group-addon-remove' onclick='remove_pop_special_by_line(1)'  id="remove_pop_special_by_line_1"><i class='fa fa-fw fa-remove' style="cursor:pointer;"></i></span></td>
                                <td>
                                    <div class="form-group">
                                        <select class="form-control" id="cbo_pop_special_payment_payment_option_1" onchange="cbo_pop_special_payment_payment_option_change(1)">
                                            <option value="DPS">Deposit</option>
                                            <option value="PNI">Payment without interest</option>
                                            <option value="PIA">Payment with interest(Amount)</option>
                                            <option value="PIP">Payment with interest(Period)</option>
                                            <option value="FPM">Final Payment</option>
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <div class="input-group date">
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                            <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_pop_special_payment_date_1" placeholder="Posting Date" value="@docdate">
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_special_payment_amount_1" value="0.00" onchange="txt_special_line_payment_amount_change(1)">
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_special_payment_per_1" value="0.00" onchange="txt_special_line_payment_per_change(1)">
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_special_payment_rate_1" value="0.00" onchange='txt_pop_special_line_payment_rate_change(1)' readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_special_payment_period_1" value="1" onchange="txt_special_line_payment_period_change(1)">
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_special_payment_remark_1" placeholder="Remark">
                                    </div>
                                </td>
                                <td style='display:none;'>
                                    <div class='form-group'><input type='text' class='form-control form-control-insde' id='txt_pop_special_payment_current_select_1'>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-info pull-left btn-flat" onclick="cmd_pop_special_payment_add_row()">Add Row</button>
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_payment_generate()">Generate</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <input type="hidden" id="txt_module_id" value="PaymentSchedule" />
    <input type="hidden" id="txt_bp_selected_row" />
    <input type="hidden" id="txt_item_selected_row" />
    <input type="hidden" id="txt_payment_schedule_selected_row" value="-1" />
    <input type="hidden" id="txt_so_entry" value="-1" />
    <input type="hidden" id="txt_so_line" value="-1" />
    <input type="hidden" id="txt_ocrcode" value="-1" />
    <input type="hidden" id="txt_ocrcode2" value="-1" />
    <input type="hidden" id="txt_ocrcode3" value="-1" />
    <table id="tbl_Remove_List" style="display:none;">
        <thead>
            <tr>
                <td>HeaderLine</td>
                <td>DetailLine</td>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Code</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_code" readonly="readonly" placeholder="Customer Code" value="@s.CardCode">
                                    <div class="input-group-addon">
                                        <i class="fa fa-user text-info" onclick="cmd_show_customer()" style="cursor:pointer"></i>
                                    </div>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">SO No</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_doc_num" readonly="readonly" placeholder="SO No" value="@s.DocNum">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Customer Name</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_card_name" placeholder="Customer Name" value="@s.CardName" readonly>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Posting Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_doc_date" placeholder="Posting Date" value="@s.DocDate.Value.ToString("dd-MMM-yyyy")">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Contact</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <select class="form-control form-control-insde" id="cbo_contact_person" disabled>
                                        <option value=""></option>
                                        @foreach (var a in contact.Where(a => a.CardCode == s.CardCode).ToList())
                                        {
                                            if (a.CntctCode == s.ContactPerson)
                                            {
                                                <option selected value="@a.CntctCode">@a.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@a.CntctCode">@a.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </td>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Delivery Date</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control pull-right datetime form-control-insde" readonly="readonly" id="txt_due_date" placeholder="Delivery Date" value="@s.DueDate.Value.ToString("dd-MMM-yyyy")">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:10%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Referral</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_referral" placeholder="Referral" value="@s.Referral" readonly>
                                </div>
                            </td>
                            <td style="width:12%;">
                                <div class="form-group">
                                    <label for="inputEmail3" class="form-control controlLabel">Construction Period</label>
                                </div>
                            </td>
                            <td style="width:40%;">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-insde" id="txt_con_period" placeholder="Construction Period" value="@s.ConPeriod" readonly>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">House Information</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">House Code</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="input-group">
                                                            <input type='text' style="display:none" class='form-control noborder' id="txt_item_code" readonly="readonly" placeholder='House Code' value="@s1.ItemCode">
                                                            <input type='text' class='form-control noborder' id="txt_house_code" readonly="readonly" placeholder='House Code' value="@s1.OcrCode3">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-industry text-info" style="cursor:not-allowed"></i>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Description</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_item_name" placeholder="House Description" value="@s1.ItemName">
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Before Disc. Amt</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_before_discount_amount" placeholder="Before Disc. Amt" value="@s.DocTotalBef.Value.ToString("N2")">
                                                        </div>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Project</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_project" placeholder="Project" value="@s.OcrCode">
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Discount</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <table style="width:100%">
                                                            <tr>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_amount" placeholder="Discount Amt" value="@inst.DiscountAmount.Value.ToString("N2")" onchange="txt_discount_amount_change()" readonly>
                                                                    </div>
                                                                </td>
                                                                <td style="width:5%">(%)</td>
                                                                <td style="width:45%">
                                                                    <div class="form-group">
                                                                        <input type="text" class="form-control form-control-insde" id="txt_discount_per" placeholder="Discount Amt" value="@inst.DiscountPer.Value.ToString("N2")" onchange="txt_discount_amount_change()" readonly>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Payment Option</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <div class="form-group">
                                                            <select class="form-control" id="cbo_payment_option" onchange="cbo_payment_option_change()">
                                                                @{
                                                                    <option value=""></option>
                                                                    foreach (var x in installment)
                                                                    {
                                                                        <option value="@x.InsCode">@x.InsName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:10%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Special Discount</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:40%;">
                                                        <table style="width:100%">
                                                            <tr>
