@using MKL_Web.Models;
@{
    ViewBag.Title = "Hold Unit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<v_CostCenter> project = ViewBag.project;
    List<v_CostCenter> block = ViewBag.block;
    List<v_OSLP> oslp = ViewBag.oslp;

}
<head>
    <script src="../../Scripts/js/sales.js"></script>
</head>
<div class="row">
    <select id="cbo_oslp" style="display:none">
        @{ 
            foreach(var x in oslp)
            {
                <option value="@x.SlpCode">@x.SlpName</option>
            }
        }
    </select>
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h5 class="box-title">@ViewBag.Title</h5>
            </div>
            <div class="box-header with-border">
                <table class="table" role="none">
                    <thead>
                        <tr>
                            <td>
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Search House Info</legend>
                                    <div class="row" style="margin:0px;margin-top:10px;margin-left:-10px;">
                                        <table class="table" style="margin-bottom:0px;">
                                            <thead>
                                                <tr>
                                                    <td style="width:7%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" style="padding-left:2px;" class="form-control controlLabel">Project</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_project">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in project)
                                                                    {
                                                                        <option value="@x.PrcName">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:8%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">Block</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <select class="form-control form-control-insde" id="cbo_sales_holdunit_block">
                                                                <option value=""></option>
                                                                @{
                                                                    foreach (var x in block)
                                                                    {
                                                                        <option value="@x.PrcCode">@x.PrcName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="width:9%;">
                                                        <div class="form-group">
                                                            <label for="inputEmail3" class="form-control controlLabel">House​ No</label>
                                                        </div>
                                                    </td>
                                                    <td style="width:15%;">
                                                        <div class="form-group">
                                                            <input type="text" class="form-control form-control-insde" id="txt_sales_holdunit_house_no" placeholder="House No">                                                            
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-group">
                                                            <button type="button" class="btn btn-info btn-flat" onclick="get_sales_holdunit('A')">Search</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </thead>
                                        </table>
                                        <table class="table" style="margin-bottom:0px;" id="table_sales_hold_unit">
                                            <thead>
                                                <tr class="bg-gray" role="row">
                                                    <td style="width:1%;">#</td>
                                                    <td style="width:8%">House No</td>
                                                    <td style="width:15%">Description</td>
                                                    <td style="width:10%">Price</td>
                                                    <td style="width:10%">Valid From</td>
                                                    <td style="width:10%">Valid To</td>
                                                    <td style="width:12%">Sales</td>
                                                    <td style="width:8%">Project</td>
                                                    <td style="width:8%">Block</td>
                                                    <td style="width:10%">Street</td>
                                                    <td style="width:10%">House No</td>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="box-footer">
                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_hold_unit('Hold')">Submit</button>
                <button type="button" class="btn btn-warning btn-flat">Cancel</button>
            </div>
        </div>
    </div>
</div>

