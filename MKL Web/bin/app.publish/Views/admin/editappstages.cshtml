
@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string pagename = ViewBag.Title;
    AppStage stage = ViewBag.stage;
    List<AppStage1> state1 = ViewBag.state1;
    List<USR> user = ViewBag.user;
    USR u = null;
}
<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h1>@pagename</h1>
        @Html.ActionLink("Back to Admin", "admin", "admin")|@Html.ActionLink("Approval Stages", "appstages", "admin")
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <div class="col-md-9" style="padding-left:0px">
                    <table class="table" role="none" style="border:none;padding:0px">
                        <tr>
                            <td style="padding-top:10px;width:20%;" class="no-border">Stage Description</td>
                            <td>
                                <input type="text" class="form-control" id="txt_admin_usercode" placeholder="Stage Description" value="@stage.AppDes">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-top:10px;">No. of Approvals Required</td>
                            <td><input type="number" class="form-control" id="txt_admin_usercode" placeholder="No. of Approvals Required" value="@stage.NoApp"></td>
                        </tr>
                        <tr>
                            <td style="padding-top:10px;">No. of Rejections Required</td>
                            <td><input type="number" class="form-control" id="txt_admin_usercode" placeholder="No. of Rejections Required" value="@stage.NoRej"></td>
                        </tr>
                    </table>
                    <table class="table mkl_table_border" role="none" style="padding:0px">
                        <thead>
                            <tr class="bg-gray" role="row">
                                <td style="padding-top:10px;width:5%;">#</td>
                                <td style="padding-top:10px;width:20%;">Authorizer Code</td>
                                <td style="padding-top:10px;width:75%;">Authorizer Name</td>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                                foreach (var x in state1)
                                {
                                    u = user.Where(a => a.UserCode == x.UserCode).FirstOrDefault();
                                    <tr>
                                        <td style="padding-top:10px;">@index</td>
                                        <td>
                                            <input type="text" class="form-control" id="txt_admin_usercode" readonly="readonly" placeholder="Authorizer Code" value="@x.UserCode">
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" id="txt_admin_usercode" placeholder="Authorizer Name" value="@u.UserName">
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                        
                    </table>
                </div>
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_admin('user',0)">Submit</button>
            </div>
        </div>
    </div>
</div>

