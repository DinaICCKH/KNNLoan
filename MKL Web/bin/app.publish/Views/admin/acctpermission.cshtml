
@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<PermissionRole> permission = ViewBag.permission;
    string pagename = ViewBag.Title;
}
<head>
    <title>@ViewBag.Title</title>
</head>
<div class="row">
    <section class="content-header content-header-title">
        <h1>@pagename</h1>
        @Html.ActionLink("Back to Admin", "admin", "admin")
    </section>
    <!-- left column -->
    <div class="col-md-12">
        <!-- general form elements -->
        <div class="box box-primary">
            <div class="table-responsive">
                <table id="table_admin_main_menu" class="table table-bordered table-hover dataTable no-footer" role="grid">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 60%">Role Name</th>
                            <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 12%">Permission</th>
                            <th class="sorting_disabled" rowspan="1" style="width: 15%">Status</th>
                            <th class="sorting_disabled" rowspan="1" colspan="1">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var x in permission)
                            {
                                <tr role="row" class="odd">
                                    <td style="display:none">@x.PerRoleCode</td>
                                    <td>@x.PerRoleDes</td>
                                    <td>
                                        <div class="btn-group-horizontal">
                                            @Html.ActionLink("Set Permissions", "permissionid", "admin",new { id=x.PerRoleCode },new {@class= "btn bg-blue" })
                                        </div>
                                    </td>
                                    <td>@x.DocStatus</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


