@using MKL_Web.Models;
@{
    ViewBag.Title = "Approval Template";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<AppTemplate> apptempalte = ViewBag.apptempalte;
    List<v_CostCenter> ocrcode = ViewBag.ocrcode;
    List<USR> user = ViewBag.user;
    int rowindex = 1;
    List<AppStage> applist = ViewBag.appstage;
}
<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/ApprovalTemplate.js"></script>
</head>
@*<input type="hidden" id="txt_stage_code" value="-1" />*@
<input type="hidden" id="txt_selected_approver_stage_index" value="1" />
<input type="hidden" id="txt_selected_approver_index" value="1" />
<input type="hidden" id="txt_selected_approver_stage_index" value="1" />

<input type="hidden" id="txt_selected_template_index" value="1" />
<input type="hidden" id="txt_template_code" value="-1" />

<div class="modal fade" id="modal_stage_ist" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Approval Stage List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_popup_approval_stage_list" class="table">
                        <thead>
                            <tr>
                                <td colspan="2">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_up_search_approval_stage" onkeyup="Find_Stage()" autofocus placeholder="Find Approval Stage">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:15%">Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in applist)
                                {
                                    <tr onclick="tr_approval_stage_click(@rowindex)" id="tr_approval_stage_@rowindex">
                                        <td>@rowindex</td>
                                        <td id="td_stage_code_@rowindex">@x.AppStageCode</td>
                                        <td id="td_stage_name_@rowindex">@x.AppName</td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_choose_template_stage(1)">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_tempalte_list" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-popup-filter">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Approval Template List</h5>
            </div>
            <div class="modal-body no-padding">
                <div class="table-responsive" style="height:500px;overflow:auto">
                    <table id="table_popup_template_list" class="table">
                        <thead>
                            <tr>
                                <td colspan="2">
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Find:</label>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="form-group">
                                        <input type="text" id="txt_po_pop_filter_item_code" style="display:none" />
                                        <input type="text" class="form-control form-control-insde" id="txt_pop_up_search_approval_template" onkeyup="Find_Template()" autofocus placeholder="Find Approval Template">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:15%">Code</th>
                                <th>Description</th>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowindex = 1;
                                foreach (var x in apptempalte)
                                {
                                    <tr onclick="tr_template_click(@rowindex)" id="tr_template_@rowindex">
                                        <td>@rowindex</td>
                                        <td id="td_template_code_@rowindex">@x.AppTemplateID</td>
                                        <td id="td_template_name_@rowindex">@x.TemplateDesc</td>
                                        <td id="td_template_doc_id_@rowindex">@x.DocID</td>
                                        <td id="td_template_stage_code_@rowindex" style="display:none">@x.AppStageCode</td>
                                        <td id="td_template_type_@rowindex">@x.Type</td>
                                        <td id="td_template_from_amt_@rowindex" style="display:none">@x.FromAmt</td>
                                        <td id="td_template_to_amt_@rowindex" style="display:none">@x.ToAmt</td>
                                        <td id="td_template_status_@rowindex">@x.DocStatus</td>
                                    </tr>
                                    rowindex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="padding:5px;">
                <button type="button" class="btn btn-success pull-left btn-flat" onclick="cmd_choose_template()">Choose</button>
                <button type="button" class="btn btn-danger pull-left btn-flat" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-1">

        </div>
        <div class="col-md-10">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h5 class="box-title">@ViewBag.Title</h5>
                </div>
                <div class="box-header with-border">
                    <table class="table" role="none">
                        <thead>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Description</label>
                                    </div>
                                </td>
                                <td colspan="4">
                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-insde" id="txt_template_name" placeholder="Description">
                                    </div>
                                </td>
                                <td><button type="button" class="btn btn-primary btn-flat" onclick="show_template()">Find</button></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Document</label>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-control form-control-insde form-group" id="cbo_doc_id" onchange="cbo_doc_id_change()">
                                        <option value=""></option>
                                        <option value="CP">Change Product</option>
                                        <option value="RP">Reprocessing</option>
                                        <option value="CO">Change Owner</option>
                                        <option value="PE">Penalty</option>
                                        <option value="RE">Reschedule</option>
                                        <option value="RS">Restructure</option>
                                        <option value="LN">Loan</option>
                                    </select>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Type</label>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-control form-control-insde form-group" id="cbo_type">
                                        <option value="A">Amount</option>
                                        <option value="P">Percent</option>
                                    </select>
                                </td>

                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel" id="lbl_from_amount">From Balance</label>
                                    </div>
                                </td>
                                <td><input type="text" class="form-control form-control-insde" id="txt_from_amount" placeholder="From Balance" value="0.00" onchange="change_amount()"></td>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel" id="lbl_to_amount">To Balance</label>
                                    </div>
                                </td>
                                <td><input type="text" class="form-control form-control-insde" id="txt_to_amount" placeholder="To Balance" value="0.00" onchange="change_amount()"></td>
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Status</label>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-control form-control-insde form-group" id="cbo_status">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </td>
                            </tr>
                            <tr style="display:none">
                                <td>
                                    <div class="form-group">
                                        <label for="inputEmail3" class="form-control controlLabel">Store Procedure</label>
                                    </div>
                                </td>
                                <td colspan="5"><input type="text" class="form-control form-control-insde" id="txt_store" placeholder="Approval Based on Store Procedure"></td>
                            </tr>
                        </thead>
                    </table>
                    <div class="nav-tabs-custom">
                        <ul class="nav nav-tabs">
                            @*<li class="active"><a href="#tab_1" data-toggle="tab" aria-expanded="true">Project</a></li>*@
                            <li class=""><a href="#tab_2" data-toggle="tab" aria-expanded="false">Initiator</a></li>
                            @*<li class=""><a href="#tab_3" data-toggle="tab" aria-expanded="false">Main Work</a></li>*@
                            <li class=""><a href="#tab_4" data-toggle="tab" aria-expanded="false">Approver</a></li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane" id="tab_2">
                                <table class="table" role="none" id="table_template_user">
                                    <thead>
                                        <tr>
                                            <td>
                                                <div class="form-group">
                                                    <input type="text" class="form-control form-control-insde" id="txt_find_user" placeholder="Find User" onkeyup="Find_User()">
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:20%">
                                                <div class="form-group">
                                                    <label for="inputEmail3" class="form-control controlLabel">User</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="inputEmail3" class="form-control controlLabel">Apply</label>
                                                </div>
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int index = 0;
                                            foreach (var x in user.OrderBy(a => a.DepCode).ToList())
                                            {
                                                <tr id="tr_user_@x.UserCode">
                                                    <td style="display:none">@x.UserCode</td>
                                                    <td id="td_user_@x.UserName">@x.UserName</td>
                                                    <td><input type="checkbox" id="chk_@x.UserCode" /></td>
                                                    <td id="td_user_@index" style="display:none">@x.UserName</td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                
                            <div class="tab-pane" id="tab_4">
                                <table class="table" role="none">
                                    <thead>
                                        <tr>
                                            <td style="width:10%;">
                                                <div class="form-group">
                                                    <label for="inputEmail3" class="form-control controlLabel">Stage Code</label>
                                                </div>
                                            </td>
                                            <td style="width:30%;"><input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_stage_code" placeholder="Stage Code"></td>
                                            <td style="width:15%;">
                                                <div class="form-group">
                                                    <label for="inputEmail3" class="form-control controlLabel">Stage Description</label>
                                                </div>
                                            </td>
                                            <td style="width:40%;"><input type="text" class="form-control form-control-insde" readonly="readonly" id="txt_stage_name" placeholder="Stage Description"></td>
                                            <td>
                                                <button type="button" class="btn btn-primary btn-flat" onclick="show_stage()">Find</button>
                                            </td>
                                        </tr>
                                    </thead>
                                </table>
                                <table class="table" id="table_template_stage1">
                                    <thead>
                                        <tr class="bg-gray" role="row">
                                            <td style="width:70%;">Approver</td>
                                            <td>Approver Order</td>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="box-footer btnaction">
                        <button type="button" class="btn btn-primary btn-flat" onclick="cmd_save_tempate()">Submit</button>
                        <button type="button" class="btn btn-info btn-flat" onclick="cmd_new_template()">New</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-1">

        </div>
    </div>
</div>

