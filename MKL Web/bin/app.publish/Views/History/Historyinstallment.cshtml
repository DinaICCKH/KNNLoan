@using MKL_Web.Models;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Installment History Report";
    List<V_ARMemo> po = ViewBag.armemoList;
    List<ICC_RPT_InstallmentHistoryResult> applist = ViewBag.Listing;
    string docdate = DateTime.Now.ToString("dd-MMM-yyyy"); // Capital 'MMM' for month name
}
<head>
    <title>@ViewBag.Title</title>
    <script src="../../Scripts/js/sales.js"></script>
</head>


@using (Html.BeginForm("Historyinstallment", "History", FormMethod.Get))
{
    <section class="content-header content-header-title">
        <h5 style="padding-top:10px !important; padding-left:0px !important;">@ViewBag.Title</h5>
    </section>

    <div class="form-inline d-flex align-items-center flex-wrap" style="gap: 10px; padding-bottom:10px !important">

        <div class="form-group mb-2">
            <label class="mr-2">From Date</label>
            <div class="input-group date">
                <div class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </div>
                <input type="text"
                       name="fdate"
                       id="fdate"
                       class="form-control datetime form-control-insde"
                       readonly="readonly"
                       placeholder="yyyy-mm-dd"
                       value="@docdate" />
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="mr-2">To Date</label>
            <div class="input-group date">
                <div class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </div>
                <input type="text"
                       name="tdate"
                       id="tdate"
                       class="form-control datetime form-control-insde"
                       readonly="readonly"
                       placeholder="yyyy-mm-dd"
                       value="@docdate" />
            </div>
        </div>


        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">Item</label>
            @Html.TextBox("Item", Request["Item"], new { @class = "form-control form-control-sm", style = "width: 100px;" })
        </div>

        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">Serial</label>
            @Html.TextBox("Serial", Request["Serial"], new { @class = "form-control form-control-sm", style = "width: 100px;" })
        </div>

        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">Customer</label>
            @Html.TextBox("Customer", Request["Customer"], new { @class = "form-control form-control-sm", style = "width: 100px;" })
        </div>

        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">CreateBy</label>
            @Html.TextBox("CreateBy", Request["CreateBy"], new { @class = "form-control form-control-sm", style = "width: 100px;" })
        </div>

        <div class="form-group mb-2">
            <label for="Customer" class="mr-2">UpdateBy</label>
            @Html.TextBox("UpdateBy", Request["UpdateBy"], new { @class = "form-control form-control-sm", style = "width: 140px;" })
        </div>

        <div class="form-group mb-2 ml-2">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
}


<div class="row">



    <div class="col-md-12">
        <div class="box box-primary">
            <div class="table-responsive" style="overflow-x: auto;">
                <table id="table_pr_assignment" class="table table-bordered table-hover display nowrap" style="width:100%">
                    <thead>
                        <tr class="bg-gray" role="row">
                            <th>No.</th>
                            <th>logInstanc</th>
                            <th>HistoryDate</th>
                            <th>ID</th>
                            <th>BaseEntry</th>
                            <th>CardCode</th>
                            <th>CardName</th>
                            <th>RowNo</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Serial</th>
                            <th>Payment Date</th>
                            <th>DueDate</th>
                            <th>Installment Amt</th>
                            <th>Principle</th>
                            <th>Interest</th>
                            <th>Monthly</th>
                            <th>Remaining</th>
                            <th>ReIncloudInter</th>
                            <th>Cu.Interest</th>
                            <th>Cu.Payment</th>
                            <th>Fixed Payment</th>
                            <th>Row Status</th>
                            <th>Method</th>
                            <th>Remarks</th>
                            <th>ARNo</th>
                            <th>Payment No</th>
                            <th>Annual Rate</th>
                            <th>Period Months</th>
                            <th>Syn</th>
                            <th>ErrorLog</th>
                            <th>Type</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Updated By</th>
                            <th>Updated Date</th>
                            <th>Change Item RefNo</th>
                            <th>Old CardCode</th>
                            <th>Old CardName</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowindex = 1;
                            foreach (var x in applist)
                            {
                                <tr id="tr_@rowindex">
                                    <td style="text-align:center;">@rowindex</td>
                                    <td>@x.logInstanc</td>
                                    <td>@(x.HistoryDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.ID</td>
                                    <td>@x.BaseEntry</td>
                                    <td>@x.CardCode</td>
                                    <td>@x.CardName</td>
                                    <td>@x.VisOrder</td>
                                    <td>@x.ItemCode</td>
                                    <td>@x.ItemName</td>
                                    <td>@x.Serial</td>
                                    <td>@(x.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@(x.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@String.Format("{0:N2}", x.InstallmentAmt)</td>
                                    <td>@String.Format("{0:N2}", x.Principle)</td>
                                    <td>@String.Format("{0:N2}", x.Interest)</td>
                                    <td>@String.Format("{0:N2}", x.Monthly)</td>
                                    <td>@String.Format("{0:N2}", x.Remaining)</td>
                                    <td>@String.Format("{0:N2}", x.ReIncloudInter)</td>
                                    <td>@String.Format("{0:N2}", x.CuInterest)</td>
                                    <td>@String.Format("{0:N2}", x.CuPayment)</td>
                                    <td>@String.Format("{0:N2}", x.FixedPayment)</td>
                                    <td>@x.RowStatus</td>
                                    <td>@x.Method</td>
                                    <td>@x.Remarks</td>
                                    <td>@x.ARNo</td>
                                    <td>@x.PaymentNo</td>
                                    <td>@String.Format("{0:N2}", x.AnnualRate)</td>
                                    <td>@x.PeriodMonths</td>
                                    <td>@x.Syn</td>
                                    <td>@x.ErrorLog</td>
                                    <td>@x.Type</td>
                                    <td>@x.CreatedBy</td>
                                    <td>@(x.CreatedDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.UpdatedBy</td>
                                    <td>@(x.UpdatedDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@x.ChangeItemRefNo</td>
                                    <td>@x.OldCardCode</td>
                                    <td>@x.OldCardName</td>
                                </tr>
                                rowindex++;
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('.datetime').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });

        $('#table_pr_assignment').DataTable({
            scrollX: true,
            fixedHeader: true,
            paging: true,
            searching: true,
            autoWidth: false,
            pageLength: 50,
            dom: 'Brtip',
            buttons: ['copy', 'excel', 'print'],
            columnDefs: [
                { targets: '_all', className: 'dt-head-center' }
            ],
            language: {
                search: "Search records:",
                lengthMenu: "Display _MENU_ records per page",
                zeroRecords: "No matching records found",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                infoEmpty: "No records available",
                infoFiltered: "(filtered from _MAX_ total records)"
            }
        });
    });

</script>
